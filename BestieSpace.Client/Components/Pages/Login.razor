@page "/login"
@layout Layout.AuthLayout
@using BestieSpace.Client.Services
@using BestieSpace.Shared.DTOs
@inject NavigationManager Navigation
@inject BestieAuthenticationStateProvider AuthProvider
@inject IBestieApiClient ApiClient
@inject IJSRuntime JSRuntime

<PageTitle>Login 🌸 | BestieSpace</PageTitle>

<div class="bestie-login-page">
    <div class="login-split-card @(isWiggling ? "kawaii-wiggle" : "")">
        <!-- ================= LEFT BANNER PANEL ================= -->
        <div class="login-left-panel">
            <div class="left-panel-content">
                <!-- Crown & Emblem Header -->
                <div class="panel-brand-header">
                    <span class="crown-sticker">👑</span>
                    <div class="brand-heart-emblem">
                        <svg width="56" height="56" viewBox="0 0 100 100" fill="none">
                            <rect width="100" height="100" rx="30" fill="#FFE5EC"/>
                            <path d="M50 82C50 82 18 60 18 38C18 24 29 16 41 16C47 16 50 19 50 23C50 19 53 16 59 16C71 16 82 24 82 38C82 60 50 82 50 82Z" fill="#FB6F92"/>
                            <circle cx="41" cy="36" r="6.5" fill="#FFFFFF"/>
                            <circle cx="59" cy="36" r="6.5" fill="#FFFFFF"/>
                            <path d="M33 55 C33 46 47 46 47 55" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round"/>
                            <path d="M53 55 C53 46 67 46 67 55" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <h1 class="panel-brand-title">Bestie<span>Space</span> 💕</h1>
                    <p class="panel-brand-subtitle">Connect • Share • Make Memories Together ♡</p>
                </div>

                <!-- Besties Anime Squad Illustration -->
                <div class="panel-illustration-container">
                    <div class="speech-bubble-tag">
                        <span>Better Together ♡</span>
                    </div>
                    <img src="images/besties-squad.png" alt="BestieSpace Squad" class="besties-squad-img" />
                </div>

                <!-- Bottom Pill -->
                <div class="panel-bottom-pill">
                    <span class="pill-icon-box">👥</span>
                    <span class="pill-text">Join BestieSpace and keep your friendship closer! ♡</span>
                </div>
            </div>
        </div>

        <!-- ================= RIGHT FORM PANEL ================= -->
        <div class="login-right-panel">
            <!-- Top Right Sign Up Link -->
            <div class="top-register-row">
                <span>Don't have an account?</span>
                <a href="/register" class="signup-link">Sign Up →</a>
            </div>

            <!-- Welcome Header Block -->
            <div class="form-header-block">
                <h2 class="form-title">Welcome Back! 💕</h2>
                <p class="form-subtitle">Login to your BestieSpace account</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="form-error-banner">
                    <span>🥺</span>
                    <span>@errorMessage</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="form-success-banner">
                    <span>✨</span>
                    <span>@successMessage</span>
                </div>
            }

            @if (activeTab == "password")
            {
                <!-- Password Form -->
                <EditForm Model="loginModel" OnValidSubmit="HandlePasswordLogin" class="login-form-inner">
                    <!-- Email / Username Input -->
                    <div class="form-pill-input-group">
                        <span class="pill-icon">✉️</span>
                        <input type="text" 
                               class="pill-input" 
                               placeholder="Email or Username" 
                               @bind="loginModel.Username" 
                               required />
                    </div>

                    <!-- Password Input -->
                    <div class="form-pill-input-group">
                        <span class="pill-icon">🔒</span>
                        <input type="@(showPassword ? "text" : "password")" 
                               class="pill-input" 
                               placeholder="Password" 
                               @bind="loginModel.Password" 
                               required />
                        <button type="button" class="btn-eye-toggle" @onclick="() => showPassword = !showPassword" title="Show/Hide Password">
                            @(showPassword ? "👁️" : "🙈")
                        </button>
                    </div>

                    <!-- Remember Me & PIN Mode Toggle Row -->
                    <div class="form-sub-row">
                        <label class="remember-label">
                            <input type="checkbox" class="cute-checkbox" @bind="rememberMe" />
                            <span>Remember Me</span>
                        </label>
                        <button type="button" class="btn-pin-toggle" @onclick='() => SetTab("pin")'>
                            Use 4-Digit PIN? 🍓
                        </button>
                    </div>

                    <!-- Primary Login Button -->
                    <button type="submit" class="btn-main-login" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-dot">🌸</span>
                            <span>Logging in...</span>
                        }
                        else
                        {
                            <span class="login-icon">→]</span>
                            <span>Login</span>
                        }
                    </button>
                </EditForm>
            }
            else
            {
                <!-- Strawberry PIN Pad View -->
                <div class="pin-pad-view">
                    <div class="pin-display-slots">
                        @for (int i = 0; i < 4; i++)
                        {
                            var filled = i < enteredPin.Length;
                            <div class="pin-slot @(filled ? "filled" : "")">
                                @(filled ? "🍓" : "○")
                            </div>
                        }
                    </div>

                    <div class="pin-keys-grid">
                        @for (int n = 1; n <= 9; n++)
                        {
                            var digit = n.ToString();
                            <button type="button" class="pin-key-btn" @onclick="() => AppendPin(digit)" disabled="@isLoading">
                                @digit
                            </button>
                        }
                        <button type="button" class="pin-key-btn key-action" @onclick="ClearPin" disabled="@isLoading">C</button>
                        <button type="button" class="pin-key-btn" @onclick='() => AppendPin("0")' disabled="@isLoading">0</button>
                        <button type="button" class="pin-key-btn key-action" @onclick="BackspacePin" disabled="@isLoading">⌫</button>
                    </div>

                    <div style="text-align: center; margin-top: 14px;">
                        <button type="button" class="btn-back-to-password" @onclick='() => SetTab("password")'>
                            ← Switch to Password Login
                        </button>
                    </div>
                </div>
            }

            <!-- Separator -->
            <div class="form-or-divider">
                <span>or</span>
            </div>

            <!-- Social / Quick Shortcut Buttons -->
            <div class="social-login-row">
                <button type="button" class="btn-social-pill" @onclick='() => SetTab("password")'>
                    <svg class="social-icon" width="18" height="18" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>Continue with Google</span>
                </button>

                <button type="button" class="btn-social-pill" @onclick='() => SetTab(activeTab == "pin" ? "password" : "pin")'>
                    <span class="social-icon">🍓</span>
                    <span>@(activeTab == "pin" ? "Password Login" : "Continue with PIN")</span>
                </button>
            </div>

            <!-- Bottom Friendly Greeting Pill -->
            <div class="bottom-greeting-card">
                <span>💖 Good to see you again! 💕</span>
            </div>
        </div>
    </div>
</div>

@code {
    private string activeTab = "password";
    private bool showPassword = false;
    private bool rememberMe = true;
    private bool isLoading = false;
    private bool isWiggling = false;
    private string? errorMessage;
    private string? successMessage;
    private string enteredPin = "";

    private LoginRequestDto loginModel = new()
    {
        Username = "",
        Password = ""
    };

    private void SetTab(string tab)
    {
        activeTab = tab;
        errorMessage = null;
        successMessage = null;
        enteredPin = "";
    }

    private async Task HandlePasswordLogin()
    {
        if (isLoading) return;
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var res = await AuthProvider.LoginAsync(loginModel.Username.Trim(), loginModel.Password);
            if (res.IsSuccess)
            {
                successMessage = res.Message;
                await PlaySuccessEffects();
                await Task.Delay(400);
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = res.Message ?? "Oopsie! Wrong secret code 🥺 Try again!";
                TriggerWiggle();
            }
        }
        catch (Exception)
        {
            errorMessage = "Could not reach the BestieSpace server. Please ensure the API is running.";
            TriggerWiggle();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AppendPin(string digit)
    {
        if (enteredPin.Length < 4)
        {
            enteredPin += digit;
            errorMessage = null;

            if (enteredPin.Length == 4)
            {
                await SubmitPinAsync();
            }
        }
    }

    private void ClearPin()
    {
        enteredPin = "";
        errorMessage = null;
    }

    private void BackspacePin()
    {
        if (enteredPin.Length > 0)
        {
            enteredPin = enteredPin.Substring(0, enteredPin.Length - 1);
            errorMessage = null;
        }
    }

    private async Task SubmitPinAsync()
    {
        if (isLoading) return;
        isLoading = true;
        errorMessage = null;

        try
        {
            var res = await AuthProvider.PinLoginAsync(enteredPin);
            if (res.IsSuccess)
            {
                successMessage = res.Message;
                await PlaySuccessEffects();
                await Task.Delay(400);
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = res.Message ?? "Oopsie! Wrong strawberry PIN 🍓🥺 Try again!";
                TriggerWiggle();
                enteredPin = "";
            }
        }
        catch
        {
            errorMessage = "Could not connect to the BestieSpace server.";
            TriggerWiggle();
            enteredPin = "";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void TriggerWiggle()
    {
        isWiggling = true;
        _ = Task.Run(async () =>
        {
            await Task.Delay(550);
            isWiggling = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task PlaySuccessEffects()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("bestieAnimations.playCutePopSound");
            await JSRuntime.InvokeVoidAsync("bestieAnimations.triggerConfettiBurst");
        }
        catch { }
    }
}
