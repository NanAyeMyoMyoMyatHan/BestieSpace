    private async Task ToggleVoiceRecorder()
    {
        if (isRecordingAudio)
        {
            await CancelVoiceRecordingAsync();
        }
        else
        {
            await StartVoiceRecordingAsync();
        }
    }

    private async Task StartVoiceRecordingAsync()
    {
        errorMessage = null;
        try
        {
            var started = await JS.InvokeAsync<bool>("voiceRecorder.startRecording");
            if (started)
            {
                isRecordingAudio = true;
                recordingSeconds = 0;
                recordingTimer?.Dispose();
                recordingTimer = new System.Threading.Timer(async _ =>
                {
                    recordingSeconds++;
                    if (recordingSeconds >= 120)
                    {
                        await InvokeAsync(StopAndSendVoiceRecordingAsync);
                    }
                    else
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                }, null, 1000, 1000);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error starting voice recording");
            errorMessage = "Could not access microphone.";
        }
    }

    private async Task CancelVoiceRecordingAsync()
    {
        recordingTimer?.Dispose();
        recordingTimer = null;
        isRecordingAudio = false;
        recordingSeconds = 0;
        try
        {
            await JS.InvokeVoidAsync("voiceRecorder.cancelRecording");
        }
        catch { }
    }

    private async Task StopAndSendVoiceRecordingAsync()
    {
        if (isUploadingVoice) return;
        isUploadingVoice = true;
        recordingTimer?.Dispose();
        recordingTimer = null;

        try
        {
            var audioData = await JS.InvokeAsync<VoiceRecordingResultDto>("voiceRecorder.stopAndGetAudio");
            isRecordingAudio = false;

            if (audioData != null && !string.IsNullOrEmpty(audioData.Base64))
            {
                var request = new SendVoiceBase64RequestDto
                {
                    CircleId = CircleId,
                    DurationSeconds = audioData.Duration,
                    FileName = audioData.FileName ?? "voice-note.webm",
                    ContentType = audioData.MimeType ?? "audio/webm",
                    Base64Data = audioData.Base64
                };

                var sent = await ApiClient.SendCircleVoiceBase64Async(CircleId, request);
                if (sent != null)
                {
                    if (!messages.Any(m => m.Id == sent.Id))
                    {
                        messages.Add(sent);
                    }
                    await ScrollToBottomAsync();
                }
                else
                {
                    errorMessage = "Failed to send voice message.";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading voice recording");
            errorMessage = "Failed to upload voice note.";
        }
        finally
        {
            isUploadingVoice = false;
            recordingSeconds = 0;
        }
    }

    private async Task TogglePlayAudio(int messageId)
    {
        var elementId = $"audio-{messageId}";
        if (playingAudioId == messageId)
        {
            await JS.InvokeVoidAsync("pastelAudioPlayer.pause", elementId);
            playingAudioId = null;
        }
        else
        {
            if (playingAudioId.HasValue)
            {
                await JS.InvokeVoidAsync("pastelAudioPlayer.pause", $"audio-{playingAudioId.Value}");
            }
            playingAudioId = messageId;
            await JS.InvokeVoidAsync("pastelAudioPlayer.play", elementId);
        }
    }

