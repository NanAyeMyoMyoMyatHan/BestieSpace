@code {
    [Parameter]
    public int CircleId { get; set; }

    private CircleDetailDto? circle;
    private List<CircleMemberDto> members = new();
    private List<CircleMemberPresenceEventDto> presenceList = new();
    private List<CircleChatMessageDto> messages = new();

    private HubConnection? hubConnection;
    private bool isHubConnected = false;

    private int currentUserId = 0;
    private string? currentUserAvatar = "🎀";
    private string myRoleName = "Member";
    private bool isMember = false;
    private bool isLoadingInitial = true;
    private bool isLoadingOlder = false;
    private bool hasMoreMessages = false;
    private int currentPage = 1;

    private string newMessageText = string.Empty;
    private bool isSending = false;
    private string? errorMessage;
    private bool showRosterDrawer = false;

    // Editing
    private int? editingMessageId;
    private string editingContent = string.Empty;
    private bool isSubmittingEdit = false;

    private int onlineMembersCount => members.Count(m => presenceList.Any(p => p.UserId == m.UserId && p.IsOnline));

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserAsync();
        await LoadCircleAndMembershipAsync();

        if (isMember)
        {
            await LoadMessagesAsync(1, appendOlder: false);
            await LoadPresenceAsync();
            await InitializeSignalRAsync();
        }

        isLoadingInitial = false;
    }

    private async Task LoadCurrentUserAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                          ?? user.FindFirst("sub")?.Value;
            int.TryParse(idClaim, out currentUserId);
            currentUserAvatar = user.FindFirst("avatarSticker")?.Value ?? "🎀";
        }
    }

    private async Task LoadCircleAndMembershipAsync()
    {
        try
        {
            circle = await ApiClient.GetCircleDetailsAsync(CircleId);
            if (circle != null)
            {
                members = await ApiClient.GetCircleMembersAsync(CircleId);
                var me = members.FirstOrDefault(m => m.UserId == currentUserId);
                if (me != null)
                {
                    isMember = true;
                    myRoleName = me.RoleName;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load circle {CircleId} details", CircleId);
            isMember = false;
        }
    }

    private async Task LoadMessagesAsync(int page, bool appendOlder)
    {
        try
        {
            var result = await ApiClient.GetCircleMessagesAsync(CircleId, page, pageSize: 30);
            if (result != null)
            {
                hasMoreMessages = result.HasMore;
                currentPage = result.PageNumber;

                if (appendOlder)
                {
                    // Prepend older messages avoiding duplicates
                    var newOldMessages = result.Messages.Where(m => !messages.Any(existing => existing.Id == m.Id)).ToList();
                    messages.InsertRange(0, newOldMessages);
                }
                else
                {
                    messages = result.Messages;
                    await ScrollToBottomAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error fetching messages for circle {CircleId}", CircleId);
            errorMessage = "Could not load message history.";
        }
    }

    private async Task LoadOlderMessages()
    {
        if (isLoadingOlder || !hasMoreMessages) return;
        isLoadingOlder = true;
        try
        {
            await LoadMessagesAsync(currentPage + 1, appendOlder: true);
        }
        finally
        {
            isLoadingOlder = false;
        }
    }

    private async Task LoadPresenceAsync()
    {
        try
        {
            presenceList = await ApiClient.GetCirclePresenceAsync(CircleId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not fetch presence for circle {CircleId}", CircleId);
        }
    }

    private async Task InitializeSignalRAsync()
    {
        try
        {
            var bestieAuth = AuthStateProvider as BestieAuthenticationStateProvider;
            var token = bestieAuth?.AccessToken;

            var hubUrl = $"{ApiClient.ApiBaseUrl.TrimEnd('/')}/chathub";

            hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl, options =>
                {
                    options.AccessTokenProvider = () => Task.FromResult<string?>(token);
                })
                .WithAutomaticReconnect(new[] { TimeSpan.Zero, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(10) })
                .Build();

            // Register Real-Time Events
            hubConnection.On<CircleChatMessageDto>("ReceiveMessage", (msg) =>
            {
                if (msg.CircleId == CircleId)
                {
                    if (!messages.Any(m => m.Id == msg.Id))
                    {
                        messages.Add(msg);
                        InvokeAsync(StateHasChanged);
                        _ = ScrollToBottomAsync();
                    }
                }
            });

            hubConnection.On<CircleChatMessageDto>("MessageUpdated", (updated) =>
            {
                if (updated.CircleId == CircleId)
                {
                    var idx = messages.FindIndex(m => m.Id == updated.Id);
                    if (idx >= 0)
                    {
                        messages[idx] = updated;
                        InvokeAsync(StateHasChanged);
                    }
                }
            });

            hubConnection.On<CircleMessageDeletedEventDto>("MessageDeleted", (del) =>
            {
                if (del.CircleId == CircleId)
                {
                    var existing = messages.FirstOrDefault(m => m.Id == del.MessageId);
                    if (existing != null)
                    {
                        existing.IsDeleted = true;
                        existing.Content = "🌸 This message was deleted";
                        InvokeAsync(StateHasChanged);
                    }
                }
            });

            hubConnection.On<CircleMemberPresenceEventDto>("UserOnline", (presence) =>
            {
                var existing = presenceList.FirstOrDefault(p => p.UserId == presence.UserId);
                if (existing != null)
                {
                    existing.IsOnline = true;
                }
                else
                {
                    presenceList.Add(presence);
                }
                InvokeAsync(StateHasChanged);
            });

            hubConnection.On<CircleMemberPresenceEventDto>("UserOffline", (presence) =>
            {
                var existing = presenceList.FirstOrDefault(p => p.UserId == presence.UserId);
                if (existing != null)
                {
                    existing.IsOnline = false;
                }
                InvokeAsync(StateHasChanged);
            });

            hubConnection.Reconnecting += (error) =>
            {
                isHubConnected = false;
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            };

            hubConnection.Reconnected += async (connectionId) =>
            {
                isHubConnected = true;
                Logger.LogInformation("SignalR Reconnected: {ConnectionId}. Rejoining circle group {CircleId}", connectionId, CircleId);
                await hubConnection.InvokeAsync("JoinCircle", CircleId);
                // Refresh latest messages after reconnect to load any missed messages
                await LoadMessagesAsync(1, appendOlder: false);
                await InvokeAsync(StateHasChanged);
            };

            await hubConnection.StartAsync();
            isHubConnected = true;

            // Join the private circle group on the server
            await hubConnection.InvokeAsync("JoinCircle", CircleId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to connect to SignalR hub for circle {CircleId}", CircleId);
            isHubConnected = false;
        }
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(newMessageText) || isSending) return;

        var text = newMessageText.Trim();
        isSending = true;
        errorMessage = null;

        try
        {
            var sent = await ApiClient.SendCircleMessageAsync(CircleId, text);
            if (sent != null)
            {
                newMessageText = string.Empty;
                if (!messages.Any(m => m.Id == sent.Id))
                {
                    messages.Add(sent);
                }
                await ScrollToBottomAsync();
            }
            else
            {
                errorMessage = "Failed to send message. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sending message");
            errorMessage = ex.Message;
        }
        finally
        {
            isSending = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessageAsync();
        }
    }

    private void StartEdit(CircleChatMessageDto msg)
    {
        editingMessageId = msg.Id;
        editingContent = msg.Content ?? string.Empty;
    }

    private void CancelEdit()
    {
        editingMessageId = null;
        editingContent = string.Empty;
    }

    private async Task SaveEditAsync()
    {
        if (!editingMessageId.HasValue || string.IsNullOrWhiteSpace(editingContent)) return;

        isSubmittingEdit = true;
        try
        {
            var updated = await ApiClient.EditCircleMessageAsync(CircleId, editingMessageId.Value, editingContent);
            if (updated != null)
            {
                var idx = messages.FindIndex(m => m.Id == updated.Id);
                if (idx >= 0)
                {
                    messages[idx] = updated;
                }
                editingMessageId = null;
                editingContent = string.Empty;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to edit message");
            errorMessage = "Failed to edit message.";
        }
        finally
        {
            isSubmittingEdit = false;
        }
    }

    private async Task DeleteMessageAsync(int messageId)
    {
        try
        {
            var ok = await ApiClient.DeleteCircleMessageAsync(CircleId, messageId);
            if (ok)
            {
                var existing = messages.FirstOrDefault(m => m.Id == messageId);
                if (existing != null)
                {
                    existing.IsDeleted = true;
                    existing.Content = "🌸 This message was deleted";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete message {MessageId}", messageId);
            errorMessage = "Could not delete message.";
        }
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "var el = document.getElementById('chat-messages-box'); if (el) el.scrollTop = el.scrollHeight;");
        }
        catch { }
    }

    private string FormatDateDivider(DateTime dt)
    {
        var today = DateTime.Today;
        if (dt.Date == today) return "Today";
        if (dt.Date == today.AddDays(-1)) return "Yesterday";
        return dt.ToString("MMMM d, yyyy");
    }

    private void GoBackToCircles() => Nav.NavigateTo("/circles");
    private void OpenCircleRoster() => showRosterDrawer = !showRosterDrawer;

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            try
            {
                if (hubConnection.State == HubConnectionState.Connected)
                {
                    await hubConnection.InvokeAsync("LeaveCircle", CircleId);
                }
                await hubConnection.DisposeAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Error disposing HubConnection");
            }
        }
    }
}
