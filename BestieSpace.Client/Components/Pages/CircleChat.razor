@page "/circles/{CircleId:int}/chat"
@rendermode InteractiveServer
@implements IAsyncDisposable

@using System.Security.Claims
@using BestieSpace.Shared.DTOs
@using BestieSpace.Client.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms

@inject IBestieApiClient ApiClient
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<CircleChat> Logger

<PageTitle>@(circle?.CircleName ?? "Circle Chat") - BestieSpace 🌸</PageTitle>

<div class="circle-chat-page">
    @if (isLoadingInitial)
    {
        <div class="chat-loading-state">
            <div class="kawaii-spinner">🌸</div>
            <p>Gathering your besties into the chat room...</p>
        </div>
    }
    else if (!isMember)
    {
        <div class="chat-forbidden-card">
            <div class="lock-icon">🔒</div>
            <h2>Private Bestie Circle</h2>
            <p>You must be an active member of this circle to open its private group chat.</p>
            <button class="btn-back" @onclick="GoBackToCircles">← Back to Bestie Circles</button>
        </div>
    }
    else
    {
        <!-- CHAT WRAPPER -->
        <div class="chat-wrapper">
            <!-- CHAT HEADER -->
            <header class="chat-header">
                <div class="header-left">
                    <button class="btn-icon-back" title="Back to circles" @onclick="GoBackToCircles">
                        <span>←</span>
                    </button>
                    <div class="circle-avatar-bubble">
                        <span class="circle-icon">@(string.IsNullOrWhiteSpace(circle?.CircleIcon) ? "🌸" : circle.CircleIcon)</span>
                    </div>
                    <div class="circle-header-meta">
                        <div class="circle-title-row">
                            <h2 class="circle-name">@(circle?.CircleName ?? "Bestie Circle")</h2>
                            <span class="role-pill">@myRoleName</span>
                        </div>
                        <div class="circle-status-row">
                            <span class="online-indicator @(isHubConnected ? "connected" : "reconnecting")"></span>
                            <span class="online-text">
                                @(onlineMembersCount) of @(members.Count)/9 besties online
                            </span>
                            @if (!isHubConnected)
                            {
                                <span class="reconnecting-tag">🔄 Reconnecting...</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="header-right">
                    <NotificationCenter />
                    <button class="btn-header-action" title="View Circle Details & Roster" @onclick="OpenCircleRoster">
                        <span>👑 Roster (@members.Count/9)</span>
                    </button>
                </div>
            </header>

            <!-- CHAT ROSTER DRAWER (if toggled) -->
            @if (showRosterDrawer)
            {
                <div class="roster-drawer">
                    <div class="roster-drawer-header">
                        <h3>Circle Members (@members.Count / 9)</h3>
                        <button class="btn-close-sm" @onclick="@(() => showRosterDrawer = false)">✕</button>
                    </div>
                    <div class="roster-list">
                        @foreach (var m in members)
                        {
                            var isUserOnline = presenceList.Any(p => p.UserId == m.UserId && p.IsOnline);
                            <div class="roster-item">
                                <div class="roster-avatar-wrap">
                                    <span class="roster-sticker">@(m.UserAvatarSticker ?? "🌸")</span>
                                    <span class="status-dot @(isUserOnline ? "online" : "offline")"></span>
                                </div>
                                <div class="roster-info">
                                    <div class="roster-name-row">
                                        <strong>@m.UserDisplayName</strong>
                                        <span class="badge-role">@m.RoleName</span>
                                    </div>
                                    <span class="roster-sub">@@@m.Username • @(isUserOnline ? "Active now" : "Offline")</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- MESSAGES CONTAINER -->
            <main class="chat-messages-container" id="chat-messages-box">
                @if (hasMoreMessages)
                {
                    <div class="load-older-bar">
                        <button class="btn-load-older" disabled="@isLoadingOlder" @onclick="LoadOlderMessages">
                            @if (isLoadingOlder)
                            {
                                <span>🌸 Loading earlier memories...</span>
                            }
                            else
                            {
                                <span>📜 Load older bestie messages</span>
                            }
                        </button>
                    </div>
                }

                @if (messages.Count == 0)
                {
                    <div class="empty-chat-hero">
                        <div class="hero-sticker">💌✨</div>
                        <h3>Welcome to your private Circle chat!</h3>
                        <p>No messages here yet. Say hello, send a photo, cute sticker, or voice note to your besties!</p>
                    </div>
                }
                else
                {
                    string? lastDateHeader = null;

                    @for (int i = 0; i < messages.Count; i++)
                    {
                        var msg = messages[i];
                        var msgDate = msg.CreatedAt.ToLocalTime().ToString("MMMM d, yyyy");
                        var isNewDate = msgDate != lastDateHeader;
                        if (isNewDate)
                        {
                            lastDateHeader = msgDate;
                            <div class="date-divider">
                                <span>@FormatDateDivider(msg.CreatedAt.ToLocalTime())</span>
                            </div>
                        }

                        var isMe = msg.SenderId == currentUserId;
                        var rowClass = isMe ? "msg-me" : "msg-other";

                        <div class="chat-message-row @rowClass @(msg.IsDeleted ? "is-deleted" : "") @(msg.MessageType == "sticker" ? "sticker-msg" : "")" id="@($"msg-{msg.Id}")">
                            @if (!isMe)
                            {
                                <div class="sender-avatar" title="@msg.SenderDisplayName">
                                    <span>@(string.IsNullOrWhiteSpace(msg.SenderAvatarSticker) ? "🌸" : msg.SenderAvatarSticker)</span>
                                </div>
                            }

                            <div class="bubble-wrapper">
                                @if (!isMe)
                                {
                                    <div class="sender-tag">
                                        <span class="sender-name">@msg.SenderDisplayName</span>
                                        <span class="sender-username">@@@msg.SenderUsername</span>
                                    </div>
                                }

                                <div class="message-bubble @(msg.MessageType)">
                                    @if (editingMessageId == msg.Id)
                                    {
                                        <!-- Inline Editing Mode -->
                                        <div class="inline-edit-box">
                                            <input type="text" 
                                                   class="edit-input" 
                                                   @bind="editingContent" 
                                                   @bind:event="oninput" 
                                                   maxlength="2000" />
                                            <div class="edit-actions">
                                                <button class="btn-edit-save" @onclick="SaveEditAsync" disabled="@isSubmittingEdit">💾 Save</button>
                                                <button class="btn-edit-cancel" @onclick="CancelEdit">✕ Cancel</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="bubble-content">
                                            @if (msg.IsDeleted)
                                            {
                                                <span class="deleted-text">🌸 This message was deleted</span>
                                            }
                                            else if (msg.MessageType == "photo")
                                            {
                                                <!-- Photo Message -->
                                                var photoSrc = GetMessageMediaUrl(msg);
                                                <div class="photo-bubble-content">
                                                    <img src="@photoSrc" 
                                                         class="chat-photo-img" 
                                                         alt="Circle photo" 
                                                         @onclick="@(() => OpenZoomModal(photoSrc, msg.Content))" 
                                                         loading="lazy" />
                                                    @if (!string.IsNullOrWhiteSpace(msg.Content))
                                                    {
                                                        <p class="photo-caption">@msg.Content</p>
                                                    }
                                                </div>
                                            }
                                            else if (msg.MessageType == "sticker")
                                            {
                                                <!-- Sticker Message -->
                                                <div class="sticker-bubble-content">
                                                    @if (msg.Content != null && (msg.Content.StartsWith("http") || msg.Content.StartsWith("/")))
                                                    {
                                                        <img src="@msg.Content" class="sticker-img" alt="Sticker" />
                                                    }
                                                    else
                                                    {
                                                        <span class="sticker-emoji">@msg.Content</span>
                                                    }
                                                </div>
                                            }
                                            else if (msg.MessageType == "voice")
                                            {
                                                <!-- Voice Message -->
                                                var audioSrc = GetMessageMediaUrl(msg);
                                                var isThisAudioPlaying = playingAudioId == msg.Id;
                                                <div class="voice-bubble-content">
                                                    <button class="btn-voice-play @(isThisAudioPlaying ? "playing" : "")" 
                                                            @onclick="@(() => TogglePlayAudio(msg.Id))" 
                                                            title="@(isThisAudioPlaying ? "Pause voice note" : "Play voice note")">
                                                        <span>@(isThisAudioPlaying ? "⏸️" : "▶️")</span>
                                                    </button>
                                                    
                                                    <div class="voice-waveform-wrap">
                                                        <div class="voice-bars @(isThisAudioPlaying ? "animated" : "")">
                                                            <span class="bar bar-1"></span>
                                                            <span class="bar bar-2"></span>
                                                            <span class="bar bar-3"></span>
                                                            <span class="bar bar-4"></span>
                                                            <span class="bar bar-5"></span>
                                                            <span class="bar bar-6"></span>
                                                            <span class="bar bar-7"></span>
                                                            <span class="bar bar-8"></span>
                                                        </div>
                                                        <span class="voice-duration">@FormatDuration(msg.DurationSeconds ?? 0)</span>
                                                    </div>

                                                    <audio id="@($"audio-{msg.Id}")" 
                                                           src="@audioSrc" 
                                                           preload="metadata" 
                                                           @onended="@(() => OnAudioEnded(msg.Id))"></audio>
                                                </div>
                                            }
                                            else
                                            {
                                                <!-- Text Message -->
                                                <p class="text-content">@msg.Content</p>
                                                @if (msg.UpdatedAt.HasValue)
                                                {
                                                    <span class="edited-flag">(edited)</span>
                                                }
                                            }
                                        </div>

                                        <div class="bubble-footer">
                                            <span class="msg-time">@msg.CreatedAt.ToLocalTime().ToString("h:mm tt")</span>

                                            @if (!msg.IsDeleted && isMe)
                                            {
                                                <button type="button" class="btn-receipt-status @msg.DeliveryStatus.ToLowerInvariant()" 
                                                        title="Read by @(msg.ReadCount)/@(msg.TotalRecipients) • Click for receipt details" 
                                                        @onclick="@(() => OpenReadReceiptDetails(msg))">
                                                    @if (msg.DeliveryStatus == "Read")
                                                    {
                                                        <span class="status-ticks read" title="Read by @msg.ReadCount besties">✓✓</span>
                                                        <span class="receipt-count">@msg.ReadCount/@msg.TotalRecipients</span>
                                                    }
                                                    else if (msg.DeliveryStatus == "Delivered")
                                                    {
                                                        <span class="status-ticks delivered" title="Delivered to @msg.DeliveredCount besties">✓✓</span>
                                                        <span class="receipt-count">@msg.DeliveredCount/@msg.TotalRecipients</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="status-ticks sent" title="Sent to BestieSpace">✓</span>
                                                    }
                                                </button>
                                            }

                                            @if (!msg.IsDeleted && (msg.CanEdit || msg.CanDelete))
                                            {
                                                <div class="msg-actions-dropdown">
                                                    @if (msg.CanEdit)
                                                    {
                                                        <button class="btn-tiny-action" title="Edit message" @onclick="@(() => StartEdit(msg))">✏️</button>
                                                    }
                                                    @if (msg.CanDelete)
                                                    {
                                                        <button class="btn-tiny-action delete" title="Delete message" @onclick="@(() => DeleteMessageAsync(msg.Id))">🗑️</button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (isMe)
                            {
                                <div class="sender-avatar my-avatar" title="You">
                                    <span>@(currentUserAvatar ?? "🎀")</span>
                                </div>
                            }
                        </div>
                    }
                }
            </main>

            <!-- STICKER PICKER DRAWER (if open) -->
            @if (showStickerDrawer)
            {
                <div class="sticker-drawer-pane">
                    <div class="sticker-drawer-header">
                        <span class="sticker-drawer-title">🌸 Choose a Bestie Sticker</span>
                        <button class="btn-close-sm" @onclick="@(() => showStickerDrawer = false)">✕</button>
                    </div>

                    <!-- Category Pills -->
                    <div class="sticker-category-tabs">
                        @foreach (var cat in stickerCategories)
                        {
                            <button class="category-pill-tab @(selectedCategoryId == cat.CategoryId ? "active" : "")"
                                    @onclick="@(() => selectedCategoryId = cat.CategoryId)">
                                <span>@cat.Icon @cat.CategoryName</span>
                            </button>
                        }
                    </div>

                    <!-- Sticker Grid -->
                    <div class="sticker-items-grid">
                        @{
                            var currentCat = stickerCategories.FirstOrDefault(c => c.CategoryId == selectedCategoryId)
                                             ?? stickerCategories.FirstOrDefault();
                            if (currentCat != null)
                            {
                                @foreach (var st in currentCat.Stickers)
                                {
                                    <button class="btn-sticker-select" 
                                            title="@st.StickerName" 
                                            @onclick="@(() => SendStickerAsync(st.StickerId))">
                                        @if (st.ImageUrl.StartsWith("http") || st.ImageUrl.StartsWith("/"))
                                        {
                                            <img src="@st.ImageUrl" alt="@st.StickerName" class="sticker-grid-img" />
                                        }
                                        else
                                        {
                                            <span class="sticker-grid-emoji">@st.ImageUrl</span>
                                        }
                                        <span class="sticker-caption-label">@st.StickerName</span>
                                    </button>
                                }
                            }
                        }
                    </div>
                </div>
            }

            <!-- VOICE RECORDING ACTIVE BAR (if recording) -->
            @if (isRecordingAudio)
            {
                <div class="voice-recording-bar">
                    <div class="recording-indicator">
                        <span class="pulse-red-dot">🔴</span>
                        <span class="recording-label">Recording Voice Note...</span>
                        <span class="recording-timer">@FormatDuration(recordingSeconds) / 2:00</span>
                    </div>

                    <div class="recording-waveform-preview">
                        <span class="wave wave-1"></span>
                        <span class="wave wave-2"></span>
                        <span class="wave wave-3"></span>
                        <span class="wave wave-4"></span>
                        <span class="wave wave-5"></span>
                    </div>

                    <div class="recording-actions">
                        <button class="btn-recording-cancel" title="Cancel recording" @onclick="CancelVoiceRecordingAsync">✕ Cancel</button>
                        <button class="btn-recording-send" title="Send voice note" @onclick="StopAndSendVoiceRecordingAsync" disabled="@isUploadingVoice">
                            @if (isUploadingVoice)
                            {
                                <span>🌸 Sending...</span>
                            }
                            else
                            {
                                <span>🎤 Send Voice</span>
                            }
                        </button>
                    </div>
                </div>
            }

            <!-- PHOTO PREVIEW MODAL (before sending) -->
            @if (showPhotoModal)
            {
                <div class="photo-modal-overlay" @onclick="CancelPhotoUpload">
                    <div class="photo-modal-card" @onclick:stopPropagation>
                        <div class="photo-modal-header">
                            <h3>📸 Send Photo to Circle</h3>
                            <button class="btn-close-sm" @onclick="CancelPhotoUpload">✕</button>
                        </div>
                        <div class="photo-preview-wrap">
                            @if (!string.IsNullOrEmpty(selectedPhotoPreviewBase64))
                            {
                                <img src="@selectedPhotoPreviewBase64" class="photo-modal-img" alt="Preview" />
                            }
                        </div>
                        <div class="photo-caption-input-wrap">
                            <input type="text" 
                                   class="photo-caption-input" 
                                   placeholder="Add a cute caption... 🍓 (optional)" 
                                   @bind="photoCaption" 
                                   maxlength="500" />
                        </div>
                        <div class="photo-modal-footer">
                            <button class="btn-cancel-modal" @onclick="CancelPhotoUpload">Cancel</button>
                            <button class="btn-send-photo" @onclick="SendSelectedPhotoAsync" disabled="@isUploadingPhoto">
                                @if (isUploadingPhoto)
                                {
                                    <span>🌸 Uploading...</span>
                                }
                                else
                                {
                                    <span>🍓 Send Photo</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- FULL IMAGE ZOOM LIGHTBOX -->
            @if (!string.IsNullOrEmpty(zoomImageUrl))
            {
                <div class="zoom-lightbox-overlay" @onclick="CloseZoomModal">
                    <button class="btn-close-zoom" @onclick="CloseZoomModal">✕</button>
                    <div class="zoom-img-box" @onclick:stopPropagation>
                        <img src="@zoomImageUrl" class="zoom-full-img" alt="Enlarged photo" />
                        @if (!string.IsNullOrEmpty(zoomCaption))
                        {
                            <p class="zoom-caption-text">@zoomCaption</p>
                        }
                    </div>
                </div>
            }

            <!-- READ RECEIPT DETAILS MODAL -->
            @if (showReadReceiptModal && selectedReceiptMessage != null)
            {
                <div class="receipt-modal-backdrop" @onclick="CloseReadReceiptModal">
                    <div class="receipt-modal-card" @onclick:stopPropagation>
                        <div class="receipt-modal-header">
                            <div class="receipt-title-group">
                                <span class="receipt-header-icon">👁️</span>
                                <div>
                                    <h3>Message Info & Read Receipts</h3>
                                    <span class="receipt-sub">Circle: @(circle?.CircleName ?? "Bestie Circle")</span>
                                </div>
                            </div>
                            <button type="button" class="btn-receipt-close" @onclick="CloseReadReceiptModal">✕</button>
                        </div>

                        <div class="receipt-modal-body">
                            <!-- Message Preview -->
                            <div class="receipt-msg-preview">
                                <div class="preview-bubble @selectedReceiptMessage.MessageType">
                                    @if (selectedReceiptMessage.MessageType == "photo")
                                    {
                                        <span class="preview-type-tag">📸 Photo Message</span>
                                    }
                                    else if (selectedReceiptMessage.MessageType == "voice")
                                    {
                                        <span class="preview-type-tag">🎙️ Voice Note (@FormatDuration(selectedReceiptMessage.DurationSeconds ?? 0))</span>
                                    }
                                    else if (selectedReceiptMessage.MessageType == "sticker")
                                    {
                                        <span class="preview-type-tag">🌸 Bestie Sticker</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(selectedReceiptMessage.Content))
                                    {
                                        <p class="preview-text">@selectedReceiptMessage.Content</p>
                                    }
                                    <span class="preview-time">Sent @selectedReceiptMessage.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                                </div>
                            </div>

                            @if (isLoadingReceiptDetails)
                            {
                                <div class="receipt-loading-state">
                                    <span class="kawaii-spinner">🌸</span>
                                    <p>Loading bestie receipts...</p>
                                </div>
                            }
                            else if (activeReadDetails != null)
                            {
                                var readers = activeReadDetails.Members.Where(m => m.HasRead).ToList();
                                var deliveredUnread = activeReadDetails.Members.Where(m => !m.HasRead && m.HasDelivered).ToList();
                                var pendingOffline = activeReadDetails.Members.Where(m => !m.HasRead && !m.HasDelivered).ToList();
                                var totalDelivered = activeReadDetails.Members.Count(m => m.HasDelivered);

                                <!-- Stats Summary Pills -->
                                <div class="receipt-stats-row">
                                    <div class="stat-pill read">
                                        <span class="stat-count">@activeReadDetails.ReadCount</span>
                                        <span class="stat-label">Read</span>
                                    </div>
                                    <div class="stat-pill delivered">
                                        <span class="stat-count">@totalDelivered</span>
                                        <span class="stat-label">Delivered</span>
                                    </div>
                                    <div class="stat-pill total">
                                        <span class="stat-count">@activeReadDetails.TotalMembers</span>
                                        <span class="stat-label">Total Besties</span>
                                    </div>
                                </div>

                                <!-- Readers Section -->
                                <div class="receipt-section">
                                    <h4>🌸 Read by (@readers.Count)</h4>
                                    @if (readers.Count == 0)
                                    {
                                        <p class="empty-receipt-note">No besties have opened this message yet 💌</p>
                                    }
                                    else
                                    {
                                        <div class="recipient-avatar-list">
                                            @foreach (var reader in readers)
                                            {
                                                <div class="recipient-row">
                                                    <div class="recipient-avatar">
                                                        <span>@(reader.AvatarSticker ?? "🌸")</span>
                                                    </div>
                                                    <div class="recipient-info">
                                                        <div class="recipient-name-row">
                                                            <strong>@reader.DisplayName</strong>
                                                            <span class="recipient-uname">@@@reader.Username</span>
                                                        </div>
                                                        <span class="receipt-time">Read @(reader.ReadAt.HasValue ? FormatReadTime(reader.ReadAt.Value) : "Recently")</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                <!-- Delivered (Unread) Section -->
                                @if (deliveredUnread.Count > 0)
                                {
                                    <div class="receipt-section">
                                        <h4>📬 Delivered to devices (@deliveredUnread.Count)</h4>
                                        <div class="recipient-avatar-list">
                                            @foreach (var d in deliveredUnread)
                                            {
                                                <div class="recipient-row">
                                                    <div class="recipient-avatar">
                                                        <span>@(d.AvatarSticker ?? "🌸")</span>
                                                    </div>
                                                    <div class="recipient-info">
                                                        <strong>@d.DisplayName</strong>
                                                        <span class="recipient-status-tag">Delivered • Not yet opened</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                <!-- Pending / Offline Section -->
                                @if (pendingOffline.Count > 0)
                                {
                                    <div class="receipt-section">
                                        <h4>💤 Offline / Waiting for delivery (@pendingOffline.Count)</h4>
                                        <div class="recipient-avatar-list">
                                            @foreach (var p in pendingOffline)
                                            {
                                                <div class="recipient-row pending">
                                                    <div class="recipient-avatar">
                                                        <span>@(p.AvatarSticker ?? "🌸")</span>
                                                    </div>
                                                    <div class="recipient-info">
                                                        <strong>@p.DisplayName</strong>
                                                        <span class="recipient-status-tag offline">Offline • Will sync when online</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- CHAT INPUT BAR -->
            <footer class="chat-input-bar">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="chat-error-toast">
                        <span>⚠️ @errorMessage</span>
                        <button class="btn-dismiss-err" @onclick="@(() => errorMessage = null)">✕</button>
                    </div>
                }

                <div class="input-composer">
                    <!-- Multimedia Action Buttons -->
                    <div class="media-tools-group">
                        <!-- Hidden Photo File Input -->
                        <InputFile id="circlePhotoFileInput" 
                                   OnChange="OnPhotoFileSelected" 
                                   accept="image/jpeg,image/png,image/webp" 
                                   style="display:none;" />

                        <label for="circlePhotoFileInput" class="btn-tool-media" title="Share a photo (JPEG, PNG, WebP)">
                            <span>📸</span>
                        </label>

                        <button type="button" 
                                class="btn-tool-media @(showStickerDrawer ? "active" : "")" 
                                title="Bestie Stickers" 
                                @onclick="ToggleStickerDrawer">
                            <span>🌸</span>
                        </button>

                        <button type="button" 
                                class="btn-tool-media @(isRecordingAudio ? "recording" : "")" 
                                title="Record Voice Note" 
                                @onclick="ToggleVoiceRecorder">
                            <span>🎤</span>
                        </button>
                    </div>

                    <textarea class="chat-textarea"
                              placeholder="Message your circle besties... 🌸 (Enter to send, Shift+Enter for new line)"
                              rows="1"
                              maxlength="2000"
                              @bind="newMessageText"
                              @bind:event="oninput"
                              @onkeydown="HandleKeyDown"
                              disabled="@(isSending || isRecordingAudio)"></textarea>

                    <div class="composer-side">
                        <span class="char-counter @(newMessageText.Length > 1900 ? "warn" : "")">
                            @newMessageText.Length/2000
                        </span>
                        <button class="btn-send-message" 
                                disabled="@(string.IsNullOrWhiteSpace(newMessageText) || isSending || isRecordingAudio)" 
                                @onclick="SendMessageAsync">
                            @if (isSending)
