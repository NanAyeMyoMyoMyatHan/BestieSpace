    private string FormatDateDivider(DateTime dt)
    {
        var today = DateTime.Today;
        if (dt.Date == today) return "Today";
        if (dt.Date == today.AddDays(-1)) return "Yesterday";
        return dt.ToString("MMMM d, yyyy");
    }

    private async Task ProcessIncomingReceiptsAndAcksAsync(IEnumerable<CircleChatMessageDto> incoming)
    {
        if (incoming == null || !incoming.Any()) return;

        var unDelivered = incoming
            .Where(m => m.SenderId != currentUserId && !m.IsDeliveredToMe)
            .Select(m => m.Id)
            .Distinct()
            .ToList();

        if (unDelivered.Any())
        {
            foreach (var m in incoming.Where(x => unDelivered.Contains(x.Id)))
            {
                m.IsDeliveredToMe = true;
            }
            _ = ApiClient.AcknowledgeDeliveryAsync(CircleId, unDelivered);
        }

        var unRead = incoming
            .Where(m => m.SenderId != currentUserId && !m.IsReadByMe)
            .Select(m => m.Id)
            .Distinct()
            .ToList();

        if (unRead.Any())
        {
            foreach (var m in incoming.Where(x => unRead.Contains(x.Id)))
            {
                m.IsReadByMe = true;
            }
            _ = ApiClient.MarkCircleMessagesAsReadAsync(CircleId, unRead);
        }
    }

