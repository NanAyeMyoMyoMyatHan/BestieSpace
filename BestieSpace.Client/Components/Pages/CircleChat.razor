    private async Task OnPhotoFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        var file = e.File;
        if (file == null) return;

        // Size check (max 10MB)
        if (file.Size > 10 * 1024 * 1024)
        {
            errorMessage = "Image file is too large (maximum 10MB).";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            selectedPhotoFileName = file.Name;
            selectedPhotoContentType = file.ContentType;
            selectedPhotoPreviewBase64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
            photoCaption = string.Empty;
            showPhotoModal = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to read selected photo file");
            errorMessage = "Could not process selected image.";
        }
    }

    private void CancelPhotoUpload()
    {
        showPhotoModal = false;
        selectedPhotoPreviewBase64 = null;
        selectedPhotoFileName = null;
        photoCaption = string.Empty;
    }

    private async Task SendSelectedPhotoAsync()
    {
        if (string.IsNullOrEmpty(selectedPhotoPreviewBase64) || isUploadingPhoto) return;

        isUploadingPhoto = true;
        errorMessage = null;

        try
        {
            var request = new SendPhotoBase64RequestDto
            {
                CircleId = CircleId,
                Caption = photoCaption,
                FileName = selectedPhotoFileName ?? "bestie-photo.jpg",
                ContentType = selectedPhotoContentType ?? "image/jpeg",
                Base64Data = selectedPhotoPreviewBase64
            };

            var sent = await ApiClient.SendCirclePhotoBase64Async(CircleId, request);
            if (sent != null)
            {
                CancelPhotoUpload();
                if (!messages.Any(m => m.Id == sent.Id))
                {
                    messages.Add(sent);
                }
                await ScrollToBottomAsync();
            }
            else
            {
                errorMessage = "Failed to upload photo. Ensure you have CHAT_SEND_IMAGE permission.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sending photo");
            errorMessage = ex.Message;
        }
        finally
        {
            isUploadingPhoto = false;
        }
    }

