@page "/photos"
@page "/memories"
@rendermode InteractiveServer

@using BestieSpace.Client.Services
@using BestieSpace.Shared.DTOs
@using Microsoft.AspNetCore.Components.Forms
@inject IBestieApiClient ApiClient
@inject NavigationManager Nav
@inject ILogger<MemoriesPage> Logger

<PageTitle>Polaroid Memories 📸🌸 | BestieSpace</PageTitle>

<div class="memories-page-container">
    <div class="page-header-card">
        <div class="header-content">
            <span class="header-icon">📸</span>
            <div>
                <h1>Our Polaroid Memories</h1>
                <p>Special moments we froze in time, pinned with cute washi tape and corner stickers ✨</p>
            </div>
        </div>

        <button class="btn-kawaii-primary" @onclick="() => showAddPhotoModal = true">
            <span>➕ Pin New Memory 📸</span>
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <span class="spinner">🌸</span>
            <p>Loading our photo memories...</p>
        </div>
    }
    else if (memories == null || !memories.Any())
    {
        <div class="empty-state-card">
            <span class="empty-icon">🧸📸</span>
            <h3>No memories pinned yet!</h3>
            <p>Upload your first photo together and pick a cute corner sticker to pin it to our gallery 🌸</p>
            <button class="btn-kawaii-primary mt-3" @onclick="() => showAddPhotoModal = true">
                <span>➕ Pin First Memory</span>
            </button>
        </div>
    }
    else
    {
        <div class="polaroid-grid">
            @foreach (var memory in memories)
            {
                var angle = memory.RotationAngle != 0 ? memory.RotationAngle : -1.5;
                var stickerEmoji = GetStickerEmoji(memory.StickerType);

                <div class="polaroid-frame" 
                     style="transform: rotate(@(angle)deg);"
                     @onclick="() => OpenLightbox(memory)">
                    <div class="polaroid-washi"></div>
                    <div class="polaroid-corner-sticker">@stickerEmoji</div>
                    <button type="button" class="btn-polaroid-edit" 
                            @onclick:stopPropagation="true" 
                            @onclick="() => OpenEditMemoryModal(memory)" 
                            title="Edit memory caption, date, sticker, or photo">
                        ✏️ Edit
                    </button>
                    <div class="polaroid-img-wrapper">
                        <img src="@GetFullMediaUrl(memory.ImageUrl)" alt="@memory.Caption" class="polaroid-img" loading="lazy" />
                    </div>
                    <div class="polaroid-caption">@memory.Caption</div>
                    <div class="polaroid-date">@memory.MemoryDate.ToString("MMMM dd, yyyy")</div>
                </div>
            }
        </div>
    }
</div>

<!-- =========================================================
     MODAL 1: ADD PHOTO MEMORY
     ========================================================= -->
@if (showAddPhotoModal)
{
    <div class="kawaii-modal-backdrop" @onclick="() => showAddPhotoModal = false">
        <div class="kawaii-modal-card" @onclick:stopPropagation="true">
            <button class="modal-close-btn" @onclick="() => showAddPhotoModal = false">✕</button>

            <div class="modal-header-icon">📸✨</div>
            <h2 class="modal-title">Pin a Polaroid Memory</h2>
            <p class="modal-subtitle">Upload a photo, pick a cute sticker, and write a sweet caption!</p>

            @if (!string.IsNullOrWhiteSpace(uploadErrorMessage))
            {
                <div class="form-error-banner">
                    <span>🥺 @uploadErrorMessage</span>
                </div>
            }

            <div class="form-group">
                <label class="form-label">Choose Photo *</label>
                <InputFile OnChange="HandleFileSelected" accept="image/*" class="form-control-kawaii" />
            </div>

            <div class="form-group">
                <label class="form-label">Heartfelt Caption *</label>
                <input type="text" class="form-control-kawaii" placeholder="e.g., That golden hour picnic with cookies 🍪" 
                       @bind="newPhotoCaption" maxlength="200" />
            </div>

            <div class="form-group">
                <label class="form-label">Memory Date</label>
                <input type="date" class="form-control-kawaii" @bind="newPhotoDate" />
            </div>

            <div class="form-group">
                <label class="form-label">Corner Sticker</label>
                <div class="sticker-select-group">
                    <div class="sticker-pill-radio @(newPhotoSticker == "bow" ? "selected" : "")" 
                         @onclick='@(() => newPhotoSticker = "bow")'>
                        <span>🎀</span> Bow
                    </div>
                    <div class="sticker-pill-radio @(newPhotoSticker == "bear" ? "selected" : "")" 
                         @onclick='@(() => newPhotoSticker = "bear")'>
                        <span>🧸</span> Bear
                    </div>
                    <div class="sticker-pill-radio @(newPhotoSticker == "sparkle" ? "selected" : "")" 
                         @onclick='@(() => newPhotoSticker = "sparkle")'>
                        <span>✨</span> Sparkle
                    </div>
                    <div class="sticker-pill-radio @(newPhotoSticker == "heart" ? "selected" : "")" 
                         @onclick='@(() => newPhotoSticker = "heart")'>
                        <span>💖</span> Heart
                    </div>
                    <div class="sticker-pill-radio @(newPhotoSticker == "flower" ? "selected" : "")" 
                         @onclick='@(() => newPhotoSticker = "flower")'>
                        <span>🌸</span> Flower
                    </div>
                </div>
            </div>

            <div style="text-align: right; margin-top: 24px;">
                <button class="btn-kawaii-primary" @onclick="SubmitNewMemory" disabled="@(isUploadingPhoto || string.IsNullOrWhiteSpace(newPhotoCaption))">
                    @if (isUploadingPhoto)
                    {
                        <span>Uploading... 🌸</span>
                    }
                    else
                    {
                        <span>Pin to Gallery 📌</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- =========================================================
     MODAL 2: EDIT PHOTO MEMORY
     ========================================================= -->
@if (showEditPhotoModal && editingMemory != null)
{
    <div class="kawaii-modal-backdrop" @onclick="() => showEditPhotoModal = false">
        <div class="kawaii-modal-card" @onclick:stopPropagation="true">
            <button class="modal-close-btn" @onclick="() => showEditPhotoModal = false">✕</button>

            <div class="modal-header-icon">✏️📸</div>
            <h2 class="modal-title">Edit Polaroid Memory</h2>
            <p class="modal-subtitle">Update caption, date, corner sticker, or replace the photo!</p>

            @if (!string.IsNullOrWhiteSpace(editErrorMessage))
            {
                <div class="form-error-banner">
                    <span>🥺 @editErrorMessage</span>
                </div>
            }

            <div class="edit-current-preview">
                <img src="@GetFullMediaUrl(editingMemory.ImageUrl)" alt="Current preview" class="preview-mini-polaroid" />
                <span class="preview-note">Current Photo</span>
            </div>

            <div class="form-group">
                <label class="form-label">Replace Photo (Optional)</label>
                <InputFile OnChange="HandleEditFileSelected" accept="image/*" class="form-control-kawaii" />
            </div>

            <div class="form-group">
                <label class="form-label">Heartfelt Caption *</label>
                <input type="text" class="form-control-kawaii" placeholder="e.g., That golden hour picnic with cookies 🍪" 
                       @bind="editCaption" maxlength="200" />
            </div>

            <div class="form-group">
                <label class="form-label">Memory Date</label>
                <input type="date" class="form-control-kawaii" @bind="editDate" />
            </div>

            <div class="form-group">
                <label class="form-label">Corner Sticker</label>
                <div class="sticker-select-group">
                    <div class="sticker-pill-radio @(editSticker == "bow" ? "selected" : "")" 
                         @onclick='@(() => editSticker = "bow")'>
                        <span>🎀</span> Bow
                    </div>
                    <div class="sticker-pill-radio @(editSticker == "bear" ? "selected" : "")" 
                         @onclick='@(() => editSticker = "bear")'>
                        <span>🧸</span> Bear
                    </div>
                    <div class="sticker-pill-radio @(editSticker == "sparkle" ? "selected" : "")" 
                         @onclick='@(() => editSticker = "sparkle")'>
                        <span>✨</span> Sparkle
                    </div>
                    <div class="sticker-pill-radio @(editSticker == "heart" ? "selected" : "")" 
                         @onclick='@(() => editSticker = "heart")'>
                        <span>💖</span> Heart
                    </div>
                    <div class="sticker-pill-radio @(editSticker == "flower" ? "selected" : "")" 
                         @onclick='@(() => editSticker = "flower")'>
                        <span>🌸</span> Flower
                    </div>
                </div>
            </div>

            <div class="modal-button-row">
                <button type="button" class="btn-delete-kawaii" @onclick="DeleteCurrentMemory" disabled="@isSavingEdit">
                    <span>🗑️ Delete Memory</span>
                </button>
                <div style="display: flex; gap: 8px;">
                    <button type="button" class="btn-kawaii-secondary" @onclick="() => showEditPhotoModal = false">
                        Cancel
                    </button>
                    <button type="button" class="btn-kawaii-primary" @onclick="SubmitEditMemory" disabled="@(isSavingEdit || string.IsNullOrWhiteSpace(editCaption))">
                        @if (isSavingEdit)
                        {
                            <span>Saving... 🌸</span>
                        }
                        else
                        {
                            <span>Save Changes ✨</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- =========================================================
     MODAL 3: PHOTO LIGHTBOX
     ========================================================= -->
@if (showLightboxModal && activeLightboxMemory != null)
{
    <div class="kawaii-modal-backdrop" @onclick="() => showLightboxModal = false">
        <div class="lightbox-card" @onclick:stopPropagation="true">
            <button class="modal-close-btn" style="top: 10px; right: 10px;" @onclick="() => showLightboxModal = false">✕</button>
            <img src="@GetFullMediaUrl(activeLightboxMemory.ImageUrl)" alt="@activeLightboxMemory.Caption" class="lightbox-img" />
            @if (!string.IsNullOrWhiteSpace(activeLightboxMemory.Caption))
            {
                <div class="lightbox-caption-box">@activeLightboxMemory.Caption</div>
            }
            <div class="lightbox-footer-actions">
                <span class="lightbox-date">📅 @activeLightboxMemory.MemoryDate.ToString("MMMM dd, yyyy")</span>
                <button type="button" class="btn-kawaii-secondary" @onclick="() => { showLightboxModal = false; OpenEditMemoryModal(activeLightboxMemory); }">
                    ✏️ Edit Memory
                </button>
            </div>
        </div>
    </div>
}

