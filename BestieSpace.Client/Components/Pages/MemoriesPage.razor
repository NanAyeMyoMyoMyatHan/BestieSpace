</style>

@code {
    private List<MemoryDto> memories = new();
    private bool isLoading = true;

    // Add Photo Modal
    private bool showAddPhotoModal = false;
    private bool isUploadingPhoto = false;
    private string newPhotoCaption = string.Empty;
    private DateTime newPhotoDate = DateTime.Today;
    private string newPhotoSticker = "bow";
    private IBrowserFile? selectedBrowserFile;
    private string? uploadErrorMessage;

    // Edit Photo Modal
    private bool showEditPhotoModal = false;
    private bool isSavingEdit = false;
    private MemoryDto? editingMemory;
    private string editCaption = string.Empty;
    private DateTime editDate = DateTime.Today;
    private string editSticker = "heart";
    private IBrowserFile? editBrowserFile;
    private string? editErrorMessage;

    // Lightbox
    private bool showLightboxModal = false;
    private MemoryDto? activeLightboxMemory;

    protected override async Task OnInitializedAsync()
    {
        await LoadMemoriesAsync();
    }

    private async Task LoadMemoriesAsync()
    {
        isLoading = true;
        try
        {
            var dash = await ApiClient.GetDashboardAsync();
            if (dash?.Memories != null)
            {
                memories = dash.Memories;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load memories");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedBrowserFile = e.File;
        uploadErrorMessage = null;
    }

    private async Task SubmitNewMemory()
    {
        if (string.IsNullOrWhiteSpace(newPhotoCaption)) return;
        isUploadingPhoto = true;
        uploadErrorMessage = null;

        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(newPhotoCaption), "caption");
            content.Add(new StringContent(newPhotoSticker), "stickerType");
            content.Add(new StringContent(newPhotoDate.ToString("o")), "memoryDate");

            if (selectedBrowserFile != null)
            {
                var streamContent = new StreamContent(selectedBrowserFile.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024));
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(selectedBrowserFile.ContentType);
                content.Add(streamContent, "photo", selectedBrowserFile.Name);
            }

            var created = await ApiClient.AddMemoryAsync(content);
            if (created != null)
            {
                memories.Insert(0, created);
                showAddPhotoModal = false;
                newPhotoCaption = string.Empty;
                selectedBrowserFile = null;
            }
            else
            {
                uploadErrorMessage = "Could not save photo memory. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to upload photo memory");
            uploadErrorMessage = ex.Message;
        }
        finally
        {
            isUploadingPhoto = false;
        }
    }

    private void OpenEditMemoryModal(MemoryDto memory)
    {
        editingMemory = memory;
        editCaption = memory.Caption;
        editDate = memory.MemoryDate;
        editSticker = string.IsNullOrWhiteSpace(memory.StickerType) ? "heart" : memory.StickerType.ToLowerInvariant();
        editBrowserFile = null;
        editErrorMessage = null;
        showEditPhotoModal = true;
    }

    private void HandleEditFileSelected(InputFileChangeEventArgs e)
    {
        editBrowserFile = e.File;
        editErrorMessage = null;
    }

    private async Task SubmitEditMemory()
    {
        if (editingMemory == null || string.IsNullOrWhiteSpace(editCaption)) return;
        isSavingEdit = true;
        editErrorMessage = null;

        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(editCaption), "caption");
            content.Add(new StringContent(editSticker), "stickerType");
            content.Add(new StringContent(editDate.ToString("o")), "memoryDate");

            if (editBrowserFile != null)
            {
                var streamContent = new StreamContent(editBrowserFile.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024));
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(editBrowserFile.ContentType);
                content.Add(streamContent, "photo", editBrowserFile.Name);
            }

            var updated = await ApiClient.UpdateMemoryAsync(editingMemory.Id, content);
            if (updated != null)
            {
                var index = memories.FindIndex(m => m.Id == updated.Id);
                if (index >= 0)
                {
                    memories[index] = updated;
                }
                showEditPhotoModal = false;
            }
            else
            {
                editErrorMessage = "Could not update memory. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update memory {Id}", editingMemory.Id);
            editErrorMessage = ex.Message;
        }
        finally
        {
            isSavingEdit = false;
        }
    }

    private async Task DeleteCurrentMemory()
    {
        if (editingMemory == null) return;
        isSavingEdit = true;
        editErrorMessage = null;

        try
        {
            var ok = await ApiClient.DeleteMemoryAsync(editingMemory.Id);
            if (ok)
            {
                memories.RemoveAll(m => m.Id == editingMemory.Id);
                showEditPhotoModal = false;
            }
            else
            {
                editErrorMessage = "Could not delete memory. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete memory {Id}", editingMemory.Id);
            editErrorMessage = ex.Message;
        }
        finally
        {
            isSavingEdit = false;
        }
    }

    private void OpenLightbox(MemoryDto memory)
    {
        activeLightboxMemory = memory;
        showLightboxModal = true;
    }

    private string GetFullMediaUrl(string? relativeOrFull)
    {
        if (string.IsNullOrWhiteSpace(relativeOrFull)) return "/images/sample-memories/picnic-day.svg";
        if (relativeOrFull.StartsWith("http://") || relativeOrFull.StartsWith("https://")) return relativeOrFull;
        return relativeOrFull;
    }

    private static string GetStickerEmoji(string? stickerType) => stickerType?.ToLowerInvariant() switch
    {
        "bow" => "🎀",
        "bear" => "🧸",
        "sparkle" => "✨",
        "heart" => "💖",
        "flower" => "🌸",
        _ => "🌸"
    };
}
