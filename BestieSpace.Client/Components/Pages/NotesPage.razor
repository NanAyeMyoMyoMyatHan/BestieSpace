}

.btn-modal-save:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(251, 111, 146, 0.45);
}

.btn-modal-delete {
    background: #FFF0F5;
    border: 1.5px solid #FF8FAB;
    color: #D81159;
    font-weight: 700;
    padding: 12px 20px;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 0.95rem;
}

.btn-modal-delete:hover {
    background: #FFE5EC;
    transform: translateY(-2px);
}
</style>

@code {
    private List<SecretNoteDto>? secretNotes;
    private bool isLoading = true;

    // Reading Modal
    private bool showSecretNoteModal = false;
    private SecretNoteDto? activeSecretNote;

    // Editor Modal (Add / Edit)
    private bool showNoteEditorModal = false;
    private bool isEditingExisting = false;
    private int? editingNoteId = null;
    private string editorTitle = "";
    private string editorPreviewHint = "";
    private string editorContent = "";
    private string editorStickerIcon = "💌";
    private bool editorIsSealed = false;
    private string? editorErrorMessage;
    private bool isSavingNote = false;

    private readonly string[] availableStickers = { "💌", "🎀", "🧸", "✨", "💖", "🌸", "🌟", "🍰", "🐱", "🗝️" };

    protected override async Task OnInitializedAsync()
    {
        await LoadNotesAsync();
    }

    private async Task LoadNotesAsync()
    {
        isLoading = true;
        try
        {
            secretNotes = await ApiClient.GetAllNotesAsync();
            if (secretNotes == null || !secretNotes.Any())
            {
                var dashboard = await ApiClient.GetDashboardAsync();
                secretNotes = dashboard?.SecretNotes ?? new List<SecretNoteDto>();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load secret notes");
            secretNotes = new List<SecretNoteDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleEnvelopeClick(SecretNoteDto note)
    {
        activeSecretNote = note;
        showSecretNoteModal = true;

        if (!note.IsUnlocked)
        {
            note.IsUnlocked = true;
            try
            {
                var updated = await ApiClient.UnlockNoteAsync(note.Id);
                if (updated != null)
                {
                    note.Content = updated.Content;
                    note.UnlockedAt = updated.UnlockedAt;
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to unlock note ID {Id}", note.Id);
            }
        }
    }

    private void OpenCreateNoteModal()
    {
        isEditingExisting = false;
        editingNoteId = null;
        editorTitle = "";
        editorPreviewHint = "";
        editorContent = "";
        editorStickerIcon = "💌";
        editorIsSealed = true;
        editorErrorMessage = null;
        showNoteEditorModal = true;
    }

    private void OpenEditNoteModal(SecretNoteDto note)
    {
        isEditingExisting = true;
        editingNoteId = note.Id;
        editorTitle = note.Title;
        editorPreviewHint = note.PreviewHint;
        editorContent = note.Content ?? "";
        editorStickerIcon = string.IsNullOrWhiteSpace(note.StickerIcon) ? "💌" : note.StickerIcon;
        editorIsSealed = !note.IsUnlocked;
        editorErrorMessage = null;
        showNoteEditorModal = true;
    }

    private void SwitchToEditNote(SecretNoteDto note)
    {
        showSecretNoteModal = false;
        OpenEditNoteModal(note);
    }

    private async Task SaveNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(editorTitle) || string.IsNullOrWhiteSpace(editorContent))
        {
            editorErrorMessage = "Please fill in both the note title and heartfelt letter content! 🌸";
            return;
        }

        isSavingNote = true;
        editorErrorMessage = null;

        try
        {
            if (isEditingExisting && editingNoteId.HasValue)
            {
                var req = new UpdateSecretNoteRequest
                {
                    Title = editorTitle.Trim(),
                    PreviewHint = string.IsNullOrWhiteSpace(editorPreviewHint) ? "Tap to break the seal and read 💕" : editorPreviewHint.Trim(),
                    Content = editorContent.Trim(),
                    StickerIcon = editorStickerIcon,
                    IsUnlocked = !editorIsSealed
                };

                var updated = await ApiClient.UpdateNoteAsync(editingNoteId.Value, req);
                if (updated != null)
                {
                    var idx = secretNotes?.FindIndex(n => n.Id == updated.Id) ?? -1;
                    if (idx >= 0 && secretNotes != null)
                    {
                        secretNotes[idx] = updated;
                    }
                    if (activeSecretNote?.Id == updated.Id)
                    {
                        activeSecretNote = updated;
                    }
                    showNoteEditorModal = false;
                    await JSRuntime.InvokeVoidAsync("bestieAnimations.playCutePopSound");
                }
                else
                {
                    editorErrorMessage = "Could not update the note. Please try again.";
                }
            }
            else
            {
                var req = new CreateSecretNoteRequest
                {
                    Title = editorTitle.Trim(),
                    PreviewHint = string.IsNullOrWhiteSpace(editorPreviewHint) ? "Tap to break the seal and read 💕" : editorPreviewHint.Trim(),
                    Content = editorContent.Trim(),
                    StickerIcon = editorStickerIcon
                };

                var created = await ApiClient.CreateNoteAsync(req);
                if (created != null)
                {
                    secretNotes?.Insert(0, created);
                    showNoteEditorModal = false;
                    await JSRuntime.InvokeVoidAsync("bestieAnimations.playCutePopSound");
                    await JSRuntime.InvokeVoidAsync("bestieAnimations.triggerConfettiBurst");
                }
                else
                {
                    editorErrorMessage = "Could not create the secret note. Please try again.";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save secret note");
            editorErrorMessage = ex.Message;
        }
        finally
        {
            isSavingNote = false;
        }
    }

    private async Task DeleteCurrentNoteAsync()
    {
        if (!editingNoteId.HasValue) return;

        isSavingNote = true;
        try
        {
            var success = await ApiClient.DeleteNoteAsync(editingNoteId.Value);
            if (success)
            {
                secretNotes?.RemoveAll(n => n.Id == editingNoteId.Value);
                showNoteEditorModal = false;
                showSecretNoteModal = false;
            }
            else
            {
                editorErrorMessage = "Could not delete the note. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete secret note");
            editorErrorMessage = ex.Message;
        }
        finally
        {
            isSavingNote = false;
        }
    }
}
