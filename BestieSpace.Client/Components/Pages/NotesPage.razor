    height: 68px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 16px rgba(255, 143, 171, 0.25);
    border: 2px solid #FFC2D1;
}

.page-header-card h1 {
    color: #4A3B3C;
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 4px;
}

.page-header-card p {
    color: #7E6566;
    font-size: 1rem;
