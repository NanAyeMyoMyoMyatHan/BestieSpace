@page "/notes"
@rendermode InteractiveServer

@using BestieSpace.Client.Services
@using BestieSpace.Shared.DTOs
@inject IBestieApiClient ApiClient
@inject NavigationManager Nav
@inject ILogger<NotesPage> Logger

<PageTitle>Secret Notes & Envelopes ✉️🌸 | BestieSpace</PageTitle>

<div class="notes-page-container">
    <div class="page-header-card">
        <div class="header-content">
            <span class="header-icon">✉️</span>
            <div>
                <h1>Mystery Envelopes & Secret Notes</h1>
                <p>Click on any envelope to break its wax seal and uncover a heartfelt handwritten message 💕</p>
            </div>
        </div>
        <div class="header-stats-badge">
            <span>💌 @(secretNotes?.Count(n => n.IsUnlocked) ?? 0) of @(secretNotes?.Count ?? 0) Opened</span>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <span class="spinner">🌸</span>
            <p>Gathering your secret envelopes...</p>
        </div>
    }
    else if (secretNotes == null || !secretNotes.Any())
    {
        <div class="empty-state-card">
            <span class="empty-icon">📬🌸</span>
            <h3>No secret envelopes found!</h3>
            <p>Heartfelt notes and surprise letters from your bestie will appear here once they're written ✨</p>
        </div>
    }
    else
    {
        <div class="envelopes-grid">
            @foreach (var note in secretNotes)
            {
                <div class="envelope-card @(note.IsUnlocked ? "unlocked-envelope" : "sealed-envelope")"
                     @onclick="() => HandleEnvelopeClick(note)">
                    <div class="envelope-stamp">POSTAGE 🌸</div>
                    <div class="envelope-icon-circle">
                        <span>@(note.IsUnlocked ? "📖" : (string.IsNullOrWhiteSpace(note.StickerIcon) ? "💌" : note.StickerIcon))</span>
                    </div>
                    <h3 class="envelope-title">@note.Title</h3>
                    <p class="envelope-hint">@note.PreviewHint</p>

                    @if (note.IsUnlocked)
                    {
                        <span class="envelope-status-badge status-unlocked">
                            <span>✨ Opened • Tap to Read</span>
                        </span>
                    }
                    else
                    {
                        <span class="envelope-status-badge status-sealed">
                            <span>🎀 Sealed • Tap to Break Seal</span>
                        </span>
                    }
                </div>
            }
        </div>
    }
</div>

<!-- =========================================================
     MODAL: SECRET NOTE STATIONERY
     ========================================================= -->
@if (showSecretNoteModal && activeSecretNote != null)
{
    <div class="kawaii-modal-backdrop" @onclick="() => showSecretNoteModal = false">
        <div class="kawaii-modal-card note-modal-card" @onclick:stopPropagation="true">
            <div class="washi-tape-top"></div>
            <button class="modal-close-btn" @onclick="() => showSecretNoteModal = false">✕</button>

            <div class="modal-header-icon">@(string.IsNullOrWhiteSpace(activeSecretNote.StickerIcon) ? "💌" : activeSecretNote.StickerIcon)</div>
            <h2 class="modal-title">@activeSecretNote.Title</h2>
            <p class="modal-subtitle">@activeSecretNote.PreviewHint</p>

            <div class="secret-note-paper">
                <div class="secret-note-text">
                    @activeSecretNote.Content
                </div>
            </div>

            @if (activeSecretNote.UnlockedAt.HasValue)
            {
                <div class="note-unlocked-tag">
                    <span>✨ Opened on @activeSecretNote.UnlockedAt.Value.ToString("MMMM dd, yyyy h:mm tt")</span>
                </div>
            }

            <div class="note-footer-note">
                <span>🌸 Sealed with love • Forever your bestie 💕</span>
            </div>
        </div>
    </div>
}

<style>
.notes-page-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 20px 80px 20px;
    font-family: 'Fredoka', 'Quicksand', sans-serif;
}

.page-header-card {
    background: linear-gradient(135deg, #FFFDF9 0%, #FFE5EC 100%);
    border: 3px solid #FFC2D1;
    border-radius: 28px;
    padding: 28px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    box-shadow: 0 10px 30px rgba(255, 143, 171, 0.2);
    margin-bottom: 36px;
}

.header-content {
    display: flex;
    align-items: center;
    gap: 20px;
}

.header-icon {
    font-size: 3rem;
    background: #FFF;
    border-radius: 50%;
    width: 68px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 16px rgba(255, 143, 171, 0.25);
    border: 2px solid #FFC2D1;
}

.page-header-card h1 {
    color: #4A3B3C;
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 4px;
}

.page-header-card p {
    color: #7E6566;
    font-size: 1rem;
    margin: 0;
}

.header-stats-badge {
    background: #FFFFFF;
    color: #FB6F92;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 9999px;
    border: 2px dashed #FFC2D1;
    box-shadow: 0 4px 12px rgba(251, 111, 146, 0.15);
    font-size: 0.95rem;
}

.loading-state {
    text-align: center;
    padding: 60px 20px;
    color: #7E6566;
    font-size: 1.1rem;
}

.loading-state .spinner {
    font-size: 2.5rem;
    display: inline-block;
    animation: spinSlow 3s linear infinite;
    margin-bottom: 12px;
}

@@keyframes spinSlow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.empty-state-card {
    background: #FFFFFF;
    border: 3px dashed #FFC2D1;
    border-radius: 28px;
    padding: 60px 24px;
    text-align: center;
    max-width: 500px;
    margin: 40px auto;
}

.empty-icon {
    font-size: 3.5rem;
    display: block;
    margin-bottom: 12px;
}

.empty-state-card h3 {
    color: #4A3B3C;
    font-weight: 700;
    font-size: 1.4rem;
    margin-bottom: 8px;
}

.empty-state-card p {
    color: #7E6566;
    font-size: 0.95rem;
    line-height: 1.5;
}

/* Envelopes Grid */
.envelopes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 28px;
}

.envelope-card {
    background: linear-gradient(135deg, #FFFFFF 0%, #FFF5F7 100%);
    border: 3px solid #FFC2D1;
    border-radius: 24px;
    padding: 28px 24px 22px 24px;
    text-align: center;
    position: relative;
    box-shadow: 0 10px 24px rgba(255, 143, 171, 0.18);
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
    overflow: hidden;
}

.envelope-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 16px 36px rgba(251, 111, 146, 0.28);
    border-color: #FB6F92;
}

.envelope-card.unlocked-envelope {
    background: linear-gradient(135deg, #FFFDF9 0%, #FFF0F5 100%);
    border-color: #E2F0CB;
}

.envelope-stamp {
    position: absolute;
    top: 12px;
    right: 14px;
    font-size: 0.65rem;
    font-weight: 800;
    color: #FB6F92;
    border: 1.5px dashed #FF8FAB;
    padding: 3px 6px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    transform: rotate(3deg);
}

.envelope-icon-circle {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: #FFF;
    border: 2px solid #FFC2D1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin: 0 auto 16px auto;
    box-shadow: 0 6px 14px rgba(255, 143, 171, 0.2);
    transition: transform 0.3s ease;
}

.envelope-card:hover .envelope-icon-circle {
    transform: scale(1.12) rotate(6deg);
}

.envelope-title {
    color: #4A3B3C;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 8px;
}

.envelope-hint {
    color: #7E6566;
    font-size: 0.92rem;
    line-height: 1.45;
    margin-bottom: 18px;
    min-height: 40px;
}

.envelope-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 6px 16px;
    border-radius: 9999px;
    letter-spacing: 0.2px;
}

.status-sealed {
    background: linear-gradient(135deg, #FF8FAB 0%, #FB6F92 100%);
    color: #FFFFFF;
    box-shadow: 0 4px 12px rgba(251, 111, 146, 0.35);
}

.status-unlocked {
    background: #E2F0CB;
    color: #4A6B2C;
    border: 1px solid #C5E1A5;
}

/* Modal */
.kawaii-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(74, 59, 60, 0.5);
    backdrop-filter: blur(5px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 20px;
}

.kawaii-modal-card.note-modal-card {
    background: #FFFDF9;
    border: 4px solid #FFC2D1;
    border-radius: 32px;
    padding: 36px 32px 28px 32px;
    max-width: 580px;
    width: 100%;
    position: relative;
    box-shadow: 0 24px 60px rgba(74, 59, 60, 0.3);
    text-align: center;
    animation: modalBounce 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@@keyframes modalBounce {
    from { transform: scale(0.85); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}

.washi-tape-top {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%) rotate(-1deg);
    width: 140px;
    height: 28px;
    background: rgba(255, 182, 193, 0.75);
    border: 1px dashed rgba(251, 111, 146, 0.5);
    border-radius: 4px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

.modal-close-btn {
    position: absolute;
    top: 16px;
    right: 20px;
    background: #FFF0F5;
    border: 2px solid #FFC2D1;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 1.1rem;
    font-weight: 700;
    color: #FB6F92;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s, background-color 0.2s;
}

.modal-close-btn:hover {
    transform: rotate(90deg) scale(1.1);
    background: #FB6F92;
    color: #FFF;
}

.modal-header-icon {
    font-size: 2.8rem;
    margin-bottom: 8px;
}

.modal-title {
    color: #4A3B3C;
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 4px;
}

.modal-subtitle {
    color: #7E6566;
    font-size: 0.95rem;
    margin-bottom: 20px;
}

.secret-note-paper {
    background: #FFFDF9;
    background-image: repeating-linear-gradient(transparent, transparent 27px, #FFDEE7 28px);
    border: 2px solid #FFD1DC;
    border-radius: 16px;
    padding: 24px 28px;
    text-align: left;
    margin-bottom: 20px;
    min-height: 160px;
    max-height: 380px;
    overflow-y: auto;
    box-shadow: inset 0 2px 6px rgba(0,0,0,0.03);
}

.secret-note-text {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.1rem;
    line-height: 28px;
    color: #4A3B3C;
    white-space: pre-wrap;
    word-break: break-word;
}

.note-unlocked-tag {
    font-size: 0.85rem;
    color: #7E6566;
    margin-bottom: 12px;
}

.note-footer-note {
    font-size: 0.92rem;
    color: #FB6F92;
    font-weight: 600;
}
</style>

@code {
    private List<SecretNoteDto>? secretNotes;
    private bool isLoading = true;
    private bool showSecretNoteModal = false;
    private SecretNoteDto? activeSecretNote;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotesAsync();
    }

    private async Task LoadNotesAsync()
    {
        isLoading = true;
        try
        {
            var dashboard = await ApiClient.GetDashboardAsync();
            secretNotes = dashboard?.SecretNotes ?? new List<SecretNoteDto>();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load secret notes");
            secretNotes = new List<SecretNoteDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleEnvelopeClick(SecretNoteDto note)
    {
        activeSecretNote = note;
        showSecretNoteModal = true;

        if (!note.IsUnlocked)
        {
            note.IsUnlocked = true;
            try
            {
                var updated = await ApiClient.UnlockNoteAsync(note.Id);
                if (updated != null)
                {
                    note.Content = updated.Content;
                    note.UnlockedAt = updated.UnlockedAt;
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to unlock note ID {Id}", note.Id);
            }
        }
    }
}
