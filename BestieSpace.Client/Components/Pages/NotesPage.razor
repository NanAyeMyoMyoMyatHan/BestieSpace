    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 20px;
}

.kawaii-modal-card.note-modal-card {
    background: #FFFDF9;
    border: 4px solid #FFC2D1;
    border-radius: 32px;
    padding: 36px 32px 28px 32px;
    max-width: 580px;
    width: 100%;
