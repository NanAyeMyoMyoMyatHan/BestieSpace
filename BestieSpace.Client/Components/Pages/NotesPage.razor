@page "/notes"
@rendermode InteractiveServer

@using BestieSpace.Client.Services
@using BestieSpace.Shared.DTOs
@inject IBestieApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject ILogger<NotesPage> Logger

<PageTitle>Secret Notes & Envelopes ✉️🌸 | BestieSpace</PageTitle>

<div class="notes-page-container">
    <div class="page-header-card">
        <div class="header-content">
            <span class="header-icon">✉️</span>
            <div>
                <h1>Mystery Envelopes & Secret Notes</h1>
                <p>Click on any envelope to break its wax seal and uncover a heartfelt handwritten message 💕</p>
            </div>
        </div>
        <div class="header-right-actions">
            <div class="header-stats-badge">
                <span>💌 @(secretNotes?.Count(n => n.IsUnlocked) ?? 0) of @(secretNotes?.Count ?? 0) Opened</span>
            </div>
            <button class="btn-kawaii-primary" @onclick="OpenCreateNoteModal">
                <span>➕ Write New Note ✉️</span>
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <span class="spinner">🌸</span>
            <p>Gathering your secret envelopes...</p>
        </div>
    }
    else if (secretNotes == null || !secretNotes.Any())
    {
        <div class="empty-state-card">
            <span class="empty-icon">📬🌸</span>
            <h3>No secret envelopes found!</h3>
            <p>Write your first heartfelt letter or surprise note to your bestie ✨</p>
            <button class="btn-kawaii-primary mt-3" @onclick="OpenCreateNoteModal">
                <span>➕ Write First Secret Note</span>
            </button>
        </div>
    }
    else
    {
        <div class="envelopes-grid">
            @foreach (var note in secretNotes)
            {
                <div class="envelope-card @(note.IsUnlocked ? "unlocked-envelope" : "sealed-envelope")"
                     @onclick="() => HandleEnvelopeClick(note)">
                    <div class="envelope-stamp">POSTAGE 🌸</div>
                    
                    <button type="button" class="btn-card-edit-note" @onclick:stopPropagation="true" @onclick="() => OpenEditNoteModal(note)" title="Edit this secret note">
                        ✏️ Edit
                    </button>

                    <div class="envelope-icon-circle">
                        <span>@(note.IsUnlocked ? "📖" : (string.IsNullOrWhiteSpace(note.StickerIcon) ? "💌" : note.StickerIcon))</span>
                    </div>
                    <h3 class="envelope-title">@note.Title</h3>
                    <p class="envelope-hint">@note.PreviewHint</p>

                    @if (note.IsUnlocked)
                    {
                        <span class="envelope-status-badge status-unlocked">
                            <span>✨ Opened • Tap to Read</span>
                        </span>
                    }
                    else
                    {
                        <span class="envelope-status-badge status-sealed">
                            <span>🎀 Sealed • Tap to Break Seal</span>
                        </span>
                    }
                </div>
            }
        </div>
    }
</div>

<!-- =========================================================
     MODAL 1: READ SECRET NOTE STATIONERY
     ========================================================= -->
@if (showSecretNoteModal && activeSecretNote != null)
{
    <div class="kawaii-modal-backdrop" @onclick="() => showSecretNoteModal = false">
        <div class="kawaii-modal-card note-modal-card" @onclick:stopPropagation="true">
            <div class="washi-tape-top"></div>
            <button class="modal-close-btn" @onclick="() => showSecretNoteModal = false">✕</button>

            <div class="modal-header-icon">@(string.IsNullOrWhiteSpace(activeSecretNote.StickerIcon) ? "💌" : activeSecretNote.StickerIcon)</div>
            <h2 class="modal-title">@activeSecretNote.Title</h2>
            <p class="modal-subtitle">@activeSecretNote.PreviewHint</p>

            <div class="secret-note-paper">
                <div class="secret-note-text">
                    @activeSecretNote.Content
                </div>
            </div>

            @if (activeSecretNote.UnlockedAt.HasValue)
            {
                <div class="note-unlocked-tag">
                    <span>✨ Opened on @activeSecretNote.UnlockedAt.Value.ToString("MMMM dd, yyyy h:mm tt")</span>
                </div>
            }

            <div class="note-modal-bottom-actions">
                <button type="button" class="btn-modal-edit" @onclick="() => SwitchToEditNote(activeSecretNote)">
                    <span>✏️ Edit This Note</span>
                </button>
            </div>

            <div class="note-footer-note">
                <span>🌸 Sealed with love • Forever your bestie 💕</span>
            </div>
        </div>
    </div>
}

<!-- =========================================================
     MODAL 2: CREATE / EDIT SECRET NOTE
     ========================================================= -->
@if (showNoteEditorModal)
{
    <div class="kawaii-modal-backdrop" @onclick="() => showNoteEditorModal = false">
        <div class="kawaii-modal-card note-modal-card editor-modal-card" @onclick:stopPropagation="true">
            <div class="washi-tape-top"></div>
            <button class="modal-close-btn" @onclick="() => showNoteEditorModal = false">✕</button>

            <div class="modal-header-icon">@(string.IsNullOrWhiteSpace(editorStickerIcon) ? "💌" : editorStickerIcon)</div>
            <h2 class="modal-title">@(isEditingExisting ? "Edit Secret Note" : "Write a New Secret Note")</h2>
            <p class="modal-subtitle">@(isEditingExisting ? "Update the title, preview hint, wax seal, or heartfelt letter text." : "Craft a heartfelt mystery letter for your bestie to open!")</p>

            @if (!string.IsNullOrWhiteSpace(editorErrorMessage))
            {
                <div class="form-error-banner">
                    <span>🥺 @editorErrorMessage</span>
                </div>
            }

            <div class="form-group">
                <label class="form-label">Envelope Title *</label>
                <input type="text" class="form-control-kawaii" placeholder="e.g., Open when you miss me 💕" 
                       @bind="editorTitle" maxlength="100" />
            </div>

            <div class="form-group">
                <label class="form-label">Preview Hint on Envelope *</label>
                <input type="text" class="form-control-kawaii" placeholder="e.g., A warm, gentle reminder when you feel a little lonely..." 
                       @bind="editorPreviewHint" maxlength="250" />
            </div>

            <div class="form-group">
                <label class="form-label">Choose Wax Seal Sticker</label>
                <div class="sticker-select-group">
                    @foreach (var s in availableStickers)
                    {
                        <button type="button" class="sticker-pill-radio @(editorStickerIcon == s ? "selected" : "")" 
                                @onclick="@(() => editorStickerIcon = s)">
                            <span>@s</span>
                        </button>
                    }
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Secret Handwritten Letter Content *</label>
                <textarea class="form-control-kawaii stationery-textarea" rows="6" 
                          placeholder="Write your heartfelt letter here... Tell your bestie how much they mean to you 💕" 
                          @bind="editorContent"></textarea>
            </div>

            @if (isEditingExisting)
            {
                <div class="form-group form-check-kawaii">
                    <label class="checkbox-container">
                        <input type="checkbox" @bind="editorIsSealed" />
                        <span class="checkmark"></span>
                        <span class="check-label">🎀 Re-seal this envelope (lock it so it can be broken open again)</span>
                    </label>
                </div>
            }

            <div class="modal-form-actions">
                @if (isEditingExisting)
                {
                    <button type="button" class="btn-modal-delete" @onclick="DeleteCurrentNoteAsync" disabled="@isSavingNote">
                        <span>🗑️ Delete Note</span>
                    </button>
                }
                <button type="button" class="btn-modal-save" @onclick="SaveNoteAsync" disabled="@isSavingNote">
                    @if (isSavingNote)
                    {
                        <span>🌸 Saving note...</span>
                    }
                    else
                    {
                        <span>@(isEditingExisting ? "Save Changes 🌸" : "Seal & Pin Envelope ✉️✨")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
.notes-page-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 20px 80px 20px;
