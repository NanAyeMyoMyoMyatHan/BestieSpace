@page "/circles"
@page "/circles/{CircleId:int}"
@rendermode InteractiveServer

@using System.Security.Claims
@using BestieSpace.Shared.DTOs
@using BestieSpace.Client.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IBestieApiClient ApiClient
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject ILogger<CirclesHub> Logger

<PageTitle>Bestie Circles 👑🌸 - BestieSpace</PageTitle>

<div class="circles-page">
    <!-- HERO HEADER -->
    <header class="circles-header">
        <div class="header-badge">👑 Private Bestie Circles</div>
        <h1>Your Friendship Circles & Groups</h1>
        <p class="subtitle">
            Gather your closest besties into private circles of up to 9 members! Share exclusive memories, roster updates, and real-time private group chats.
        </p>
        <div class="header-actions">
            <button class="btn-create-circle" @onclick="OpenCreateCircleModal">
                <span>➕</span> Create New Circle
            </button>
            <button class="btn-invites-tab @(activeTab == "invitations" ? "active" : "")" @onclick="@(() => activeTab = "invitations")">
                <span>💌</span> Pending Invitations
                @if (incomingInvitations.Count > 0)
                {
                    <span class="invite-badge">@incomingInvitations.Count</span>
                }
            </button>
            <button class="btn-invites-tab @(activeTab == "circles" ? "active" : "")" @onclick="@(() => activeTab = "circles")">
                <span>🌸</span> My Circles (@myCircles.Count)
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(statusFeedback))
    {
        <div class="status-banner @(feedbackIsError ? "error" : "success")">
            <span>@(feedbackIsError ? "⚠️" : "🌸") @statusFeedback</span>
            <button class="btn-close-banner" @onclick="@(() => statusFeedback = null)">✕</button>
        </div>
    }

    <!-- TAB 1: INVITATIONS -->
    @if (activeTab == "invitations")
    {
        <section class="circles-section">
            <div class="section-title-row">
                <h2>💌 Incoming Circle Invitations</h2>
                <button class="btn-link-sm" @onclick="LoadIncomingInvitationsAsync">🔄 Refresh</button>
            </div>

            @if (isLoadingInvites)
            {
                <div class="loading-state">🌸 Loading invitations...</div>
            }
            else if (incomingInvitations.Count == 0)
            {
                <div class="empty-state-card">
                    <div class="empty-icon">📬</div>
                    <h3>No pending circle invitations!</h3>
                    <p>When friends invite you into their private Bestie Circle, their cute invitations will appear here.</p>
                </div>
            }
            else
            {
                <div class="invitations-grid">
                    @foreach (var inv in incomingInvitations)
                    {
                        <div class="invitation-card">
                            <div class="inv-card-header">
                                <span class="inv-icon">@(string.IsNullOrWhiteSpace(inv.CircleIcon) ? "🌸" : inv.CircleIcon)</span>
                                <div>
                                    <h4 class="inv-circle-name">@inv.CircleName</h4>
                                    <span class="inv-invited-by">Invited by <strong>@inv.InvitedByDisplayName</strong></span>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(inv.CircleDescription))
                            {
                                <p class="inv-desc">@inv.CircleDescription</p>
                            }
                            <div class="inv-meta">
                                <span>Sent @inv.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                            </div>
                            <div class="inv-actions">
                                <button class="btn-accept-inv" @onclick="@(() => AcceptInvitationAsync(inv.InvitationId))">
                                    🌸 Accept & Join
                                </button>
                                <button class="btn-decline-inv" @onclick="@(() => DeclineInvitationAsync(inv.InvitationId))">
                                    ✕ Decline
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }

    <!-- TAB 2: MY CIRCLES -->
    @if (activeTab == "circles")
    {
        <section class="circles-section">
            <div class="section-title-row">
                <h2>👑 My Bestie Circles (@myCircles.Count)</h2>
                <button class="btn-link-sm" @onclick="LoadMyCirclesAsync">🔄 Refresh</button>
            </div>

            @if (isLoadingCircles)
            {
                <div class="loading-state">🌸 Gathering your circles...</div>
            }
            else if (myCircles.Count == 0)
            {
                <div class="empty-state-card">
                    <div class="empty-icon">🧸✨</div>
                    <h3>You haven't joined any Bestie Circles yet</h3>
                    <p>Create your very own secret circle and invite your besties, or check pending invitations!</p>
                    <button class="btn-create-circle mt-3" @onclick="OpenCreateCircleModal">
                        <span>➕</span> Create Your First Circle
                    </button>
                </div>
            }
            else
            {
                <div class="circles-grid">
                    @foreach (var c in myCircles)
                    {
                        <div class="circle-card">
                            <div class="circle-card-top">
                                <div class="circle-icon-badge">
                                    <span>@(string.IsNullOrWhiteSpace(c.CircleIcon) ? "🌸" : c.CircleIcon)</span>
                                </div>
                                <div class="circle-card-title-group">
                                    <h3 class="circle-card-name">@c.CircleName</h3>
                                    <div class="circle-badge-row">
                                        <span class="circle-role-badge">@c.MyRoleName</span>
                                        <span class="circle-capacity-badge">@c.MemberCount / 9 Besties</span>
                                    </div>
                                </div>
                            </div>

                            <p class="circle-card-desc">
                                @(string.IsNullOrWhiteSpace(c.Description) ? "A private cozy sanctuary for best friends." : c.Description)
                            </p>

                            <div class="circle-card-footer">
                                <button class="btn-card-chat" @onclick="@(() => OpenCircleChat(c.CircleId))">
                                    💬 Open Chat
                                </button>
                                <button class="btn-card-manage" @onclick="@(() => OpenCircleDetailsModal(c.CircleId))">
                                    ⚙️ Manage
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }

    <!-- MODAL 1: CREATE CIRCLE -->
    @if (showCreateModal)
    {
        <div class="modal-backdrop" @onclick="CloseCreateCircleModal">
            <div class="modal-card" @onclick:stopPropagation>
                <div class="modal-header">
                    <h3>➕ Create a Bestie Circle</h3>
                    <button class="btn-modal-close" @onclick="CloseCreateCircleModal">✕</button>
                </div>

                <div class="modal-body">
                    <div class="form-group">
                        <label>Circle Icon Sticker</label>
                        <div class="icon-picker-row">
                            @foreach (var icon in stickerChoices)
                            {
                                <button type="button" 
                                        class="icon-picker-btn @(newCircleModel.CircleIcon == icon ? "selected" : "")"
                                        @onclick="@(() => newCircleModel.CircleIcon = icon)">
                                    @icon
                                </button>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Circle Name *</label>
                        <input type="text" class="input-text" placeholder="e.g. The Pinky Promise Squad 🌸" 
                               @bind="newCircleModel.CircleName" maxlength="100" />
                    </div>

                    <div class="form-group">
                        <label>Description (Optional)</label>
                        <textarea class="input-textarea" placeholder="What is this cute club about?" 
                                  @bind="newCircleModel.Description" maxlength="500" rows="3"></textarea>
                    </div>

                    <p class="limit-note">
                        💡 <strong>Note:</strong> You will become the Circle Owner. Circles have a maximum of 9 members total to keep things intimate and cozy!
                    </p>
                </div>

                <div class="modal-footer">
                    <button class="btn-secondary" @onclick="CloseCreateCircleModal">Cancel</button>
                    <button class="btn-primary" disabled="@(isSubmittingCreate || string.IsNullOrWhiteSpace(newCircleModel.CircleName))" @onclick="CreateCircleAsync">
                        @if (isSubmittingCreate)
                        {
                            <span>🌸 Creating...</span>
                        }
                        else
                        {
                            <span>🌸 Create Circle</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- MODAL 2: CIRCLE DETAILS & ROSTER -->
    @if (showDetailsModal && selectedCircle != null)
    {
        <div class="modal-backdrop" @onclick="CloseCircleDetailsModal">
            <div class="modal-card wide" @onclick:stopPropagation>
                <div class="modal-header">
                    <div class="modal-title-with-icon">
                        <span class="title-icon">@(selectedCircle.CircleIcon ?? "🌸")</span>
                        <div>
                            <h3>@selectedCircle.CircleName</h3>
                            <span class="modal-subtitle">@selectedCircleMembers.Count / 9 Members • Created @selectedCircle.CreatedAt.ToString("MMM d, yyyy")</span>
                        </div>
                    </div>
                    <button class="btn-modal-close" @onclick="CloseCircleDetailsModal">✕</button>
                </div>

                <div class="modal-body">
                    <!-- Actions top bar -->
                    <div class="details-top-actions">
                        <button class="btn-action-chat" @onclick="@(() => OpenCircleChat(selectedCircle.CircleId))">
                            💬 Enter Real-Time Chat Room
                        </button>

                        @if (canInviteToSelectedCircle)
                        {
                            <button class="btn-action-invite" disabled="@(selectedCircleMembers.Count >= 9)" @onclick="OpenInviteFriendsModal">
                                @if (selectedCircleMembers.Count >= 9)
                                {
                                    <span>🔒 Circle Full (9/9)</span>
                                }
                                else
                                {
                                    <span>💌 Invite Friends (@(9 - selectedCircleMembers.Count) spots left)</span>
                                }
                            </button>
                        }
                    </div>

                    <!-- Member roster list -->
                    <h4 class="roster-heading">👑 Member Roster</h4>
                    <div class="member-roster-table">
                        @foreach (var member in selectedCircleMembers)
                        {
                            var isMe = member.UserId == currentUserId;
                            var isThisMemberOwner = member.RoleName == "CircleOwner" || member.RoleName == "Owner";

                            <div class="member-row">
                                <div class="member-left">
                                    <span class="member-avatar">@(member.UserAvatarSticker ?? "🌸")</span>
                                    <div>
                                        <div class="member-name-row">
                                            <strong>@member.UserDisplayName</strong>
                                            @if (isMe)
                                            {
                                                <span class="tag-you">(You)</span>
                                            }
                                        </div>
                                        <span class="member-username">@@@member.Username • Joined @member.JoinedAt.ToString("MMM d, yyyy")</span>
                                    </div>
                                </div>

                                <div class="member-right">
                                    <span class="role-pill-badge @member.RoleName.ToLowerInvariant()">@member.RoleName</span>

                                    <!-- Member actions if current user is owner/admin -->
                                    @if (canManageRoster && !isThisMemberOwner && !isMe)
                                    {
                                        <div class="member-admin-controls">
                                            @if (isCurrentCircleOwner)
                                            {
                                                <!-- Role switcher dropdown -->
                                                <select class="select-role-sm" value="@member.RoleName" @onchange="@((ChangeEventArgs e) => ChangeMemberRoleAsync(member.UserId, e.Value?.ToString()))">
                                                    <option value="CircleMember">CircleMember</option>
                                                    <option value="CircleAdmin">CircleAdmin</option>
                                                </select>
                                                <button class="btn-tiny-ctrl transfer" title="Transfer Ownership to this member" @onclick="@(() => TransferOwnershipAsync(member.UserId))">
                                                    👑
                                                </button>
                                            }

                                            <button class="btn-tiny-ctrl remove" title="Remove member" @onclick="@(() => RemoveMemberAsync(member.UserId))">
                                                ✕
                                            </button>
                                        </div>
                                    }

                                    @if (isMe && !isThisMemberOwner)
                                    {
                                        <button class="btn-leave-sm" @onclick="LeaveCircleAsync">
                                            Leave Circle
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Owner-only Circle Settings & Disband -->
                    @if (isCurrentCircleOwner)
                    {
                        <div class="circle-danger-zone">
                            <h4>⚙️ Circle Settings & Disband</h4>
                            <p>As the Circle Owner, you can disband or delete this circle. This will deactivate the circle and archive all chat history.</p>
                            <button class="btn-disband" @onclick="DisbandCircleAsync">
                                🗑️ Disband Circle
                            </button>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn-secondary" @onclick="CloseCircleDetailsModal">Close</button>
                </div>
            </div>
        </div>
    }

    <!-- MODAL 3: INVITE FRIENDS -->
    @if (showInviteModal && selectedCircle != null)
    {
        <div class="modal-backdrop" @onclick="@(() => showInviteModal = false)">
            <div class="modal-card" @onclick:stopPropagation>
                <div class="modal-header">
                    <h3>💌 Invite Friends to @selectedCircle.CircleName</h3>
                    <button class="btn-modal-close" @onclick="@(() => showInviteModal = false)">✕</button>
                </div>

                <div class="modal-body">
                    <p class="invite-modal-desc">
                        Only your accepted bestie friends who aren't already members can be invited.
                    </p>

                    @if (isLoadingFriends)
                    {
                        <div class="loading-state">🌸 Loading friends list...</div>
                    }
                    else if (eligibleFriends.Count == 0)
                    {
                        <div class="empty-state-card sm">
                            <p>No eligible friends to invite! Either all your friends are already in this circle or you haven't added friends yet.</p>
                        </div>
                    }
                    else
                    {
                        <div class="eligible-friends-list">
                            @foreach (var friend in eligibleFriends)
                            {
                                <div class="friend-invite-row">
                                    <div class="friend-info-left">
                                        <span class="friend-sticker">@(friend.AvatarSticker ?? "🌸")</span>
                                        <div>
                                            <strong>@friend.DisplayName</strong>
                                            <span class="friend-sub">@@@friend.Username</span>
                                        </div>
                                    </div>
                                    <button class="btn-send-invite" 
                                            disabled="@(isSendingInvite || pendingInviteFriendIds.Contains(friend.UserId))"
                                            @onclick="@(() => SendInvitationAsync(friend.UserId))">
                                        @if (pendingInviteFriendIds.Contains(friend.UserId))
                                        {
                                            <span>✓ Invited</span>
                                        }
                                        else
                                        {
                                            <span>💌 Invite</span>
                                        }
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn-secondary" @onclick="@(() => showInviteModal = false)">Done</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .circles-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 24px 16px 80px 16px;
    }

    .circles-header {
        background: linear-gradient(135deg, #FFF0F5 0%, #FFE5EC 100%);
        border: 2px solid var(--card-blush-border, #FFC2D1);
        border-radius: 28px;
        padding: 36px 30px;
        text-align: center;
        margin-bottom: 28px;
        box-shadow: 0 12px 32px rgba(255, 143, 171, 0.18);
    }
    .header-badge {
        display: inline-block;
        background: #ffffff;
        color: var(--btn-strawberry-dark, #F72585);
        font-weight: 700;
        font-size: 0.82rem;
        padding: 4px 14px;
        border-radius: 20px;
        border: 1px solid var(--card-blush-border, #FFC2D1);
        margin-bottom: 12px;
    }
    .circles-header h1 {
        font-size: 2.1rem;
        color: var(--text-cocoa, #4A3B3C);
        margin-bottom: 8px;
    }
    .subtitle {
        color: var(--text-cocoa-light, #7E6566);
        max-width: 680px;
        margin: 0 auto 24px auto;
        line-height: 1.5;
        font-size: 1rem;
    }
    .header-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }
    .btn-create-circle {
        background: linear-gradient(135deg, var(--btn-strawberry, #FF8FAB) 0%, var(--btn-strawberry-hover, #FB6F92) 100%);
        color: #fff;
        border: none;
        padding: 10px 24px;
        border-radius: 20px;
        font-weight: 700;
        cursor: pointer;
        font-size: 0.95rem;
        box-shadow: 0 4px 14px rgba(251, 111, 146, 0.35);
        transition: all 0.2s;
    }
    .btn-create-circle:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(251, 111, 146, 0.45);
    }
    .btn-invites-tab {
        background: #ffffff;
        border: 2px solid var(--card-blush-border, #FFC2D1);
        color: var(--text-cocoa, #4A3B3C);
        padding: 10px 20px;
        border-radius: 20px;
        font-weight: 700;
        cursor: pointer;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }
    .btn-invites-tab.active {
        background: var(--card-blush, #FFE5EC);
        border-color: var(--btn-strawberry, #FF8FAB);
        color: var(--btn-strawberry-dark, #F72585);
    }
    .invite-badge {
        background: #ef4444;
        color: #fff;
        font-size: 0.72rem;
        padding: 1px 7px;
        border-radius: 10px;
        font-weight: 800;
    }

    .status-banner {
        padding: 12px 18px;
        border-radius: 16px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 600;
        font-size: 0.92rem;
    }
    .status-banner.success {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }
    .status-banner.error {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }
    .btn-close-banner {
        background: none;
        border: none;
        cursor: pointer;
        font-weight: bold;
    }

    .circles-section {
        margin-top: 10px;
    }
    .section-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }
    .section-title-row h2 {
        font-size: 1.4rem;
        color: var(--text-cocoa, #4A3B3C);
    }
    .btn-link-sm {
        background: none;
        border: none;
        color: var(--btn-strawberry-dark, #F72585);
        cursor: pointer;
        font-weight: 600;
        font-size: 0.85rem;
    }

    /* Grid */
    .circles-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
        gap: 20px;
    }
    .circle-card {
        background: #ffffff;
        border: 2px solid var(--card-blush-border, #FFC2D1);
        border-radius: 24px;
        padding: 20px;
        box-shadow: 0 8px 24px rgba(255, 143, 171, 0.12);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 14px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .circle-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(255, 143, 171, 0.22);
    }
    .circle-card-top {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }
    .circle-icon-badge {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--card-blush-light, #FFF0F5);
        border: 2px solid var(--btn-strawberry, #FF8FAB);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }
    .circle-card-title-group {
        flex: 1;
    }
    .circle-card-name {
        font-size: 1.15rem;
        color: var(--text-cocoa, #4A3B3C);
        margin-bottom: 4px;
    }
    .circle-badge-row {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }
    .circle-role-badge {
        font-size: 0.72rem;
        background: var(--card-blush, #FFE5EC);
        color: var(--btn-strawberry-dark, #F72585);
        padding: 2px 8px;
        border-radius: 10px;
        font-weight: 700;
    }
    .circle-capacity-badge {
        font-size: 0.72rem;
        background: #f3f4f6;
        color: var(--text-cocoa-light, #7E6566);
        padding: 2px 8px;
        border-radius: 10px;
        font-weight: 600;
    }
    .circle-card-desc {
        font-size: 0.9rem;
        color: var(--text-cocoa-light, #7E6566);
        line-height: 1.4;
        margin: 0;
        flex: 1;
    }
    .circle-card-footer {
        display: flex;
        gap: 10px;
        padding-top: 10px;
        border-top: 1px solid #f9eef2;
    }
    .btn-card-chat {
        flex: 2;
        background: linear-gradient(135deg, var(--btn-strawberry, #FF8FAB) 0%, var(--btn-strawberry-hover, #FB6F92) 100%);
        color: #fff;
        border: none;
        padding: 9px 14px;
        border-radius: 16px;
        font-weight: 700;
        cursor: pointer;
        font-size: 0.9rem;
        box-shadow: 0 4px 12px rgba(251, 111, 146, 0.25);
    }
    .btn-card-manage {
        flex: 1;
        background: #ffffff;
        border: 2px solid var(--card-blush-border, #FFC2D1);
        color: var(--text-cocoa, #4A3B3C);
        padding: 9px 12px;
        border-radius: 16px;
        font-weight: 600;
        cursor: pointer;
        font-size: 0.85rem;
    }

    /* Invitations Grid */
    .invitations-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 18px;
    }
    .invitation-card {
        background: #ffffff;
        border: 2px solid var(--card-blush-border, #FFC2D1);
        border-radius: 20px;
        padding: 18px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    }
    .inv-card-header {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 8px;
    }
    .inv-icon {
        font-size: 32px;
    }
    .inv-circle-name {
        font-size: 1.05rem;
        color: var(--text-cocoa, #4A3B3C);
        margin: 0;
    }
    .inv-invited-by {
        font-size: 0.8rem;
        color: var(--text-cocoa-light, #7E6566);
    }
    .inv-desc {
        font-size: 0.85rem;
        color: var(--text-cocoa-light, #7E6566);
        margin-bottom: 10px;
    }
    .inv-meta {
        font-size: 0.75rem;
        color: #9ca3af;
        margin-bottom: 12px;
    }
    .inv-actions {
        display: flex;
        gap: 8px;
    }
    .btn-accept-inv {
        flex: 1;
        background: #4ade80;
        color: #fff;
        border: none;
        padding: 8px 12px;
        border-radius: 14px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
    }
    .btn-decline-inv {
        background: #f3f4f6;
        color: #4b5563;
        border: 1px solid #d1d5db;
        padding: 8px 12px;
        border-radius: 14px;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
    }

    /* Modal */
    .modal-backdrop {
        position: fixed;
