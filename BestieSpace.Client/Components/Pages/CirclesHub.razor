@code {
    [Parameter]
    public int? CircleId { get; set; }

    private string activeTab = "circles";
    private int currentUserId = 0;
    private bool isLoadingCircles = true;
    private bool isLoadingInvites = false;
    private bool isLoadingFriends = false;

    private List<CircleDto> myCircles = new();
    private List<CircleInvitationDto> incomingInvitations = new();

    private string? statusFeedback;
    private bool feedbackIsError = false;

    // Create Modal
    private bool showCreateModal = false;
    private bool isSubmittingCreate = false;
    private CreateCircleRequestDto newCircleModel = new() { CircleIcon = "🌸" };
    private readonly string[] stickerChoices = { "🌸", "🎀", "🍓", "🧸", "👑", "💌", "✨", "⭐", "💫", "🐱", "🧁", "🍡" };

    // Details Modal
    private bool showDetailsModal = false;
    private CircleDetailDto? selectedCircle;
    private List<CircleMemberDto> selectedCircleMembers = new();
    private bool isCurrentCircleOwner => selectedCircle != null && selectedCircle.OwnerUserId == currentUserId;
    private bool canManageRoster => isCurrentCircleOwner || (selectedCircleMembers.Any(m => m.UserId == currentUserId && m.RoleName == "CircleAdmin"));
    private bool canInviteToSelectedCircle => canManageRoster || selectedCircleMembers.Any(m => m.UserId == currentUserId);

    // Invite Modal
    private bool showInviteModal = false;
    private List<CircleEligibleFriend> eligibleFriends = new();
    private HashSet<int> pendingInviteFriendIds = new();
    private bool isSendingInvite = false;

    public class CircleEligibleFriend
    {
        public int UserId { get; set; }
        public string Username { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string? AvatarSticker { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserIdAsync();
        await LoadMyCirclesAsync();
        await LoadIncomingInvitationsAsync();

        if (CircleId.HasValue && CircleId.Value > 0)
        {
            await OpenCircleDetailsModal(CircleId.Value);
        }
    }

    private async Task LoadCurrentUserIdAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated == true)
        {
            var idClaim = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                          ?? auth.User.FindFirst("sub")?.Value;
            int.TryParse(idClaim, out currentUserId);
        }
    }

    private async Task LoadMyCirclesAsync()
    {
        isLoadingCircles = true;
        try
        {
            myCircles = await ApiClient.GetMyCirclesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load my circles");
        }
        finally
        {
            isLoadingCircles = false;
        }
    }

    private async Task LoadIncomingInvitationsAsync()
    {
        isLoadingInvites = true;
        try
        {
            incomingInvitations = await ApiClient.GetIncomingCircleInvitationsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load incoming circle invitations");
        }
        finally
        {
            isLoadingInvites = false;
        }
    }

    private void OpenCreateCircleModal()
    {
        newCircleModel = new CreateCircleRequestDto { CircleIcon = "🌸" };
        showCreateModal = true;
    }

    private void CloseCreateCircleModal()
    {
        showCreateModal = false;
    }

    private async Task CreateCircleAsync()
    {
        if (string.IsNullOrWhiteSpace(newCircleModel.CircleName)) return;

        isSubmittingCreate = true;
        try
        {
            var created = await ApiClient.CreateCircleAsync(newCircleModel);
            if (created != null)
            {
                showCreateModal = false;
                ShowFeedback($"Circle '{created.CircleName}' created successfully! 🌸", isError: false);
                await LoadMyCirclesAsync();
                await OpenCircleDetailsModal(created.CircleId);
            }
            else
            {
                ShowFeedback("Could not create circle. Please try again.", isError: true);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating circle");
            ShowFeedback(ex.Message, isError: true);
        }
        finally
        {
            isSubmittingCreate = false;
        }
    }

    private async Task OpenCircleDetailsModal(int circleId)
    {
        try
        {
            selectedCircle = await ApiClient.GetCircleDetailsAsync(circleId);
            if (selectedCircle != null)
            {
                selectedCircleMembers = await ApiClient.GetCircleMembersAsync(circleId);
                showDetailsModal = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load circle {CircleId} details", circleId);
            ShowFeedback("Could not open circle details.", isError: true);
        }
    }

    private void CloseCircleDetailsModal()
    {
        showDetailsModal = false;
        selectedCircle = null;
        selectedCircleMembers.Clear();
    }

    private void OpenCircleChat(int circleId)
    {
        Nav.NavigateTo($"/circles/{circleId}/chat");
    }

    private async Task AcceptInvitationAsync(int invitationId)
    {
        try
        {
            var res = await ApiClient.AcceptCircleInvitationAsync(invitationId);
            if (res.IsSuccess)
            {
                ShowFeedback("Accepted invitation! Welcome to your new circle 🌸", isError: false);
                await LoadIncomingInvitationsAsync();
                await LoadMyCirclesAsync();
                activeTab = "circles";
            }
            else
            {
                ShowFeedback(res.Message, isError: true);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback(ex.Message, isError: true);
        }
    }

    private async Task DeclineInvitationAsync(int invitationId)
    {
        try
        {
            var res = await ApiClient.RejectCircleInvitationAsync(invitationId);
            if (res.IsSuccess)
            {
                ShowFeedback("Invitation declined.", isError: false);
                await LoadIncomingInvitationsAsync();
            }
            else
            {
                ShowFeedback(res.Message, isError: true);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback(ex.Message, isError: true);
        }
    }

    private async Task OpenInviteFriendsModal()
    {
        if (selectedCircle == null) return;
        showInviteModal = true;
        isLoadingFriends = true;
        pendingInviteFriendIds.Clear();

        try
        {
            var friendships = await ApiClient.GetFriendsListAsync();
            var existingMemberIds = selectedCircleMembers.Select(m => m.UserId).ToHashSet();
            eligibleFriends = friendships
                .Select(f => f.RequesterUserId == currentUserId
                    ? new CircleEligibleFriend { UserId = f.AddresseeUserId, Username = f.AddresseeUsername, DisplayName = f.AddresseeDisplayName, AvatarSticker = f.AddresseeAvatarSticker }
                    : new CircleEligibleFriend { UserId = f.RequesterUserId, Username = f.RequesterUsername, DisplayName = f.RequesterDisplayName, AvatarSticker = f.RequesterAvatarSticker })
                .Where(f => !existingMemberIds.Contains(f.UserId))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load friends for invitation");
        }
        finally
        {
            isLoadingFriends = false;
        }
    }

    private async Task SendInvitationAsync(int targetUserId)
    {
        if (selectedCircle == null || isSendingInvite) return;

        isSendingInvite = true;
        try
        {
            var res = await ApiClient.SendCircleInvitationAsync(new SendCircleInvitationRequestDto
            {
                CircleId = selectedCircle.CircleId,
                InviteeUserId = targetUserId
            });

            if (res.IsSuccess)
            {
                pendingInviteFriendIds.Add(targetUserId);
                ShowFeedback("Invitation sent! 💌", isError: false);
            }
            else
            {
                ShowFeedback(res.Message, isError: true);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback(ex.Message, isError: true);
        }
        finally
        {
            isSendingInvite = false;
        }
    }

    private async Task ChangeMemberRoleAsync(int targetUserId, string? newRole)
    {
        if (selectedCircle == null || string.IsNullOrWhiteSpace(newRole)) return;

        try
        {
            var res = await ApiClient.ChangeCircleMemberRoleAsync(selectedCircle.CircleId, new ChangeMemberRoleRequestDto
            {
                TargetUserId = targetUserId,
                NewRoleName = newRole
            });

            if (res.IsSuccess)
            {
                ShowFeedback($"Member role updated to {newRole}!", isError: false);
                selectedCircleMembers = await ApiClient.GetCircleMembersAsync(selectedCircle.CircleId);
            }
            else
            {
                ShowFeedback(res.Message, isError: true);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback(ex.Message, isError: true);
        }
    }

    private async Task TransferOwnershipAsync(int newOwnerUserId)
    {
        if (selectedCircle == null) return;

        try
        {
            var res = await ApiClient.TransferCircleOwnershipAsync(selectedCircle.CircleId, new TransferCircleOwnershipRequestDto
            {
                NewOwnerUserId = newOwnerUserId
            });

            if (res.IsSuccess)
            {
                ShowFeedback("Circle ownership transferred successfully! 👑", isError: false);
                await OpenCircleDetailsModal(selectedCircle.CircleId);
                await LoadMyCirclesAsync();
            }
            else
            {
                ShowFeedback(res.Message, isError: true);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback(ex.Message, isError: true);
        }
    }

    private async Task RemoveMemberAsync(int targetUserId)
    {
        if (selectedCircle == null) return;

        try
        {
            var res = await ApiClient.RemoveCircleMemberAsync(selectedCircle.CircleId, targetUserId);
            if (res.IsSuccess)
            {
                ShowFeedback("Member removed from circle.", isError: false);
                selectedCircleMembers = await ApiClient.GetCircleMembersAsync(selectedCircle.CircleId);
                await LoadMyCirclesAsync();
            }
            else
            {
                ShowFeedback(res.Message, isError: true);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback(ex.Message, isError: true);
        }
    }

    private async Task LeaveCircleAsync()
    {
        if (selectedCircle == null) return;

        try
        {
            var res = await ApiClient.LeaveCircleAsync(selectedCircle.CircleId);
            if (res.IsSuccess)
            {
                CloseCircleDetailsModal();
                ShowFeedback("You have left the circle.", isError: false);
                await LoadMyCirclesAsync();
            }
            else
            {
                ShowFeedback(res.Message, isError: true);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback(ex.Message, isError: true);
        }
    }

    private async Task DisbandCircleAsync()
    {
        if (selectedCircle == null) return;

        try
        {
            var res = await ApiClient.DeleteCircleAsync(selectedCircle.CircleId);
            if (res.IsSuccess)
            {
                CloseCircleDetailsModal();
                ShowFeedback("Circle disbanded.", isError: false);
                await LoadMyCirclesAsync();
            }
            else
            {
                ShowFeedback(res.Message, isError: true);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback(ex.Message, isError: true);
        }
    }

    private void ShowFeedback(string msg, bool isError)
    {
        statusFeedback = msg;
        feedbackIsError = isError;
    }
}
