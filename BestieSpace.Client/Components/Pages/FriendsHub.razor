@page "/friends"
@page "/friends/{InitialTab}"
@page "/profile"
@using BestieSpace.Client.Services
@using BestieSpace.Shared.DTOs
@using System.Threading
@inject NavigationManager Navigation
@inject BestieAuthenticationStateProvider AuthProvider
@inject IBestieApiClient ApiClient
@inject IJSRuntime JSRuntime

<PageTitle>Bestie Clubhouse • Friends & Profile 🌸 | BestieSpace</PageTitle>

<div class="friends-hub-container">
    <!-- Top Header Ribbon -->
    <div class="hub-header-card">
        <div class="hub-brand">
            <div class="brand-icon">👭</div>
            <div>
                <h1 class="hub-title">Bestie Social & Friendship Hub</h1>
                <p class="hub-subtitle">Find your people, manage connections & customize your cozy profile 🌸✨</p>
            </div>
        </div>

        <div class="hub-top-actions">
            <button class="kawaii-btn btn-secondary" @onclick="GoBackToClubhouse">
                🏠 Back to Clubhouse
            </button>
            <button class="kawaii-btn btn-primary" @onclick="RefreshActiveTabDataAsync">
                🔄 Refresh
            </button>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (!string.IsNullOrWhiteSpace(globalSuccessMessage))
    {
        <div class="social-alert alert-success">
            <span class="alert-icon">✨</span>
            <span>@globalSuccessMessage</span>
            <button class="alert-close" @onclick='() => globalSuccessMessage = null'>✕</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(globalErrorMessage))
    {
        <div class="social-alert alert-error">
            <span class="alert-icon">🥺</span>
            <span>@globalErrorMessage</span>
            <button class="alert-close" @onclick='() => globalErrorMessage = null'>✕</button>
        </div>
    }

    <!-- Tab Bar -->
    <div class="hub-tab-bar">
        <button class="hub-tab-btn @(activeTab == "profile" ? "active" : "")" @onclick='() => SwitchTab("profile")'>
            🌸 My Profile
        </button>
        <button class="hub-tab-btn @(activeTab == "discover" ? "active" : "")" @onclick='() => SwitchTab("discover")'>
            🔍 Discover Besties
        </button>
        <button class="hub-tab-btn @(activeTab == "friends" ? "active" : "")" @onclick='() => SwitchTab("friends")'>
            👭 My Friends @(myFriends.Count > 0 ? $"({myFriends.Count})" : "")
        </button>
        <button class="hub-tab-btn @(activeTab == "incoming" ? "active" : "")" @onclick='() => SwitchTab("incoming")'>
            💌 Incoming Requests @(incomingRequests.Count > 0 ? $"({incomingRequests.Count})" : "")
        </button>
        <button class="hub-tab-btn @(activeTab == "sent" ? "active" : "")" @onclick='() => SwitchTab("sent")'>
            🚀 Sent Requests @(outgoingRequests.Count > 0 ? $"({outgoingRequests.Count})" : "")
        </button>
        <button class="hub-tab-btn @(activeTab == "blocked" ? "active" : "")" @onclick='() => SwitchTab("blocked")'>
            🚫 Blocked Users @(blockedUsers.Count > 0 ? $"({blockedUsers.Count})" : "")
        </button>
    </div>

    @if (isLoadingTab)
    {
        <div class="hub-loading">
            <div class="loading-bow">🎀</div>
            <p>Fetching cozy bestie updates...</p>
        </div>
    }
    else
    {
        <!-- =================================================================== -->
        <!-- TAB A: MY PROFILE -->
        <!-- =================================================================== -->
        @if (activeTab == "profile")
        {
            <div class="tab-pane profile-pane">
                @if (myProfile != null)
                {
                    <div class="profile-card">
                        <div class="profile-banner">
                            <div class="avatar-container">
                                @if (!string.IsNullOrWhiteSpace(myProfile.ProfilePicture))
                                {
                                    <img src="@myProfile.ProfilePicture" alt="@myProfile.DisplayName" class="profile-avatar-img" />
                                }
                                else
                                {
                                    <div class="profile-avatar-sticker">@myProfile.AvatarSticker</div>
                                }

                                <label class="avatar-upload-btn" title="Upload new photo">
                                    📷
                                    <InputFile OnChange="HandleProfilePictureUpload" style="display:none;" accept=".jpg,.jpeg,.png,.webp,.gif" />
                                </label>
                            </div>
                        </div>

                        <div class="profile-info-body">
                            <div class="profile-main-names">
                                <h2 class="profile-display-name">@myProfile.DisplayName</h2>
                                <span class="profile-username">@@@myProfile.Username</span>
                            </div>

                            <p class="profile-bio">
                                @(string.IsNullOrWhiteSpace(myProfile.Bio) ? "No bio yet! Click 'Edit Profile' below to share what makes you smile 🍓✨" : myProfile.Bio)
                            </p>

                            <div class="profile-stats-bar">
                                <div class="stat-pill">
                                    <span class="stat-num">@myProfile.FriendCount</span>
                                    <span class="stat-lbl">Besties 👭</span>
                                </div>
                                <div class="stat-pill">
                                    <span class="stat-num">🌸</span>
                                    <span class="stat-lbl">Sticker: @myProfile.AvatarSticker</span>
                                </div>
                                <div class="stat-pill">
                                    <span class="stat-num">Member Since</span>
                                    <span class="stat-lbl">@myProfile.CreatedAt.ToString("MMM yyyy")</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(myProfile.Email))
                            {
                                <div class="profile-email-badge">
                                    <span>📧 @myProfile.Email</span>
                                    <span class="badge-private">🔒 Private to you</span>
                                </div>
                            }

                            <div class="profile-actions-row">
                                <button class="kawaii-btn btn-primary" @onclick="OpenEditProfileModal">
                                    ✏️ Edit Profile
                                </button>
                                <button class="kawaii-btn btn-secondary" @onclick='() => SwitchTab("discover")'>
                                    🔍 Find Besties
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- =================================================================== -->
        <!-- TAB B: DISCOVER BESTIES -->
        <!-- =================================================================== -->
        @if (activeTab == "discover")
        {
            <div class="tab-pane">
                <!-- Search & Filters -->
                <div class="discover-search-bar">
                    <div class="search-input-wrap">
                        <span class="search-icon">🔍</span>
                        <input type="text" 
                               placeholder="Search besties by username or display name..." 
                               value="@searchQuery"
                               @oninput="HandleSearchInput" />
                        @if (!string.IsNullOrWhiteSpace(searchQuery))
                        {
                            <button class="search-clear-btn" @onclick="ClearSearch">✕</button>
                        }
                    </div>
                </div>

                <!-- Suggested Besties Carousel / Section (shown when no active search) -->
                @if (string.IsNullOrWhiteSpace(searchQuery) && suggestedUsers.Any())
                {
                    <div class="suggested-section">
                        <div class="section-title-row">
                            <h3 class="section-title">✨ Suggested Clubhouse Besties</h3>
                            <span class="section-hint">Cute friends you might love chatting with</span>
                        </div>

                        <div class="user-cards-grid">
                            @foreach (var u in suggestedUsers)
                            {
                                <div class="bestie-card">
                                    <div class="card-avatar-wrap">
                                        @if (!string.IsNullOrWhiteSpace(u.ProfilePicture))
                                        {
                                            <img src="@u.ProfilePicture" alt="@u.DisplayName" class="card-avatar-img" />
                                        }
                                        else
                                        {
                                            <div class="card-avatar-sticker">@u.AvatarSticker</div>
                                        }
                                        @if (u.IsOnline)
                                        {
                                            <span class="online-indicator" title="Online now"></span>
                                        }
                                    </div>

                                    <h4 class="card-display-name">@u.DisplayName</h4>
                                    <span class="card-username">@@@u.Username</span>
                                    <p class="card-bio">@(string.IsNullOrWhiteSpace(u.Bio) ? "Ready to make new memories! 🌸" : u.Bio)</p>

                                    <div class="card-actions">
                                        @if (u.FriendshipStatus == "Accepted")
                                        {
                                            <span class="pill-already-friends">💖 Already Besties</span>
                                        }
                                        else if (u.FriendshipStatus == "PendingSent")
                                        {
                                            <span class="pill-pending-sent">💌 Request Sent</span>
                                        }
                                        else if (u.FriendshipStatus == "PendingReceived")
                                        {
                                            <button class="kawaii-btn btn-sm btn-primary" @onclick="() => AcceptFriendshipAsync(u.ActiveFriendshipId ?? 0)">
                                                ✅ Accept
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="kawaii-btn btn-sm btn-primary" @onclick="() => SendFriendRequestAsync(u.UserId)">
                                                ➕ Add Friend
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Search Results Grid -->
                <div class="search-results-section">
                    <div class="section-title-row">
                        <h3 class="section-title">
                            @(string.IsNullOrWhiteSpace(searchQuery) ? "All BestieSpace Members" : $"Search Results for \"{searchQuery}\"")
                            <span class="count-badge">(@discoveryResult.TotalCount)</span>
                        </h3>
                    </div>

                    @if (!discoveryResult.Items.Any())
                    {
                        <div class="empty-state-box">
                            <span class="empty-icon">🧸</span>
                            <h4>No besties found</h4>
                            <p>Try searching with another name or check back as more friends join!</p>
                        </div>
                    }
                    else
                    {
                        <div class="user-cards-grid">
                            @foreach (var u in discoveryResult.Items)
                            {
                                <div class="bestie-card">
                                    <div class="card-avatar-wrap">
                                        @if (!string.IsNullOrWhiteSpace(u.ProfilePicture))
                                        {
                                            <img src="@u.ProfilePicture" alt="@u.DisplayName" class="card-avatar-img" />
                                        }
                                        else
                                        {
                                            <div class="card-avatar-sticker">@u.AvatarSticker</div>
                                        }
                                        @if (u.IsOnline)
                                        {
                                            <span class="online-indicator" title="Online now"></span>
                                        }
                                    </div>

                                    <h4 class="card-display-name">@u.DisplayName</h4>
                                    <span class="card-username">@@@u.Username</span>
                                    <p class="card-bio">@(string.IsNullOrWhiteSpace(u.Bio) ? "Spreading kindness and pastel smiles ✨" : u.Bio)</p>

                                    <div class="card-actions">
                                        @if (u.FriendshipStatus == "Accepted")
                                        {
                                            <span class="pill-already-friends">💖 Bestie</span>
                                        }
                                        else if (u.FriendshipStatus == "PendingSent")
                                        {
                                            <span class="pill-pending-sent">💌 Pending</span>
                                        }
                                        else if (u.FriendshipStatus == "PendingReceived")
                                        {
                                            <button class="kawaii-btn btn-sm btn-primary" @onclick="() => AcceptFriendshipAsync(u.ActiveFriendshipId ?? 0)">
                                                ✅ Accept
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="kawaii-btn btn-sm btn-primary" @onclick="() => SendFriendRequestAsync(u.UserId)">
                                                ➕ Add Friend
                                            </button>
                                        }

                                        <button class="btn-block-subtle" title="Block user" @onclick="() => ConfirmBlockUser(u.UserId, u.Username)">
                                            🚫
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Server-Side Pagination -->
                        @if (discoveryResult.TotalPages > 1)
                        {
                            <div class="pagination-bar">
                                <button class="page-btn" disabled="@(!discoveryResult.HasPreviousPage)" @onclick="() => ChangePage(currentPage - 1)">
                                    ◀ Prev
                                </button>
                                <span class="page-info">Page @discoveryResult.PageNumber of @discoveryResult.TotalPages</span>
                                <button class="page-btn" disabled="@(!discoveryResult.HasNextPage)" @onclick="() => ChangePage(currentPage + 1)">
                                    Next ▶
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        }

        <!-- =================================================================== -->
        <!-- TAB C: MY FRIENDS -->
        <!-- =================================================================== -->
        @if (activeTab == "friends")
        {
            <div class="tab-pane">
                <div class="pane-top-bar">
                    <div class="search-mini">
                        <span>🔍</span>
                        <input type="text" placeholder="Filter friends by name..." @bind="friendsFilter" @bind:event="oninput" />
                    </div>
                </div>

                @if (!FilteredFriends.Any())
                {
                    <div class="empty-state-box">
                        <span class="empty-icon">🌸</span>
                        <h4>No besties in this list yet</h4>
                        <p>Find friends in the Discover tab and send them a cute invite!</p>
                        <button class="kawaii-btn btn-primary" @onclick='() => SwitchTab("discover")'>Discover Besties 🔍</button>
                    </div>
                }
                else
                {
                    <div class="friends-list-grid">
                        @foreach (var f in FilteredFriends)
                        {
                            var fUserId = f.FriendUserId(currentUserId);
                            var fName = f.FriendDisplayName(currentUserId);
                            var fUser = f.FriendUsername(currentUserId);
                            var fPfp = f.FriendProfilePicture(currentUserId);
                            var fSticker = f.FriendAvatarSticker(currentUserId);

                            <div class="friend-item-card">
                                <div class="friend-item-avatar">
                                    @if (!string.IsNullOrWhiteSpace(fPfp))
                                    {
                                        <img src="@fPfp" alt="@fName" class="item-img" />
                                    }
                                    else
                                    {
                                        <span class="item-sticker">@fSticker</span>
                                    }
                                </div>

                                <div class="friend-item-details">
                                    <h4 class="item-name">@fName</h4>
                                    <span class="item-user">@@@fUser</span>
                                    <span class="item-date">Besties since @f.CreatedAt.ToString("MMM d, yyyy")</span>
                                </div>

                                <div class="friend-item-actions">
                                    <button class="kawaii-btn btn-sm btn-outline" @onclick="GoBackToClubhouse">
                                        💬 Chat
                                    </button>
                                    <button class="kawaii-btn btn-sm btn-delete" @onclick="() => ConfirmRemoveFriend(f.FriendshipId, fName)">
                                        🗑️ Unfriend
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- =================================================================== -->
        <!-- TAB D: INCOMING REQUESTS -->
        <!-- =================================================================== -->
        @if (activeTab == "incoming")
        {
            <div class="tab-pane">
                @if (!incomingRequests.Any())
                {
                    <div class="empty-state-box">
                        <span class="empty-icon">💌</span>
                        <h4>Your mailbox is all caught up!</h4>
                        <p>No pending friend requests at the moment.</p>
                    </div>
                }
                else
                {
                    <div class="requests-grid">
                        @foreach (var req in incomingRequests)
                        {
                            <div class="request-card incoming">
                                <div class="req-avatar">
                                    @if (!string.IsNullOrWhiteSpace(req.RequesterProfilePicture))
                                    {
                                        <img src="@req.RequesterProfilePicture" alt="@req.RequesterDisplayName" class="item-img" />
                                    }
                                    else
                                    {
                                        <span class="item-sticker">@req.RequesterAvatarSticker</span>
                                    }
                                </div>

                                <div class="req-info">
                                    <h4 class="req-name">@req.RequesterDisplayName</h4>
                                    <span class="req-username">@@@req.RequesterUsername</span>
                                    <span class="req-date">Sent @req.CreatedAt.ToString("MMM d, h:mm tt")</span>
                                </div>

                                <div class="req-actions">
                                    <button class="kawaii-btn btn-sm btn-primary" @onclick="() => AcceptFriendshipAsync(req.FriendshipId)">
                                        💖 Accept
                                    </button>
                                    <button class="kawaii-btn btn-sm btn-secondary" @onclick="() => RejectFriendshipAsync(req.FriendshipId)">
                                        ✕ Decline
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- =================================================================== -->
        <!-- TAB E: SENT REQUESTS -->
        <!-- =================================================================== -->
        @if (activeTab == "sent")
        {
            <div class="tab-pane">
                @if (!outgoingRequests.Any())
                {
                    <div class="empty-state-box">
                        <span class="empty-icon">🚀</span>
                        <h4>No outgoing requests</h4>
                        <p>You haven't sent any pending requests. Browse besties in Discover!</p>
                    </div>
                }
                else
                {
                    <div class="requests-grid">
                        @foreach (var req in outgoingRequests)
                        {
                            <div class="request-card outgoing">
                                <div class="req-avatar">
                                    @if (!string.IsNullOrWhiteSpace(req.AddresseeProfilePicture))
                                    {
                                        <img src="@req.AddresseeProfilePicture" alt="@req.AddresseeDisplayName" class="item-img" />
                                    }
                                    else
                                    {
                                        <span class="item-sticker">@req.AddresseeAvatarSticker</span>
                                    }
                                </div>

                                <div class="req-info">
                                    <h4 class="req-name">@req.AddresseeDisplayName</h4>
                                    <span class="req-username">@@@req.AddresseeUsername</span>
                                    <span class="req-date">Waiting for reply • @req.CreatedAt.ToString("MMM d")</span>
                                </div>

                                <div class="req-actions">
                                    <button class="kawaii-btn btn-sm btn-secondary" @onclick="() => CancelFriendshipAsync(req.FriendshipId)">
                                        🗑️ Cancel Request
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- =================================================================== -->
        <!-- TAB F: BLOCKED USERS -->
        <!-- =================================================================== -->
        @if (activeTab == "blocked")
        {
            <div class="tab-pane">
                @if (!blockedUsers.Any())
                {
                    <div class="empty-state-box">
                        <span class="empty-icon">🕊️</span>
                        <h4>No blocked users</h4>
                        <p>Your clubhouse environment is peaceful and safe!</p>
                    </div>
                }
                else
                {
                    <div class="blocked-grid">
                        @foreach (var b in blockedUsers)
                        {
                            <div class="blocked-card">
                                <div class="req-avatar">
                                    @if (!string.IsNullOrWhiteSpace(b.BlockedProfilePicture))
                                    {
                                        <img src="@b.BlockedProfilePicture" alt="@b.BlockedDisplayName" class="item-img" />
                                    }
                                    else
                                    {
                                        <span class="item-sticker">@b.BlockedAvatarSticker</span>
                                    }
                                </div>

                                <div class="req-info">
                                    <h4 class="req-name">@b.BlockedDisplayName</h4>
                                    <span class="req-username">@@@b.BlockedUsername</span>
                                    <span class="req-date">Blocked on @b.CreatedAt.ToString("MMM d, yyyy")</span>
                                </div>

                                <div class="req-actions">
                                    <button class="kawaii-btn btn-sm btn-secondary" @onclick="() => UnblockUserAsync(b.BlockedUserId)">
                                        🔓 Unblock
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

<!-- ========================================================================= -->
<!-- MODAL: EDIT PROFILE -->
<!-- ========================================================================= -->
@if (showEditProfileModal && editModel != null)
{
    <div class="modal-backdrop" @onclick="CloseEditProfileModal">
        <div class="kawaii-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>🌸 Edit Cozy Profile</h3>
                <button class="close-btn" @onclick="CloseEditProfileModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Display Nickname *</label>
                    <input type="text" maxlength="50" @bind="editModel.DisplayName" />
                </div>

                <div class="form-group">
                    <label>Avatar Sticker</label>
                    <div class="sticker-selector">
                        @foreach (var sticker in AvailableStickers)
                        {
                            <button type="button" 
                                    class="sticker-pill @(editModel.AvatarSticker == sticker ? "selected" : "")" 
                                    @onclick="() => editModel.AvatarSticker = sticker">
                                @sticker
                            </button>
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label>Bio / Personal Note</label>
                    <textarea rows="3" maxlength="300" placeholder="A little note about you..." @bind="editModel.Bio"></textarea>
                    <span class="char-count">@((editModel.Bio?.Length ?? 0))/300</span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="kawaii-btn btn-secondary" @onclick="CloseEditProfileModal">Cancel</button>
                <button class="kawaii-btn btn-primary" @onclick="SaveProfileAsync" disabled="@isSavingProfile">
                    @(isSavingProfile ? "Saving..." : "✨ Save Profile")
                </button>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- CONFIRMATION MODAL -->
<!-- ========================================================================= -->
@if (showConfirmModal)
{
    <div class="modal-backdrop" @onclick="CloseConfirmModal">
        <div class="kawaii-modal confirm-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>@confirmTitle</h3>
                <button class="close-btn" @onclick="CloseConfirmModal">✕</button>
            </div>
            <div class="modal-body">
                <p>@confirmMessage</p>
            </div>
            <div class="modal-footer">
                <button class="kawaii-btn btn-secondary" @onclick="CloseConfirmModal">Cancel</button>
                <button class="kawaii-btn btn-delete" @onclick="ExecuteConfirmedActionAsync">
                    Confirm 🎀
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? InitialTab { get; set; }

    private string activeTab = "discover";
    private bool isLoadingTab = true;
    private int currentUserId = 0;
    private string? globalSuccessMessage;
    private string? globalErrorMessage;

    // Profile Data
    private UserProfileDto? myProfile;
    private bool showEditProfileModal = false;
    private UpdateUserProfileRequestDto? editModel;
    private bool isSavingProfile = false;

    // Discovery Data
    private string searchQuery = string.Empty;
    private int currentPage = 1;
    private PagedResultDto<UserDiscoveryCardDto> discoveryResult = new();
    private List<UserDiscoveryCardDto> suggestedUsers = new();
    private CancellationTokenSource? searchCts;

    // Friends & Lists Data
    private List<FriendshipDto> myFriends = new();
    private string friendsFilter = string.Empty;
    private List<FriendshipDto> incomingRequests = new();
    private List<FriendshipDto> outgoingRequests = new();
    private List<UserBlockDto> blockedUsers = new();

    // Confirmation Modal
    private bool showConfirmModal = false;
    private string confirmTitle = "Confirm Action";
    private string confirmMessage = "Are you sure you want to proceed?";
    private Func<Task>? confirmAction;

    private static readonly string[] AvailableStickers = { "🌸", "🎀", "🍓", "🧸", "✨", "🐰", "🧁", "💖", "🌙", "🍭" };

    private IEnumerable<FriendshipDto> FilteredFriends =>
        string.IsNullOrWhiteSpace(friendsFilter)
            ? myFriends
            : myFriends.Where(f =>
                f.FriendDisplayName(currentUserId).Contains(friendsFilter, StringComparison.OrdinalIgnoreCase) ||
                f.FriendUsername(currentUserId).Contains(friendsFilter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (authState.User?.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var sub = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(sub, out var parsedId))
        {
            currentUserId = parsedId;
        }

        if (!string.IsNullOrWhiteSpace(InitialTab))
        {
            activeTab = InitialTab.ToLowerInvariant();
        }
        else if (Navigation.Uri.EndsWith("/profile", StringComparison.OrdinalIgnoreCase))
        {
            activeTab = "profile";
        }

        await LoadTabDataAsync(activeTab);
    }

    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        globalSuccessMessage = null;
        globalErrorMessage = null;
        await LoadTabDataAsync(tab);
    }

    private async Task RefreshActiveTabDataAsync()
    {
        await LoadTabDataAsync(activeTab);
    }

    private async Task LoadTabDataAsync(string tab)
    {
        isLoadingTab = true;
        try
        {
            switch (tab)
            {
                case "profile":
                    myProfile = await ApiClient.GetMyProfileAsync();
                    break;

                case "discover":
                    var discTask = ApiClient.DiscoverUsersAsync(searchQuery, currentPage, 12);
                    var suggTask = ApiClient.GetSuggestedUsersAsync(6);
                    await Task.WhenAll(discTask, suggTask);
                    discoveryResult = await discTask;
                    suggestedUsers = await suggTask;
                    break;

                case "friends":
                    myFriends = await ApiClient.GetFriendsListAsync();
                    break;

                case "incoming":
                    incomingRequests = await ApiClient.GetIncomingFriendRequestsAsync();
                    break;

                case "sent":
                    outgoingRequests = await ApiClient.GetOutgoingFriendRequestsAsync();
                    break;

                case "blocked":
                    blockedUsers = await ApiClient.GetBlockedUsersAsync();
                    break;
            }
        }
        catch (Exception ex)
        {
            globalErrorMessage = $"Error loading data: {ex.Message}";
        }
        finally
        {
            isLoadingTab = false;
        }
    }

    private void GoBackToClubhouse()
    {
        Navigation.NavigateTo("/");
    }

    // =========================================================================
    // PROFILE MANAGEMENT
    // =========================================================================

    private void OpenEditProfileModal()
    {
        if (myProfile == null) return;
        editModel = new UpdateUserProfileRequestDto
        {
            DisplayName = myProfile.DisplayName,
            Bio = myProfile.Bio,
            AvatarSticker = myProfile.AvatarSticker
        };
        showEditProfileModal = true;
    }

    private void CloseEditProfileModal()
    {
        showEditProfileModal = false;
        editModel = null;
    }

    private async Task SaveProfileAsync()
    {
        if (editModel == null) return;
        isSavingProfile = true;
        try
        {
            var updated = await ApiClient.UpdateMyProfileAsync(editModel);
            if (updated != null)
            {
                myProfile = updated;
                globalSuccessMessage = "✨ Profile updated successfully!";
                CloseEditProfileModal();
            }
            else
            {
                globalErrorMessage = "Could not update profile. Please try again.";
            }
        }
        catch (Exception ex)
        {
            globalErrorMessage = $"Error saving profile: {ex.Message}";
        }
        finally
        {
            isSavingProfile = false;
        }
    }

    private async Task HandleProfilePictureUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(streamContent, "file", file.Name);

            var newUrl = await ApiClient.UploadProfilePictureAsync(content);
            if (!string.IsNullOrWhiteSpace(newUrl))
            {
                if (myProfile != null) myProfile.ProfilePicture = newUrl;
                globalSuccessMessage = "✨ Profile picture updated!";
            }
            else
            {
                globalErrorMessage = "Failed to upload photo. Ensure it is PNG, JPG, or WEBP under 5MB.";
            }
        }
        catch (Exception ex)
        {
            globalErrorMessage = $"Upload error: {ex.Message}";
        }
    }

    // =========================================================================
    // SEARCH & DISCOVERY
    // =========================================================================

    private void HandleSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;

        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;

        Task.Delay(350, token).ContinueWith(async t =>
        {
            if (!t.IsCanceled)
            {
                await InvokeAsync(async () =>
                {
                    discoveryResult = await ApiClient.DiscoverUsersAsync(searchQuery, currentPage, 12);
                    StateHasChanged();
                });
            }
        });
    }

    private async Task ClearSearch()
    {
        searchQuery = string.Empty;
        currentPage = 1;
        await LoadTabDataAsync("discover");
    }

    private async Task ChangePage(int newPage)
    {
        currentPage = newPage;
        discoveryResult = await ApiClient.DiscoverUsersAsync(searchQuery, currentPage, 12);
    }

    // =========================================================================
    // FRIENDSHIP ACTIONS
    // =========================================================================

    private async Task SendFriendRequestAsync(int targetUserId)
    {
        var res = await ApiClient.SendFriendRequestAsync(targetUserId);
        if (res.IsSuccess)
        {
            globalSuccessMessage = res.Message;
            await LoadTabDataAsync(activeTab);
        }
        else
        {
            globalErrorMessage = res.Message;
        }
    }

    private async Task AcceptFriendshipAsync(int friendshipId)
    {
        var res = await ApiClient.AcceptFriendRequestAsync(friendshipId);
        if (res.IsSuccess)
        {
            globalSuccessMessage = res.Message;
            await LoadTabDataAsync(activeTab);
        }
        else
        {
            globalErrorMessage = res.Message;
        }
    }

    private async Task RejectFriendshipAsync(int friendshipId)
    {
        var res = await ApiClient.RejectFriendRequestAsync(friendshipId);
        if (res.IsSuccess)
        {
            globalSuccessMessage = res.Message;
            await LoadTabDataAsync(activeTab);
        }
        else
        {
            globalErrorMessage = res.Message;
        }
    }

    private async Task CancelFriendshipAsync(int friendshipId)
    {
        var res = await ApiClient.CancelFriendRequestAsync(friendshipId);
        if (res.IsSuccess)
        {
            globalSuccessMessage = res.Message;
            await LoadTabDataAsync(activeTab);
        }
        else
        {
            globalErrorMessage = res.Message;
        }
    }

    private void ConfirmRemoveFriend(int friendshipId, string friendName)
    {
        confirmTitle = "Remove Bestie 💔";
        confirmMessage = $"Are you sure you want to remove {friendName} from your besties? You will have to send a new friend request to reconnect.";
        confirmAction = async () =>
        {
            var res = await ApiClient.RemoveFriendAsync(friendshipId);
            if (res.IsSuccess)
            {
                globalSuccessMessage = res.Message;
                await LoadTabDataAsync("friends");
            }
            else
            {
                globalErrorMessage = res.Message;
            }
        };
        showConfirmModal = true;
    }

    // =========================================================================
    // BLOCKING ACTIONS
    // =========================================================================

    private void ConfirmBlockUser(int targetUserId, string targetUsername)
    {
        confirmTitle = "Block User 🚫";
        confirmMessage = $"Are you sure you want to block @{targetUsername}? They will no longer be able to message you, view your discovery card, or send friend requests.";
        confirmAction = async () =>
        {
            var res = await ApiClient.BlockUserAsync(targetUserId);
            if (res.IsSuccess)
            {
                globalSuccessMessage = res.Message;
                await LoadTabDataAsync(activeTab);
            }
            else
            {
                globalErrorMessage = res.Message;
            }
        };
        showConfirmModal = true;
    }

    private async Task UnblockUserAsync(int targetUserId)
    {
        var res = await ApiClient.UnblockUserAsync(targetUserId);
        if (res.IsSuccess)
        {
            globalSuccessMessage = res.Message;
            await LoadTabDataAsync("blocked");
        }
        else
        {
            globalErrorMessage = res.Message;
        }
    }

    private void CloseConfirmModal()
    {
        showConfirmModal = false;
        confirmAction = null;
    }

    private async Task ExecuteConfirmedActionAsync()
    {
        if (confirmAction != null)
        {
            await confirmAction();
        }
        CloseConfirmModal();
    }
}

