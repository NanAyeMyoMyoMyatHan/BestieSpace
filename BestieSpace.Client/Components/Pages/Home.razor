    private async Task HandleChatPhotoUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            using var form = new MultipartFormDataContent();
            var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            form.Add(streamContent, "photo", file.Name);
            form.Add(new StringContent(currentSender), "senderName");

            var created = await ApiClient.UploadPhotoAsync(form);
            if (created != null)
            {
                if (!allLoadedMessages.Any(m => m.Id == created.Id))
                {
                    allLoadedMessages.Add(created);
                }
                if (!visibleChatMessages.Any(m => m.Id == created.Id))
                {
                    visibleChatMessages.Add(created);
                }
                StateHasChanged();
                await ScrollChatToBottomAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to upload chat photo");
        }
    }

    private async Task ToggleVoiceRecording()
    {
        if (isRecordingVoice)
        {
            await StopAndSendVoiceRecording();
        }
        else
        {
            var started = await JSRuntime.InvokeAsync<bool>("voiceRecorder.startRecording", dotNetHelper);
            if (started)
            {
                isRecordingVoice = true;
                recordingSeconds = 0;
                recordingTimer = new System.Threading.Timer(async _ =>
                {
                    recordingSeconds++;
                    await InvokeAsync(StateHasChanged);
                }, null, 1000, 1000);
            }
        }
    }

    private async Task StopAndSendVoiceRecording()
    {
        if (!isRecordingVoice) return;

        StopRecordingTimer();
        isRecordingVoice = false;

        await JSRuntime.InvokeVoidAsync("voiceRecorder.stopAndUpload", 
            ApiClient.ApiBaseUrl, 
            currentSender, 
            dotNetHelper);
    }

    private async Task CancelVoiceRecording()
    {
        StopRecordingTimer();
        isRecordingVoice = false;
        await JSRuntime.InvokeVoidAsync("voiceRecorder.cancelRecording");
    }

    private void StopRecordingTimer()
    {
        recordingTimer?.Dispose();
        recordingTimer = null;
    }

