@page "/"
@rendermode InteractiveServer
@inject IBestieApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Home> Logger
@inject BestieAuthenticationStateProvider AuthProvider
@implements IAsyncDisposable

<PageTitle>BestieSpace 🌸 | Our Secret Cozy Space</PageTitle>

<!-- =========================================================
     STEP 0: CUTE SECRET BESTIE LOGIN SCREEN
     ========================================================= -->
@if (currentUserSession == null)
{
    <div class="login-gate-overlay">
        <div class="login-card @(isLoginWiggling ? "kawaii-wiggle" : "")">
            <!-- Floating Stickers -->
            <div class="floating-sticker sticker-1">🎀</div>
            <div class="floating-sticker sticker-2">✨</div>
            <div class="floating-sticker sticker-3">🧸</div>
            <div class="floating-sticker sticker-4">💖</div>

            <div class="login-header-icon">🍓✨</div>
            <h1 class="login-title">Secret Bestie Clubhouse</h1>
            <p class="login-subtitle">
                Enter your 4-digit strawberry PIN or secret password to unlock our cozy world 💕
            </p>

            <!-- Login Tabs: PIN Pad vs Password -->
            <div class="login-tabs-nav">
                <button type="button" class="login-tab-btn @(activeLoginTab == "pin" ? "active" : "")" 
                        @onclick='() => { activeLoginTab = "pin"; loginErrorMessage = null; }'>
                    <span>🍓</span> Cute PIN Pad
                </button>
                <button type="button" class="login-tab-btn @(activeLoginTab == "password" ? "active" : "")" 
                        @onclick='() => { activeLoginTab = "password"; loginErrorMessage = null; }'>
                    <span>🔑</span> Secret Password
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(loginErrorMessage))
            {
                <div class="login-error-badge">
                    <span>🥺</span>
                    <span>@loginErrorMessage</span>
                </div>
            }

            @if (activeLoginTab == "pin")
            {
                <!-- Strawberry PIN Pad View -->
                <div class="strawberry-pin-container">
                    <div class="pin-slots-row @(isPinWiggling ? "kawaii-wiggle" : "")">
                        <div class="pin-slot @(enteredPin.Length >= 1 ? "filled" : "")">
                            @if (enteredPin.Length >= 1)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                        <div class="pin-slot @(enteredPin.Length >= 2 ? "filled" : "")">
                            @if (enteredPin.Length >= 2)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                        <div class="pin-slot @(enteredPin.Length >= 3 ? "filled" : "")">
                            @if (enteredPin.Length >= 3)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                        <div class="pin-slot @(enteredPin.Length >= 4 ? "filled" : "")">
                            @if (enteredPin.Length >= 4)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                    </div>

                    <div class="strawberry-keypad">
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("1")'>1</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("2")'>2</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("3")'>3</button>

                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("4")'>4</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("5")'>5</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("6")'>6</button>

                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("7")'>7</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("8")'>8</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("9")'>9</button>

                        <button type="button" class="keypad-btn keypad-btn-special" @onclick="ClearPin" title="Clear PIN">Clear 🌸</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("0")'>0</button>
                        <button type="button" class="keypad-btn keypad-btn-special" @onclick="ToggleHintBox" title="Need a hint?">Hint 💡</button>
                    </div>

                    <div class="pin-hint-tag">
                        <span>Tap 4 digits to unlock automatically (Bestie: 3000 • Me: 4040) ✨</span>
                    </div>
                </div>
            }
            else
            {
                <!-- Secret Password Form View -->
                <div class="login-input-group">
                    <div class="login-field">
                        <label class="login-label">Cute Nickname</label>
                        <div class="login-input-box">
                            <span class="login-input-icon">🍓</span>
                            <input type="text" 
                                   class="login-input" 
                                   placeholder="e.g., strawberry_bestie" 
                                   @bind="loginUsername" 
                                   @bind:event="oninput"
                                   @onkeydown="HandleLoginKeyDown" />
                        </div>
                    </div>

                    <div class="login-field">
                        <label class="login-label">Secret Password</label>
                        <div class="login-input-box">
                            <span class="login-input-icon">🗝️</span>
                            <input type="@(showPassword ? "text" : "password")" 
                                   class="login-input" 
                                   placeholder="••••••••" 
                                   @bind="loginPassword" 
                                   @bind:event="oninput"
                                   @onkeydown="HandleLoginKeyDown" />
                            <button type="button" class="login-toggle-eye" @onclick="() => showPassword = !showPassword" title="Show/Hide Password">
                                @(showPassword ? "👀" : "🫣")
                            </button>
                        </div>
                    </div>
                </div>

                <button class="login-btn-primary" @onclick="HandleLoginAsync" disabled="@isLoggingIn">
                    @if (isLoggingIn)
                    {
                        <span>Checking secret code... 🌸</span>
                    }
                    else
                    {
                        <span>Unlock Clubhouse 💖 ✨</span>
                    }
                </button>
            }

            <!-- VIP Pass & Hint Helper Row -->
            <div class="login-hint-section">
                <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-bottom: 8px;">
                    <button type="button" class="btn-vip-ticket-shortcut" @onclick="() => showVipModal = true">
                        <span>🎟️</span>
                        <span>View VIP Pass</span>
                    </button>
                    <button type="button" class="login-hint-trigger" @onclick="ToggleHintBox">
                        <span>💌</span>
                        <span>Credentials Hint</span>
                    </button>
                </div>

                @if (showHintBox)
                {
                    <div class="login-hint-box">
                        <div class="login-hint-title">
                            <span>✨ VIP Member Credentials:</span>
                        </div>
                        <div style="margin-top: 4px; line-height: 1.5; font-size: 0.88rem;">
                            🌸 <strong>Bestie:</strong> <code>strawberry_bestie</code> • PIN: <strong>3000</strong> • Pass: <em>missyou3000!</em><br />
                            🎀 <strong>Creator:</strong> <code>mochi_maker</code> • PIN: <strong>4040</strong> • Pass: <em>bestie4ever!</em>
                        </div>
                        <div class="quick-fill-row">
                            <button type="button" class="quick-fill-btn" @onclick="QuickFillBestie">
                                🌸 Quick PIN 3000 (Bestie)
                            </button>
                            <button type="button" class="quick-fill-btn" @onclick="QuickFillCreator">
                                🎀 Quick PIN 4040 (Me)
                            </button>
                        </div>
                    </div>
                }

                <div style="text-align: center; margin-top: 14px; padding-top: 10px; border-top: 1px dashed rgba(255, 143, 171, 0.4);">
                    <a href="/register" style="color: #FB6F92; font-weight: 600; text-decoration: none; font-size: 0.92rem;">
                        ✨ New bestie? Click here to register your account! 🌸
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<!-- =========================================================
     STEP 1: INTERACTIVE WELCOME GATE
     ========================================================= -->
<div class="welcome-gate-overlay @(isGateOpen || currentUserSession == null ? "gate-hidden" : "")">
    <div class="welcome-card">
        <!-- Floating Corner Stickers -->
        <div class="floating-sticker sticker-1">🎀</div>
        <div class="floating-sticker sticker-2">✨</div>
        <div class="floating-sticker sticker-3">🧸</div>
        <div class="floating-sticker sticker-4">💖</div>

        <div class="welcome-icon-box">
            <span>💌</span>
        </div>

        <h1 class="welcome-title">Hi My Sweet @(currentUserSession?.DisplayName ?? "Bestie")!</h1>
        <p class="welcome-subtitle">
            I built a cozy, pastel world just for the two of us. <br />
            Packed with our photos, heartfelt letters, secret envelopes, and live chat!
        </p>

        <button class="welcome-btn" @onclick="OpenWelcomeGate">
            <span>Click to open your surprise 💌</span>
            <span style="font-size: 1.4rem;">✨</span>
        </button>
    </div>
</div>

<!-- =========================================================
     STEP 2: MAIN EXPERIENCE
     ========================================================= -->
<div class="main-wrapper" style="@(isGateOpen && currentUserSession != null ? "opacity: 1;" : "opacity: 0.05; pointer-events: none;") transition: opacity 0.6s ease;">
    
    <!-- Top Account Bar -->
    @if (currentUserSession != null)
    {
        <div class="top-user-bar">
            <div class="user-identity-badge">
                <span>@(currentUserSession.AvatarSticker)</span>
                <span>Hi, <strong>@(currentUserSession.DisplayName)</strong>!</span>
            </div>
            <div style="display: flex; gap: 8px; align-items: center;">
                <a href="/friends" class="btn-friends-shortcut" title="Bestie Friends & Profile Hub">
                    <span>👭 Friends & Profile</span>
                </a>
                @if (canAccessAdminConsole)
                {
                    <a href="/admin/rbac" class="btn-admin-shortcut" title="Security & Permissions Console">
                        <span>👑 Admin Console</span>
                    </a>
                }
                <button type="button" class="btn-vip-ticket-shortcut" @onclick="() => showVipModal = true" title="View Printable VIP Pass">
                    <span>🎟️ Bestie VIP Card</span>
                </button>
                <button class="btn-lock-diary" @onclick="LogoutAsync" title="Switch Account or Lock Diary">
                    <span>🔒 Switch Account / Lock</span>
                </button>
            </div>
        </div>
    }
    
    <!-- Top Header -->
    <header class="kawaii-header">
        <div class="brand-badge">
            <span>🌸</span>
            <span>Est. 2026 • Forever & Always</span>
            <span>🎀</span>
        </div>
        <h1 class="brand-title">Bestie<span>Space</span> 💕</h1>
        <p class="brand-tagline">Our secret digital memory box & real-time clubhouse</p>
    </header>

    <!-- Navigation Pills -->
    <nav class="kawaii-nav-tabs">
        <button class="nav-pill-btn @(activeSection == "all" || activeSection == "letter" ? "active" : "")" 
                @onclick="@(() => activeSection = "letter")">
            <span>💌</span> Heartfelt Letter & Meter
        </button>
        <button class="nav-pill-btn @(activeSection == "memories" ? "active" : "")" 
                @onclick="@(() => activeSection = "memories")">
            <span>📸</span> Polaroid Gallery (@(dashboard?.Memories.Count ?? 0))
        </button>
        <button class="nav-pill-btn @(activeSection == "notes" ? "active" : "")" 
                @onclick="@(() => activeSection = "notes")">
            <span>✉️</span> Mystery Envelopes (@(dashboard?.SecretNotes.Count ?? 0))
        </button>
        <button class="nav-pill-btn @(activeSection == "chat" ? "active" : "")" 
                @onclick="@(() => activeSection = "chat")">
            <span>💬</span> Multimedia Chat (@(visibleChatMessages.Count + unreadQueue.Count))
        </button>
        <button class="nav-pill-btn @(activeSection == "all" ? "active" : "")" 
                @onclick="@(() => activeSection = "all")">
            <span>✨</span> View All
        </button>
    </nav>

    <!-- SECTION 1: HEARTFELT LETTER & MISS YOU METER -->
    @if (activeSection == "all" || activeSection == "letter")
    {
        <section class="letter-section" id="letter-section">
            <div class="stationery-card">
                <div class="washi-tape-top"></div>

                <div class="letter-header">
                    <div class="letter-title">
                        <span>💌</span>
                        <span>@(dashboard?.AppStats.MainLetterTitle ?? "To My Favorite Human in the Entire World 🌸")</span>
                    </div>
                    <div class="letter-from-to">
                        <span>With all my love: @(dashboard?.AppStats.SenderNickname ?? "Me 🎀") ➜ @(dashboard?.AppStats.RecipientNickname ?? "Bestie 🌸")</span>
                    </div>
                </div>

                <div class="letter-content">
                    @(dashboard?.AppStats.MainLetterContent ?? "Loading our heartfelt letter...")
                </div>

                <!-- Miss You Meter Box -->
                <div class="miss-you-box">
                    <div class="miss-you-info">
                        <div class="miss-you-counter-badge">
                            <div class="miss-you-counter-number">@missYouCount</div>
                            <div class="miss-you-counter-label">Hugs Sent 💖</div>
                        </div>
                        <div class="miss-you-desc">
                            <div class="miss-you-desc-title">The Live Miss-You Meter 🌸</div>
                            <div class="miss-you-desc-text">
                                Every time you miss me, tap the button! It syncs in real time across the database and sends warm virtual hugs!
                            </div>
                        </div>
                    </div>

                    <button class="btn-miss-you-hug" @onclick="HandleMissYouClick">
                        <span>I Miss You Too! 💖</span>
                        <span style="font-size: 1.4rem;">🧸</span>
                    </button>
                </div>
            </div>
        </section>
    }

    <!-- SECTION 2: POLAROID PHOTO GALLERY -->
    @if (activeSection == "all" || activeSection == "memories")
    {
        <section class="gallery-section" id="memories-section">
            <div class="section-header-row">
                <div>
                    <h2 class="section-title">
                        <span>📸</span>
                        <span>Our Polaroid Memories</span>
                    </h2>
                    <p class="section-subtitle">Moments we froze in time, captured with cute corner stickers</p>
                </div>

                <button class="btn-kawaii-primary" @onclick="() => showAddPhotoModal = true">
                    <span>Add Our Photo 📸</span>
                </button>
            </div>

            <div class="polaroid-grid">
                @if (dashboard?.Memories != null)
                {
                    @foreach (var memory in dashboard.Memories)
                    {
                        var angle = memory.RotationAngle != 0 ? memory.RotationAngle : -1.5;
                        var stickerEmoji = GetStickerEmoji(memory.StickerType);

                        <div class="polaroid-frame" 
                             style="transform: rotate(@(angle)deg);"
                             @onclick="() => OpenLightbox(GetFullMediaUrl(memory.ImageUrl), memory.Caption)">
                            <div class="polaroid-washi"></div>
                            <div class="polaroid-corner-sticker">@stickerEmoji</div>
                            <div class="polaroid-img-wrapper">
                                <img src="@GetFullMediaUrl(memory.ImageUrl)" alt="@memory.Caption" class="polaroid-img" />
                            </div>
                            <div class="polaroid-caption">@memory.Caption</div>
                            <div class="polaroid-date">@memory.MemoryDate.ToString("MMMM dd, yyyy")</div>
                        </div>
                    }
                }
            </div>
        </section>
    }

    <!-- SECTION 3: "EXPLORE MORE" MYSTERY ENVELOPES -->
    @if (activeSection == "all" || activeSection == "notes")
    {
        <section class="envelopes-section" id="notes-section">
            <div class="section-header-row">
                <div>
                    <h2 class="section-title">
                        <span>✉️</span>
                        <span>"Explore More" Mystery Envelopes</span>
                    </h2>
                    <p class="section-subtitle">Click an envelope to break the seal and unlock a heartfelt secret note</p>
                </div>
            </div>

            <div class="envelopes-grid">
                @if (dashboard?.SecretNotes != null)
                {
                    @foreach (var note in dashboard.SecretNotes)
                    {
                        <div class="envelope-card @(note.IsUnlocked ? "unlocked-envelope" : "")"
                             @onclick="() => HandleEnvelopeClick(note)">
                            <div class="envelope-icon-circle">
                                <span>@(note.IsUnlocked ? "📖" : note.StickerIcon)</span>
                            </div>
                            <h3 class="envelope-title">@note.Title</h3>
                            <p class="envelope-hint">@note.PreviewHint</p>

                            @if (note.IsUnlocked)
                            {
                                <span class="envelope-status-badge status-unlocked">
                                    <span>✨ Unlocked</span>
                                </span>
                            }
                            else
                            {
                                <span class="envelope-status-badge status-sealed">
                                    <span>🎀 Sealed • Tap to Open</span>
                                </span>
                            }
                        </div>
                    }
                }
            </div>
        </section>
    }

    <!-- SECTION 4: REAL-TIME MULTIMEDIA BESTIE CHAT BOX -->
    @if (activeSection == "all" || activeSection == "chat")
    {
        <section class="chat-section" id="chat-section">
            <div class="section-header-row">
                <div>
                    <h2 class="section-title">
                        <span>💬</span>
                        <span>Our Real-Time Bestie Clubhouse</span>
                    </h2>
                    <p class="section-subtitle">Chat in real-time with text, cute stickers, photos, and voice notes</p>
                </div>
            </div>

            <div class="chat-card">
                <!-- Chat Top Bar -->
                <div class="chat-top-bar">
                    <div class="chat-header-info">
                        <div class="chat-avatar-group">
                            <span>🎀</span>
                            <span style="margin-left: -8px;">🌸</span>
                        </div>
                        <div>
                            <div class="chat-title-text">
                                <span class="chat-status-dot"></span>
                                Bestie Private Line
                            </div>
                            @if (otherUserPresence != null)
                            {
                                if (otherUserPresence.IsOnline)
                                {
                                    <div class="presence-badge presence-badge-online">
                                        <span class="presence-pulsing-dot"></span>
                                        <span>@(otherUserPresence.DisplayName) is online right now! 💖</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="presence-badge presence-badge-offline">
                                        <span>🌙</span>
                                        <span>@(otherUserPresence.DisplayName) @GetRelativeTime(otherUserPresence.LastSeenAt)</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div style="font-size: 0.8rem; color: var(--text-cocoa-light);">
                                    @(isSignalRConnected ? "Live Connected • Instant Sync 💫" : "Reconnecting... 🌸")
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Auto-Play Toggle & Connected User Badge -->
                    <div class="sender-toggle-wrapper">
                        <button class="autoplay-toggle-btn @(autoPlayVoiceNotes ? "active" : "")"
                                @onclick="() => autoPlayVoiceNotes = !autoPlayVoiceNotes"
                                title="Auto-play voice notes when they pop up">
                            <span>@(autoPlayVoiceNotes ? "🔊 Voice Auto-Play: ON" : "🔈 Voice Auto-Play: OFF")</span>
                        </button>
                        <div class="user-identity-badge" style="border-width: 1.5px; padding: 4px 12px; font-size: 0.82rem;">
                            <span>@(currentUserSession?.AvatarSticker ?? "🌸")</span>
                            <span>Chatting as: <strong>@(currentUserSession?.DisplayName ?? currentSender)</strong></span>
                        </div>
                    </div>
                </div>

                <!-- While You Were Away Cute Banner -->
                @if (unreadCountDisplay > 0 || unreadQueue.Count > 0)
                {
                    var count = unreadCountDisplay > 0 ? unreadCountDisplay : unreadQueue.Count;
                    <div class="unread-queue-banner">
                        <span>💌</span>
                        <span>While you were away: <strong>@count</strong> sweet message@(count > 1 ? "s" : "") waiting for you!</span>
                        <span style="font-size: 1.1rem; animation: pulseRecording 1.2s infinite;">✨</span>
                    </div>
                }

                <!-- Chat Messages Scroll Area -->
                <div class="chat-messages-container" id="chat-scroll-container">
                    @if (visibleChatMessages.Count == 0 && !showTypingIndicator)
                    {
                        <div style="text-align: center; color: var(--text-cocoa-light); padding: 40px 0;">
                            <div style="font-size: 40px; margin-bottom: 8px;">🌸</div>
                            <p>No messages yet! Say hi to your bestie below 💖</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var msg in visibleChatMessages)
                        {
                            var isMe = msg.SenderName == currentSender || msg.SenderName.Contains("Me");
                            var rowClass = isMe ? "chat-me" : "chat-bestie";
                            var bubbleAnimate = msg.Id == newlyPoppedMessageId ? "chat-bubble-popup-animate" : "";

                            <div class="chat-row @rowClass">
                                <div class="chat-sender-tag">
                                    <span>@msg.SenderName</span>
                                </div>

                                @switch (msg.MessageType?.ToLowerInvariant())
                                {
                                    case "text":
                                        <div class="chat-bubble @bubbleAnimate">
                                            @msg.Content
                                            <div class="chat-status-meta">
                                                <span class="chat-time">@msg.Timestamp.ToString("h:mm tt")</span>
                                                @if (isMe)
                                                {
                                                    <span class="chat-seen-indicator">@(msg.IsRead ? "Seen 💖" : "Delivered ✨")</span>
                                                }
                                                else
                                                {
                                                    <span class="chat-seen-indicator">Seen 💖</span>
                                                }
                                            </div>
                                        </div>
                                        break;

                                    case "sticker":
                                        <div class="chat-bubble chat-bubble-sticker @bubbleAnimate">
                                            <div style="font-size: 72px; text-align: center; line-height: 1.1;">
                                                @GetStickerVisual(msg.Content)
                                            </div>
                                            <div class="chat-status-meta">
                                                <span class="chat-time" style="color: var(--text-cocoa-light);">@msg.Timestamp.ToString("h:mm tt")</span>
                                                @if (isMe)
                                                {
                                                    <span class="chat-seen-indicator" style="color: var(--text-cocoa-light);">@(msg.IsRead ? "Seen 💖" : "Delivered ✨")</span>
                                                }
                                                else
                                                {
                                                    <span class="chat-seen-indicator" style="color: var(--text-cocoa-light);">Seen 💖</span>
                                                }
                                            </div>
                                        </div>
                                        break;

                                    case "photo":
                                        <div class="chat-bubble @bubbleAnimate" style="padding: 10px;">
                                            <img src="@GetFullMediaUrl(msg.MediaUrl)" 
                                                 alt="Shared photo" 
                                                 class="chat-photo-thumb"
                                                 @onclick="() => OpenLightbox(GetFullMediaUrl(msg.MediaUrl), msg.Content ?? msg.SenderName)" />
                                            @if (!string.IsNullOrWhiteSpace(msg.Content))
                                            {
                                                <div style="margin-top: 6px; font-size: 0.95rem;">@msg.Content</div>
                                            }
                                            <div class="chat-status-meta">
                                                <span class="chat-time">@msg.Timestamp.ToString("h:mm tt")</span>
                                                @if (isMe)
                                                {
                                                    <span class="chat-seen-indicator">@(msg.IsRead ? "Seen 💖" : "Delivered ✨")</span>
                                                }
                                                else
                                                {
                                                    <span class="chat-seen-indicator">Seen 💖</span>
                                                }
                                            </div>
                                        </div>
                                        break;

                                    case "voice":
                                        {
                                            var currentMsg = msg;
                                            var audioId = $"audio-{currentMsg.Id}";
                                            var duration = currentMsg.VoiceDurationSeconds.HasValue 
                                                ? $"0:{((int)currentMsg.VoiceDurationSeconds.Value):D2}" 
                                                : "0:05";
                                            var isFreshPop = currentMsg.Id == newlyPoppedMessageId;

                                            <div class="chat-bubble @bubbleAnimate @(isFreshPop ? "voice-note-highlight" : "")">
                                                @if (isFreshPop || !currentMsg.IsRead)
                                                {
                                                    <div class="voice-glowing-badge" @onclick="() => ToggleAudioPlayback(audioId)">
                                                        <span>🌸</span>
                                                        <span>New Voice Note • Tap to listen 🎧</span>
                                                    </div>
                                                }
                                                <div class="pastel-audio-player">
                                                    <button class="audio-play-btn" @onclick="() => ToggleAudioPlayback(audioId)">
                                                        @(currentlyPlayingAudioId == audioId ? "⏸" : "▶")
                                                    </button>
                                                    <div class="audio-wave-bar">
                                                        <span style="height: 12px;"></span>
                                                        <span style="height: 18px;"></span>
                                                        <span style="height: 24px;"></span>
                                                        <span style="height: 14px;"></span>
                                                        <span style="height: 20px;"></span>
                                                        <span style="height: 16px;"></span>
                                                        <span style="height: 22px;"></span>
                                                        <span style="height: 10px;"></span>
                                                    </div>
                                                    <span class="audio-duration">@duration</span>
                                                </div>
                                                <audio id="@audioId" src="@GetFullMediaUrl(currentMsg.MediaUrl)" 
                                                       @onended="() => currentlyPlayingAudioId = null"></audio>
                                                <div class="chat-status-meta">
                                                    <span class="chat-time">@currentMsg.Timestamp.ToString("h:mm tt")</span>
                                                    @if (isMe)
                                                    {
                                                        <span class="chat-seen-indicator">@(currentMsg.IsRead ? "Seen 💖" : "Delivered ✨")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="chat-seen-indicator">Seen 💖</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        break;

                                    default:
                                        <div class="chat-bubble @bubbleAnimate">
                                            @msg.Content
                                            <div class="chat-status-meta">
                                                <span class="chat-time">@msg.Timestamp.ToString("h:mm tt")</span>
                                            </div>
                                        </div>
                                        break;
                                }
                            </div>
                        }

                        <!-- Typing / Recording Indicator Bubble -->
                        @if (showTypingIndicator)
                        {
                            <div class="chat-row chat-bestie">
                                <div class="chat-sender-tag">
                                    <span>@(currentSender == "Me 🎀" ? "Bestie 🌸" : "Me 🎀")</span>
                                </div>
                                <div class="typing-bubble-wrapper">
                                    <span class="typing-indicator-label">@typingIndicatorText</span>
                                    <div class="typing-dots">
                                        <span class="typing-dot"></span>
                                        <span class="typing-dot"></span>
                                        <span class="typing-dot"></span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Collapsible Sticker Tray -->
                @if (showStickerTray)
                {
                    <div class="sticker-tray">
                        <button class="sticker-item-btn" @onclick="@(() => SendStickerMessage("hugging-bear"))">
                            <span class="sticker-emoji-icon">🧸</span>
                            <span class="sticker-label">Hug</span>
                        </button>
                        <button class="sticker-item-btn" @onclick="@(() => SendStickerMessage("missing-you-cat"))">
                            <span class="sticker-emoji-icon">😿</span>
                            <span class="sticker-label">Miss You</span>
                        </button>
                        <button class="sticker-item-btn" @onclick="@(() => SendStickerMessage("sparkling-heart"))">
                            <span class="sticker-emoji-icon">💖</span>
                            <span class="sticker-label">Love</span>
                        </button>
                        <button class="sticker-item-btn" @onclick="@(() => SendStickerMessage("boba-cheers"))">
                            <span class="sticker-emoji-icon">🧋</span>
                            <span class="sticker-label">Boba Cheers</span>
                        </button>
                        <button class="sticker-item-btn" @onclick="@(() => SendStickerMessage("cute-bunny"))">
                            <span class="sticker-emoji-icon">🐰</span>
                            <span class="sticker-label">Bunny</span>
                        </button>
                        <button class="sticker-item-btn" @onclick="@(() => SendStickerMessage("sweet-strawberry"))">
                            <span class="sticker-emoji-icon">🍓</span>
                            <span class="sticker-label">Berry Sweet</span>
                        </button>
                        <button class="sticker-item-btn" @onclick="@(() => SendStickerMessage("pinky-promise"))">
                            <span class="sticker-emoji-icon">🤞</span>
                            <span class="sticker-label">Promise</span>
                        </button>
                        <button class="sticker-item-btn" @onclick="@(() => SendStickerMessage("besties-forever"))">
                            <span class="sticker-emoji-icon">👭</span>
                            <span class="sticker-label">BFFs</span>
                        </button>
                    </div>
                }

                <!-- Chat Input Controls -->
                <div class="chat-bottom-bar">
                    @if (isRecordingVoice)
                    {
                        <div class="recording-bar">
                            <div class="recording-indicator">
                                <span class="rec-pulse-dot"></span>
                                <span>Recording voice note... 0:@(recordingSeconds.ToString("D2"))</span>
                            </div>
                            <div class="recording-actions">
                                <button class="btn-rec-action btn-rec-cancel" @onclick="CancelVoiceRecording">Cancel</button>
                                <button class="btn-rec-action btn-rec-send" @onclick="StopAndSendVoiceRecording">Send 💖</button>
                            </div>
                        </div>
                    }

                    <div class="chat-input-row" style="margin-top: @(isRecordingVoice ? "10px" : "0");">
                        <!-- Stickers Toggle Button -->
                        <button class="chat-icon-btn" title="Pick Kawaii Sticker" @onclick="() => showStickerTray = !showStickerTray">
                            🧸
                        </button>

                        <!-- Photo Upload Button -->
                        <label class="chat-icon-btn" title="Send a Photo 📸" style="margin: 0;">
                            📸
                            <InputFile OnChange="HandleChatPhotoUpload" accept="image/*" style="display: none;" />
                        </label>

                        <!-- Voice Note Button -->
                        <button class="chat-icon-btn @(isRecordingVoice ? "recording" : "")" 
                                title="Record Voice Note 🎤" 
                                @onclick="ToggleVoiceRecording">
                            🎤
                        </button>

                        <!-- Text Input -->
                        <input type="text" 
                               class="chat-text-input" 
                               placeholder="Type a sweet message to your bestie..."
                               @bind="chatInputText" 
                               @bind:event="oninput"
                               @onkeydown="HandleKeyDown" />

                        <!-- Send Button -->
                        <button class="chat-send-btn" title="Send" @onclick="SendTextMessage">
                            💖
                        </button>
                    </div>
                </div>
            </div>
        </section>
    }
</div>

