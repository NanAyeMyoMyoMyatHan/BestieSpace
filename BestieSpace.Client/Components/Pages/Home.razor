@code {
    private bool isGateOpen = false;
    private string activeSection = "all";
    private DashboardDto? dashboard;
    private int missYouCount = 1000;
    
    // Auth Session & Cute Secret Login State
    private UserSessionDto? currentUserSession;
    private bool canAccessAdminConsole =>
        currentUserSession != null &&
        (AuthProvider.HasRole("SuperAdmin") ||
         AuthProvider.HasRole("Admin") ||
         AuthProvider.HasPermission("ROLE_VIEW") ||
         AuthProvider.HasPermission("USER_MANAGE") ||
         (currentUserSession.Roles != null && (currentUserSession.Roles.Contains("SuperAdmin") || currentUserSession.Roles.Contains("Admin"))));
    private string activeLoginTab = "pin"; // "pin" or "password"
    private string enteredPin = "";
    private bool isPinLoggingIn = false;
    private bool isPinWiggling = false;
    private string loginUsername = "";
    private string loginPassword = "";
    private bool showPassword = false;
    private bool isLoggingIn = false;
    private string? loginErrorMessage;
    private bool isLoginWiggling = false;
    private bool showHintBox = false;

    // Real-Time Presence State
    private UserPresenceDto? otherUserPresence;

    // Chat state & Offline Message Queue
    private List<ChatMessageDto> allLoadedMessages = new();
    private List<ChatMessageDto> visibleChatMessages = new();
    private Queue<ChatMessageDto> unreadQueue = new();
    private bool isPoppingUpQueue = false;
    private bool showTypingIndicator = false;
    private string typingIndicatorText = "🎀 Sending you a note...";
    private int? newlyPoppedMessageId = null;
    private bool autoPlayVoiceNotes = true;
    private int unreadCountDisplay = 0;

    private string currentSender = "Sweet Bestie 🌸";
    private string chatInputText = "";
    private bool showStickerTray = false;
    private bool isRecordingVoice = false;
    private int recordingSeconds = 0;
    private System.Threading.Timer? recordingTimer;
    private DotNetObjectReference<Home>? dotNetHelper;
    private HubConnection? hubConnection;
    private bool isSignalRConnected = false;

    // Modals
    private bool showAddPhotoModal = false;
    private bool showSecretNoteModal = false;
    private SecretNoteDto? activeSecretNote;
    private bool showLightboxModal = false;
    private string activeLightboxUrl = "";
    private string activeLightboxCaption = "";
    private bool showVipModal = false;
    private bool isTicketCopied = false;

    // Add Photo Form State
    private string newPhotoCaption = "";
    private string newPhotoSticker = "bow";
    private DateTime newPhotoDate = DateTime.Today;
    private IBrowserFile? selectedPhotoFile;
    private string? photoPreviewDataUrl;
    private bool isUploadingPhoto = false;

    // Audio Playback
    private string? currentlyPlayingAudioId;

    protected override async Task OnInitializedAsync()
    {
        dotNetHelper = DotNetObjectReference.Create(this);

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (AuthProvider.CurrentUser != null)
        {
            ApplyUserSession(AuthProvider.CurrentUser);
        }

        await LoadDashboardAsync();
        await LoadChatMessagesAsync();
        await InitializeSignalRAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && currentUserSession == null)
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            if (AuthProvider.CurrentUser != null)
            {
                ApplyUserSession(AuthProvider.CurrentUser);
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void ApplyUserSession(UserSessionDto session)
    {
        currentUserSession = session;
        currentSender = session.RoleKey == "Bestie" ? "Bestie 🌸" : "Me 🎀";
        PartitionMessagesForCurrentViewer();

        if (hubConnection != null && hubConnection.State == HubConnectionState.Connected)
        {
            _ = hubConnection.SendAsync("RegisterUser", currentSender);
        }

        _ = Task.Run(async () =>
        {
            try
            {
                var otherRole = session.RoleKey == "Bestie" ? "Me" : "Bestie";
                otherUserPresence = await ApiClient.GetPresenceAsync(otherRole);
                await InvokeAsync(StateHasChanged);
            }
            catch { }
        });

        if (isGateOpen && unreadQueue.Count > 0)
        {
            _ = ProcessUnreadQueueAsync();
        }
    }

    private async Task AppendPinDigit(string digit)
    {
        if (isPinLoggingIn || enteredPin.Length >= 4) return;
        enteredPin += digit;
        StateHasChanged();

        if (enteredPin.Length == 4)
        {
            await HandlePinSubmitAsync(enteredPin);
        }
    }

    private void ClearPin()
    {
        enteredPin = "";
        loginErrorMessage = null;
        StateHasChanged();
    }

    private async Task HandlePinSubmitAsync(string pinToVerify)
    {
        isPinLoggingIn = true;
        loginErrorMessage = null;
        StateHasChanged();

        try
        {
            var res = await AuthProvider.PinLoginAsync(pinToVerify);

            if (res.IsSuccess && res.User != null)
            {
                currentUserSession = res.User;
                ApplyUserSession(currentUserSession);
                await JSRuntime.InvokeVoidAsync("bestieAnimations.playCutePopSound");
                await JSRuntime.InvokeVoidAsync("bestieAnimations.triggerConfettiBurst");
                enteredPin = "";
            }
            else
            {
                loginErrorMessage = res.Message ?? "Oopsie! Wrong strawberry PIN 🍓🥺 Try again!";
                isPinWiggling = true;
                StateHasChanged();
                await Task.Delay(600);
                isPinWiggling = false;
                enteredPin = "";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "PIN login error");
            loginErrorMessage = "Oopsie! Wrong strawberry PIN 🍓🥺 Try again!";
            isPinWiggling = true;
            StateHasChanged();
            await Task.Delay(600);
            isPinWiggling = false;
            enteredPin = "";
        }
        finally
        {
            isPinLoggingIn = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CopyVipTicketAsync()
    {
        try
        {
            var invite = "🍓✨ --- OFFICIAL VIP PASS: BESTIE CLUBHOUSE --- ✨🍓\n"
                       + "🌸 Member: Sweet Bestie 🌸\n"
                       + "🍓 Nickname: strawberry_bestie\n"
                       + "🔑 Secret Password: missyou3000!\n"
                       + "🎀 4-Digit Quick-PIN: 3000 🍓\n"
                       + "💌 Welcome to our cozy clubhouse! 💕";
            await JSRuntime.InvokeVoidAsync("bestieTicket.copyText", invite);
            isTicketCopied = true;
            StateHasChanged();
            _ = Task.Delay(2500).ContinueWith(_ =>
            {
                isTicketCopied = false;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error copying VIP ticket");
        }
    }

    private async Task PrintVipTicketAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("bestieTicket.printTicket");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error printing VIP ticket");
        }
    }

    private string GetRelativeTime(DateTime? utcTime)
    {
        if (!utcTime.HasValue) return "was here earlier 🌸";
        var diff = DateTime.UtcNow - utcTime.Value;
        if (diff.TotalMinutes < 1) return "was here just now ✨";
        if (diff.TotalMinutes < 60) return $"was here {(int)diff.TotalMinutes}m ago 🌸";
        if (diff.TotalHours < 24) return $"was here {(int)diff.TotalHours}h ago 🧸";
        return $"was here {utcTime.Value.ToLocalTime():MMM d} 💌";
    }

    private async Task HandleLoginAsync()
    {
        if (string.IsNullOrWhiteSpace(loginUsername) || string.IsNullOrWhiteSpace(loginPassword))
        {
            loginErrorMessage = "Please enter both your nickname and secret code 🌸";
            TriggerWiggle();
            return;
        }

        isLoggingIn = true;
        loginErrorMessage = null;

        try
        {
            var response = await AuthProvider.LoginAsync(loginUsername.Trim(), loginPassword.Trim());

            if (response.IsSuccess && response.User != null)
            {
                currentUserSession = response.User;
                ApplyUserSession(currentUserSession);
                await JSRuntime.InvokeVoidAsync("bestieAnimations.playCutePopSound");
                await JSRuntime.InvokeVoidAsync("bestieAnimations.triggerConfettiBurst");

                loginUsername = "";
                loginPassword = "";
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                loginErrorMessage = response.Message ?? "Oopsie! Wrong secret code 🥺 Try again!";
                TriggerWiggle();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Login exception");
            loginErrorMessage = "Oopsie! Wrong secret code 🥺 Try again!";
            TriggerWiggle();
        }
        finally
        {
            isLoggingIn = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LogoutAsync()
    {
        await AuthProvider.LogoutAsync();
        currentUserSession = null;
        loginErrorMessage = null;
        loginUsername = "";
        loginPassword = "";
        enteredPin = "";
        otherUserPresence = null;
        isGateOpen = false;

        try
        {
            await JSRuntime.InvokeVoidAsync("bestieAuth.clearSession");
        }
        catch { }

        PartitionMessagesForCurrentViewer();
        await InvokeAsync(StateHasChanged);
    }

    private void TriggerWiggle()
    {
        isLoginWiggling = true;
        _ = Task.Run(async () =>
        {
            await Task.Delay(550);
            isLoginWiggling = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void ToggleHintBox()
    {
        showHintBox = !showHintBox;
    }

    private void QuickFillBestie()
    {
        if (activeLoginTab == "pin")
        {
            enteredPin = "3000";
            _ = HandlePinSubmitAsync("3000");
        }
        else
        {
            loginUsername = "strawberry_bestie";
            loginPassword = "missyou3000!";
            loginErrorMessage = null;
        }
    }

    private void QuickFillCreator()
    {
        if (activeLoginTab == "pin")
        {
            enteredPin = "4040";
            _ = HandlePinSubmitAsync("4040");
        }
        else
        {
            loginUsername = "mochi_maker";
            loginPassword = "bestie4ever!";
            loginErrorMessage = null;
        }
    }

    private async Task HandleLoginKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLoginAsync();
        }
    }

    private bool IsSentByCurrentViewer(ChatMessageDto msg)
    {
        if (currentUserSession != null)
        {
            if (currentUserSession.RoleKey == "Bestie")
            {
                return msg.SenderName.Contains("Bestie", StringComparison.OrdinalIgnoreCase);
            }
            return msg.SenderName.Contains("Me", StringComparison.OrdinalIgnoreCase);
        }
        return msg.SenderName == currentSender || msg.SenderName.Contains("Me");
    }

    private async Task LoadDashboardAsync()
    {
        try
        {
            dashboard = await ApiClient.GetDashboardAsync();
            if (dashboard?.AppStats != null)
            {
                missYouCount = dashboard.AppStats.MissYouCount;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading dashboard");
        }
    }

    private async Task LoadChatMessagesAsync()
    {
        try
        {
            var msgs = await ApiClient.GetChatMessagesAsync(currentSender);
            if (msgs != null)
            {
                allLoadedMessages = msgs;
                PartitionMessagesForCurrentViewer();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading chat messages");
        }
    }

    private void PartitionMessagesForCurrentViewer()
    {
        visibleChatMessages.Clear();
        unreadQueue.Clear();

        foreach (var msg in allLoadedMessages)
        {
            if (IsSentByCurrentViewer(msg) || msg.IsRead)
            {
                visibleChatMessages.Add(msg);
            }
            else
            {
                unreadQueue.Enqueue(msg);
            }
        }

        unreadCountDisplay = unreadQueue.Count;
    }

    private async Task InitializeSignalRAsync()
    {
        try
        {
            var hubUrl = $"{ApiClient.ApiBaseUrl}/chathub";
            hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<ChatMessageDto>("ReceiveMessage", async (incomingMessage) =>
            {
                if (!allLoadedMessages.Any(m => m.Id == incomingMessage.Id))
                {
                    allLoadedMessages.Add(incomingMessage);
                }

                if (IsSentByCurrentViewer(incomingMessage))
                {
                    if (!visibleChatMessages.Any(m => m.Id == incomingMessage.Id))
                    {
                        visibleChatMessages.Add(incomingMessage);
                    }
                    await InvokeAsync(StateHasChanged);
                    await ScrollChatToBottomAsync();
                }
                else
                {
                    // Incoming message from the other bestie
                    unreadQueue.Enqueue(incomingMessage);
                    unreadCountDisplay = unreadQueue.Count;
                    await InvokeAsync(StateHasChanged);

                    if (isGateOpen)
                    {
                        _ = ProcessUnreadQueueAsync();
                    }
                }
            });

            hubConnection.On<MessagesReadNotification>("MessagesRead", async (notification) =>
            {
                if (notification.MessageIds != null)
                {
                    foreach (var id in notification.MessageIds)
                    {
                        var m = allLoadedMessages.FirstOrDefault(x => x.Id == id);
                        if (m != null)
                        {
                            m.IsRead = true;
                            m.ReadAt = notification.ReadAt;
                        }
                        var vm = visibleChatMessages.FirstOrDefault(x => x.Id == id);
                        if (vm != null)
                        {
                            vm.IsRead = true;
                            vm.ReadAt = notification.ReadAt;
                        }
                    }
                    await InvokeAsync(StateHasChanged);
                }
            });

            hubConnection.On<UserPresenceDto>("UserPresenceChanged", async (presence) =>
            {
                if (currentUserSession == null || presence.RoleKey != currentUserSession.RoleKey)
                {
                    otherUserPresence = presence;
                    await InvokeAsync(StateHasChanged);
                }
            });

            await hubConnection.StartAsync();
            isSignalRConnected = true;

            // Register current active viewer
            await hubConnection.SendAsync("RegisterUser", currentSender);

            // Fetch initial presence of other user if logged in
            if (currentUserSession != null)
            {
                try
                {
                    var otherRole = currentUserSession.RoleKey == "Bestie" ? "Me" : "Bestie";
                    otherUserPresence = await ApiClient.GetPresenceAsync(otherRole);
                    await InvokeAsync(StateHasChanged);
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "SignalR connection error (API may be starting up)");
            isSignalRConnected = false;
        }
    }

    private async Task OpenWelcomeGate()
    {
        isGateOpen = true;
        await JSRuntime.InvokeVoidAsync("bestieAnimations.triggerConfettiBurst");
        await ScrollChatToBottomAsync();

        if (unreadQueue.Count > 0)
        {
            _ = ProcessUnreadQueueAsync();
        }
    }

    private async Task ProcessUnreadQueueAsync()
    {
        if (isPoppingUpQueue) return;
        isPoppingUpQueue = true;

        try
        {
            while (unreadQueue.Count > 0)
            {
                var nextMsg = unreadQueue.Peek();

                // 1. Show cute animated typing / recording indicator bubble for 1000ms
                if (nextMsg.MessageType == "voice")
                {
                    typingIndicatorText = "🎤 Sending a voice note...";
                }
                else if (nextMsg.MessageType == "photo")
                {
                    typingIndicatorText = "📸 Sending a photo...";
                }
                else if (nextMsg.MessageType == "sticker")
                {
                    typingIndicatorText = "🧸 Picking a sweet sticker...";
                }
                else
                {
                    typingIndicatorText = "🎀 Sending you a note...";
                }

                showTypingIndicator = true;
                await InvokeAsync(StateHasChanged);
                await ScrollChatToBottomAsync();

                await Task.Delay(1000);

                // 2. Dequeue and pop message into the visible list with bounce animation
                unreadQueue.Dequeue();
                showTypingIndicator = false;
                newlyPoppedMessageId = nextMsg.Id;

                if (!visibleChatMessages.Any(m => m.Id == nextMsg.Id))
                {
                    visibleChatMessages.Add(nextMsg);
                }

                // Trigger subtle cute pop sound via Web Audio API synthesis
                try
                {
                    await JSRuntime.InvokeVoidAsync("bestieAnimations.playCutePopSound");
                }
                catch { }

                await InvokeAsync(StateHasChanged);
                await ScrollChatToBottomAsync();

                // 3. Highlight Voice Note and auto-play if enabled
                if (nextMsg.MessageType == "voice" && autoPlayVoiceNotes)
                {
                    var audioId = $"audio-{nextMsg.Id}";
                    _ = ToggleAudioPlayback(audioId);
                }

                // 4. Mark read in SQL Server / SQLite and broadcast via SignalR
                try
                {
                    var markReq = new MarkMessagesReadRequest
                    {
                        MessageIds = new List<int> { nextMsg.Id },
                        ReaderName = currentSender
                    };
                    await ApiClient.MarkMessagesReadAsync(markReq);
                    nextMsg.IsRead = true;
                    nextMsg.ReadAt = DateTime.UtcNow;
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to mark message {Id} as read", nextMsg.Id);
                    nextMsg.IsRead = true;
                }

                unreadCountDisplay = unreadQueue.Count;
                await InvokeAsync(StateHasChanged);

                // 5. Wait 800ms before starting next message in queue
                await Task.Delay(800);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing unread message queue");
        }
        finally
        {
            showTypingIndicator = false;
            isPoppingUpQueue = false;
            unreadCountDisplay = 0;
            await InvokeAsync(StateHasChanged);
        }
    }

