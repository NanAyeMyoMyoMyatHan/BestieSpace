    [JSInvokable]
    public async Task OnRecordingComplete(System.Text.Json.JsonElement result)
    {
        try
        {
            var id = result.GetProperty("id").GetInt32();
            if (!allLoadedMessages.Any(m => m.Id == id))
            {
                var msg = new ChatMessageDto
                {
                    Id = id,
                    SenderName = result.GetProperty("senderName").GetString() ?? currentSender,
                    MessageType = "voice",
                    Content = "Voice note 🎤",
                    MediaUrl = result.GetProperty("mediaUrl").GetString(),
                    VoiceDurationSeconds = result.TryGetProperty("voiceDurationSeconds", out var dur) ? dur.GetDouble() : 5,
                    Timestamp = DateTime.UtcNow,
                    IsRead = false
                };
                allLoadedMessages.Add(msg);
                visibleChatMessages.Add(msg);
                await InvokeAsync(StateHasChanged);
                await ScrollChatToBottomAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling voice note completion callback");
        }
    }

