    private async Task SendTextMessage()
    {
        if (string.IsNullOrWhiteSpace(chatInputText)) return;

        var text = chatInputText.Trim();
        chatInputText = "";

        var req = new SendTextOrStickerRequest
        {
            SenderName = currentSender,
            MessageType = "text",
            Content = text
        };

        var created = await ApiClient.SendTextOrStickerAsync(req);
        if (created != null)
        {
            if (!allLoadedMessages.Any(m => m.Id == created.Id))
            {
                allLoadedMessages.Add(created);
            }
            if (!visibleChatMessages.Any(m => m.Id == created.Id))
            {
                visibleChatMessages.Add(created);
            }
            StateHasChanged();
            await ScrollChatToBottomAsync();
        }
    }

