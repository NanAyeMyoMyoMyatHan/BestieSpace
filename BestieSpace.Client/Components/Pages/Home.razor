@page "/"
@rendermode InteractiveServer
@inject IBestieApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Home> Logger
@inject BestieAuthenticationStateProvider AuthProvider
@implements IAsyncDisposable

<PageTitle>BestieSpace 🌸 | Our Secret Cozy Space</PageTitle>

<!-- =========================================================
     STEP 0: CUTE SECRET BESTIE LOGIN SCREEN (If not signed in)
     ========================================================= -->
@if (currentUserSession == null)
{
    <div class="login-gate-overlay">
        <div class="login-card @(isLoginWiggling ? "kawaii-wiggle" : "")">
            <!-- Floating Stickers -->
            <div class="floating-sticker sticker-1">🎀</div>
            <div class="floating-sticker sticker-2">✨</div>
            <div class="floating-sticker sticker-3">🧸</div>
            <div class="floating-sticker sticker-4">💖</div>

            <div class="login-header-icon">🍓✨</div>
            <h1 class="login-title">Secret Bestie Clubhouse</h1>
            <p class="login-subtitle">
                Enter your 4-digit strawberry PIN or secret password to unlock our cozy world 💕
            </p>

            <!-- Prominent Register CTA Banner -->
            <div class="login-register-banner">
                <span>🌸 New to BestieSpace?</span>
                <a href="/register" class="btn-register-link">Register Account Here ✨</a>
            </div>

            <!-- Login Tabs: PIN Pad vs Password vs Register -->
            <div class="login-tabs-nav">
                <button type="button" class="login-tab-btn @(activeLoginTab == "pin" ? "active" : "")" 
                        @onclick='() => { activeLoginTab = "pin"; loginErrorMessage = null; }'>
                    <span>🍓</span> Cute PIN Pad
                </button>
                <button type="button" class="login-tab-btn @(activeLoginTab == "password" ? "active" : "")" 
                        @onclick='() => { activeLoginTab = "password"; loginErrorMessage = null; }'>
                    <span>🔑</span> Password
                </button>
                <a href="/register" class="login-tab-btn register-tab-btn" title="Create a new account">
                    <span>✨</span> Register
                </a>
            </div>

            @if (!string.IsNullOrWhiteSpace(loginErrorMessage))
            {
                <div class="login-error-badge">
                    <span>🥺</span>
                    <span>@loginErrorMessage</span>
                </div>
            }

            @if (activeLoginTab == "pin")
            {
                <!-- Strawberry PIN Pad View -->
                <div class="strawberry-pin-container">
                    <div class="pin-slots-row @(isPinWiggling ? "kawaii-wiggle" : "")">
                        <div class="pin-slot @(enteredPin.Length >= 1 ? "filled" : "")">
                            @if (enteredPin.Length >= 1)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                        <div class="pin-slot @(enteredPin.Length >= 2 ? "filled" : "")">
                            @if (enteredPin.Length >= 2)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                        <div class="pin-slot @(enteredPin.Length >= 3 ? "filled" : "")">
                            @if (enteredPin.Length >= 3)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                        <div class="pin-slot @(enteredPin.Length >= 4 ? "filled" : "")">
                            @if (enteredPin.Length >= 4)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                    </div>

                    <div class="strawberry-keypad">
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("1")'>1</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("2")'>2</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("3")'>3</button>

                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("4")'>4</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("5")'>5</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("6")'>6</button>

                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("7")'>7</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("8")'>8</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("9")'>9</button>

                        <button type="button" class="keypad-btn keypad-btn-special" @onclick="ClearPin" title="Clear PIN">Clear 🌸</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("0")'>0</button>
                        <button type="button" class="keypad-btn keypad-btn-special" @onclick="ToggleHintBox" title="Need a hint?">Hint 💡</button>
                    </div>

                    <div class="pin-hint-tag">
                        <span>Tap your 4-digit secret PIN to unlock automatically ✨</span>
                    </div>
                </div>
            }
            else
            {
                <!-- Secret Password Form View -->
                <div class="login-input-group">
                    <div class="login-field">
                        <label class="login-label">Cute Nickname or Email</label>
                        <div class="login-input-box">
                            <span class="login-input-icon">🍓</span>
                            <input type="text" 
                                   class="login-input" 
                                   placeholder="e.g., strawberry_bestie or email" 
                                   @bind="loginUsername" 
                                   @bind:event="oninput"
                                   @onkeydown="HandleLoginKeyDown" />
                        </div>
                    </div>

                    <div class="login-field">
                        <label class="login-label">Secret Password</label>
                        <div class="login-input-box">
                            <span class="login-input-icon">🗝️</span>
                            <input type="@(showPassword ? "text" : "password")" 
                                   class="login-input" 
                                   placeholder="••••••••" 
                                   @bind="loginPassword" 
                                   @bind:event="oninput"
                                   @onkeydown="HandleLoginKeyDown" />
                            <button type="button" class="login-toggle-eye" @onclick="() => showPassword = !showPassword" title="Show/Hide Password">
                                @(showPassword ? "👀" : "🫣")
                            </button>
                        </div>
                    </div>
                </div>

                <button class="login-btn-primary" @onclick="HandleLoginAsync" disabled="@isLoggingIn">
                    @if (isLoggingIn)
                    {
                        <span>Checking secret code... 🌸</span>
                    }
                    else
                    {
                        <span>Unlock Clubhouse 💖 ✨</span>
                    }
                </button>
            }

            <!-- VIP Pass & Hint Helper Row -->
            <div class="login-hint-section">
                <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-bottom: 8px;">
                    <button type="button" class="btn-vip-ticket-shortcut" @onclick="() => showVipModal = true">
                        <span>🎟️</span>
                        <span>View VIP Pass</span>
                    </button>
                    <button type="button" class="login-hint-trigger" @onclick="ToggleHintBox">
                        <span>💡</span>
                        <span>Need Help Signing In?</span>
                    </button>
                </div>

                @if (showHintBox)
                {
                    <div class="login-hint-box">
                        <div class="login-hint-title">
                            <span>✨ Account Sign In Information:</span>
                        </div>
                        <div style="margin-top: 6px; line-height: 1.5; font-size: 0.88rem; color: #5C4A4C;">
                            You can sign in using your registered <strong>Username or Email</strong> and secret password, or enter your 4-digit PIN! 🌸<br />
                            If you don't have an account yet, <a href="/register" style="color: #FB6F92; font-weight: 700;">click here to register</a> and create your custom bestie profile! 💕
                        </div>
                    </div>
                }

                <div style="text-align: center; margin-top: 14px; padding-top: 10px; border-top: 1px dashed rgba(255, 143, 171, 0.4);">
                    <a href="/register" style="color: #FB6F92; font-weight: 700; text-decoration: none; font-size: 0.95rem; display: inline-flex; align-items: center; gap: 6px;">
                        <span>✨</span>
                        <span>Don't have an account yet? Click here to Register! 🌸</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<!-- =========================================================
     STEP 1: INTERACTIVE WELCOME GATE
     ========================================================= -->
<div class="welcome-gate-overlay @(isGateOpen || currentUserSession == null ? "gate-hidden" : "")">
    <div class="welcome-card">
        <div class="floating-sticker sticker-1">🎀</div>
        <div class="floating-sticker sticker-2">✨</div>
        <div class="floating-sticker sticker-3">🧸</div>
        <div class="floating-sticker sticker-4">💖</div>

        <div class="welcome-icon-box">
            <span>💌</span>
        </div>

        <h1 class="welcome-title">Hi My Sweet @(currentUserSession?.DisplayName ?? "Bestie")!</h1>
        <p class="welcome-subtitle">
            Welcome to our cozy, pastel clubhouse. <br />
            Packed with our photos, heartfelt letters, secret envelopes, and live chat!
        </p>

        <button class="welcome-btn" @onclick="OpenWelcomeGate">
            <span>Click to enter our clubhouse 💌</span>
            <span style="font-size: 1.4rem;">✨</span>
        </button>
    </div>
</div>

<!-- =========================================================
     STEP 2: MAIN DASHBOARD EXPERIENCE
     ========================================================= -->
<div class="main-wrapper" style="@(isGateOpen && currentUserSession != null ? "opacity: 1;" : "opacity: 0.05; pointer-events: none;") transition: opacity 0.6s ease;">
    
    <!-- Top Header -->
    <header class="kawaii-header">
        <div class="brand-badge">
            <span>🌸</span>
            <span>Est. 2026 • Forever & Always</span>
            <span>🎀</span>
        </div>
        <h1 class="brand-title">Bestie<span>Space</span> 💕</h1>
        <p class="brand-tagline">Our secret digital memory box & real-time clubhouse</p>
    </header>

    <!-- SECTION 1: HEARTFELT LETTER & MISS YOU METER -->
    <section class="letter-section" id="letter-section">
        <div class="stationery-card">
            <div class="washi-tape-top"></div>

            <div class="letter-header">
                <div class="letter-title">
                    <span>💌</span>
                    <span>@(dashboard?.AppStats.MainLetterTitle ?? "To My Favorite Human in the Entire World 🌸")</span>
                </div>
                <div class="letter-from-to">
                    <span>With all my love: @(dashboard?.AppStats.SenderNickname ?? "Me 🎀") ➜ @(dashboard?.AppStats.RecipientNickname ?? "Bestie 🌸")</span>
                </div>
            </div>

            <div class="letter-content">
                @(dashboard?.AppStats.MainLetterContent ?? "Loading our heartfelt letter...")
            </div>

            <!-- Miss You Meter Box -->
            <div class="miss-you-box">
                <div class="miss-you-info">
                    <div class="miss-you-counter-badge">
                        <div class="miss-you-counter-number">@missYouCount</div>
                        <div class="miss-you-counter-label">Hugs Sent 💖</div>
                    </div>
                    <div class="miss-you-desc">
                        <div class="miss-you-desc-title">The Live Miss-You Meter 🌸</div>
                        <div class="miss-you-desc-text">
                            Every time you miss me, tap the button! It syncs in real time across the database and sends warm virtual hugs!
                        </div>
                    </div>
                </div>

                <button class="btn-miss-you-hug" @onclick="HandleMissYouClick">
                    <span>I Miss You Too! 💖</span>
                    <span style="font-size: 1.4rem;">🧸</span>
                </button>
            </div>
        </div>
    </section>

    <!-- SECTION 2: CLUBHOUSE FEATURE MENU GRID -->
    <section class="features-menu-section">
        <div class="section-header-center">
            <span class="badge-pill-kawaii">🌸 Clubhouse Navigation Menu</span>
            <h2 class="section-title">Explore BestieSpace Features</h2>
            <p class="section-subtitle">Everything is organized cleanly into dedicated spaces for you and your besties 💕</p>
        </div>

        <div class="features-cards-grid">
            <!-- Feature 1: Polaroid Photos -->
            <div class="feature-menu-card" @onclick='() => Navigation.NavigateTo("/photos")'>
                <div class="feature-card-header">
                    <span class="feature-card-icon">📸</span>
                    <span class="feature-badge">@(dashboard?.Memories.Count ?? 0) Memories</span>
                </div>
                <h3 class="feature-card-title">Polaroid Memories</h3>
                <p class="feature-card-desc">
                    Browse our photo albums pinned with washi tape and cute stickers. Upload new photos and view zoomable polaroids.
                </p>
                <div class="feature-card-footer">
                    <a href="/photos" class="btn-feature-link" @onclick:stopPropagation="true">
                        <span>Open Photo Album 📸</span>
                    </a>
                </div>
            </div>

            <!-- Feature 2: Secret Notes -->
            <div class="feature-menu-card" @onclick='() => Navigation.NavigateTo("/notes")'>
                <div class="feature-card-header">
                    <span class="feature-card-icon">✉️</span>
                    <span class="feature-badge">@(dashboard?.SecretNotes.Count(n => n.IsUnlocked) ?? 0) / @(dashboard?.SecretNotes.Count ?? 0) Opened</span>
                </div>
                <h3 class="feature-card-title">Mystery Envelopes</h3>
                <p class="feature-card-desc">
                    Break the wax seal on surprise letters and heartfelt handwritten notes created just for your eyes.
                </p>
                <div class="feature-card-footer">
                    <a href="/notes" class="btn-feature-link" @onclick:stopPropagation="true">
                        <span>Open Secret Notes ✉️</span>
                    </a>
                </div>
            </div>

            <!-- Feature 3: Private Chat -->
            <div class="feature-menu-card" @onclick='() => Navigation.NavigateTo("/chat")'>
                <div class="feature-card-header">
                    <span class="feature-card-icon">💬</span>
                    <span class="feature-badge badge-signalr">⚡ Live SignalR</span>
                </div>
                <h3 class="feature-card-title">Clubhouse & Circle Chat</h3>
                <p class="feature-card-desc">
                    Real-time private group chats with photo sharing, cute sticker trays, audio voice messages, and per-user read receipts.
                </p>
                <div class="feature-card-footer">
                    <a href="/chat" class="btn-feature-link" @onclick:stopPropagation="true">
                        <span>Enter Chat Room 💬</span>
                    </a>
                </div>
            </div>

            <!-- Feature 4: Bestie Circles -->
            <div class="feature-menu-card" @onclick='() => Navigation.NavigateTo("/circles")'>
                <div class="feature-card-header">
                    <span class="feature-card-icon">👑</span>
                    <span class="feature-badge">Up to 9 Besties</span>
                </div>
                <h3 class="feature-card-title">Bestie Circles</h3>
                <p class="feature-card-desc">
                    Manage private friend circles. Invite close friends, view membership rosters, and customize circle icons and details.
                </p>
                <div class="feature-card-footer">
                    <a href="/circles" class="btn-feature-link" @onclick:stopPropagation="true">
                        <span>Manage Circles 👑</span>
                    </a>
                </div>
            </div>

            <!-- Feature 5: Friends & Profile -->
            <div class="feature-menu-card" @onclick='() => Navigation.NavigateTo("/friends")'>
                <div class="feature-card-header">
                    <span class="feature-card-icon">👭</span>
                    <span class="feature-badge">Social Hub</span>
                </div>
                <h3 class="feature-card-title">Friends & Profiles</h3>
                <p class="feature-card-desc">
                    Search for besties, manage incoming friend requests, update your display name, bio, and choose your favorite avatar sticker.
                </p>
                <div class="feature-card-footer">
                    <a href="/friends" class="btn-feature-link" @onclick:stopPropagation="true">
                        <span>View Friends Hub 👭</span>
                    </a>
                </div>
            </div>

            <!-- Feature 6: VIP Pass Keepsake -->
            <div class="feature-menu-card card-vip-keepsake" @onclick="() => showVipModal = true">
                <div class="feature-card-header">
                    <span class="feature-card-icon">🎟️</span>
                    <span class="feature-badge">Keepsake Pass</span>
                </div>
                <h3 class="feature-card-title">Official VIP Pass</h3>
                <p class="feature-card-desc">
                    View, copy, or print your official Bestie Clubhouse VIP Pass to invite your best friends into your cozy circle!
                </p>
                <div class="feature-card-footer">
                    <button type="button" class="btn-feature-link btn-vip-link" @onclick:stopPropagation="true" @onclick="() => showVipModal = true">
                        <span>View VIP Pass 🎟️</span>
                    </button>
                </div>
            </div>
        </div>
    </section>

</div>

<!-- =========================================================
     MODAL: CUTE VIP INVITATION PASS
     ========================================================= -->
@if (showVipModal)
{
    <div class="kawaii-modal-backdrop" @onclick="() => showVipModal = false">
        <div class="vip-ticket-modal-card" @onclick:stopPropagation="true">
            <button class="modal-close-btn" @onclick="() => showVipModal = false">✕</button>

            <!-- Printable Keepsake Ticket -->
            <div id="vip-printable-ticket" class="vip-ticket">
                <div class="vip-ticket-header">
                    <div class="vip-ticket-brand">🍓 BestieSpace VIP Pass</div>
                    <span class="vip-ticket-badge">Official Invitation</span>
                </div>

                <div class="vip-ticket-body">
                    <div class="vip-info-cell">
                        <div class="vip-info-label">VIP Member</div>
                        <div class="vip-info-val">@(currentUserSession?.DisplayName ?? "Sweet Bestie 🌸")</div>
                    </div>
                    <div class="vip-info-cell">
                        <div class="vip-info-label">Nickname</div>
                        <div class="vip-info-val">@(currentUserSession?.Username ?? "strawberry_bestie")</div>
                    </div>
                    <div class="vip-info-cell">
                        <div class="vip-info-label">Access Level</div>
                        <div class="vip-info-val">Clubhouse VIP 💖</div>
                    </div>
                    <div class="vip-info-cell">
                        <div class="vip-info-label">Quick PIN</div>
                        <div class="vip-info-val vip-pin-highlight">@(string.Join(" ", (currentUserSession?.QuickPin ?? "3000").ToCharArray())) 🍓</div>
                    </div>
                </div>

                <div class="vip-ticket-barcode-row">
                    <div class="vip-barcode">|| | ||| || ||| | |||</div>
                    <div style="font-size: 0.72rem; color: var(--text-cocoa-light); font-weight: 700;">
                        VIP-BESTIE-CLUBHOUSE-2026
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="vip-modal-actions">
                <button type="button" class="btn-vip-action btn-vip-copy" @onclick="CopyVipTicketAsync">
                    <span>📋 Copy Invite Message</span>
                </button>
                <button type="button" class="btn-vip-action btn-vip-print" @onclick="PrintVipTicketAsync">
                    <span>🖨️ Print / Save Ticket</span>
                </button>
            </div>

            @if (isTicketCopied)
            {
                <div style="text-align: center;">
                    <div class="toast-pill-copied">
                        <span>✨ Copied to clipboard! Send it to your bestie 💕</span>
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
/* Dashboard Specific Styles */
.features-menu-section {
    max-width: 1100px;
    margin: 40px auto 80px auto;
    padding: 0 20px;
}

.section-header-center {
    text-align: center;
    margin-bottom: 32px;
}

.badge-pill-kawaii {
    display: inline-block;
    background: #FFF0F5;
    color: #FB6F92;
    border: 1.5px solid #FFC2D1;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 6px 16px;
    border-radius: 9999px;
    margin-bottom: 12px;
}

.section-header-center .section-title {
    color: #4A3B3C;
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 6px;
}

.section-header-center .section-subtitle {
    color: #7E6566;
    font-size: 1.05rem;
}

.features-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 28px;
}

.feature-menu-card {
    background: linear-gradient(135deg, #FFFFFF 0%, #FFFDF9 100%);
    border: 3px solid #FFC2D1;
    border-radius: 26px;
    padding: 26px 24px;
    box-shadow: 0 10px 24px rgba(255, 143, 171, 0.16);
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease, border-color 0.25s ease;
    display: flex;
    flex-direction: column;
}

.feature-menu-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 16px 36px rgba(251, 111, 146, 0.28);
    border-color: #FB6F92;
}

.feature-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}

.feature-card-icon {
    font-size: 2.4rem;
    background: #FFF0F5;
    width: 58px;
    height: 58px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #FFC2D1;
    transition: transform 0.2s ease;
}

.feature-menu-card:hover .feature-card-icon {
    transform: scale(1.1) rotate(5deg);
}

.feature-badge {
    background: #FFF0F5;
    color: #FB6F92;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 9999px;
    border: 1px solid #FFC2D1;
}

.feature-badge.badge-signalr {
    background: #E2F0CB;
    color: #4A6B2C;
    border-color: #C5E1A5;
}

.feature-card-title {
    color: #4A3B3C;
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 8px;
}

.feature-card-desc {
    color: #7E6566;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 20px;
    flex: 1;
}

.feature-card-footer {
    margin-top: auto;
}

.btn-feature-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background: linear-gradient(135deg, #FF8FAB 0%, #FB6F92 100%);
    color: #FFFFFF !important;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 12px;
    border-radius: 14px;
    box-shadow: 0 4px 14px rgba(251, 111, 146, 0.3);
    transition: transform 0.2s, box-shadow 0.2s;
    border: none;
    cursor: pointer;
}

.btn-feature-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(251, 111, 146, 0.45);
}

.btn-vip-link {
    background: linear-gradient(135deg, #FFB703 0%, #FB8500 100%);
    box-shadow: 0 4px 14px rgba(251, 133, 0, 0.3);
}

.btn-vip-link:hover {
    box-shadow: 0 6px 18px rgba(251, 133, 0, 0.45);
}
</style>

@code {
    private DashboardDto? dashboard;
    private int missYouCount = 0;
    private bool isGateOpen = false;

    // Login Gate State
    private UserSessionDto? currentUserSession;
    private string activeLoginTab = "pin";
    private string enteredPin = "";
    private string loginUsername = "";
    private string loginPassword = "";
    private bool showPassword = false;
    private string? loginErrorMessage;
    private bool isLoggingIn = false;
    private bool isPinLoggingIn = false;
    private bool isPinWiggling = false;
    private bool isLoginWiggling = false;
    private bool showHintBox = false;

    // Hub and Modals
    private HubConnection? hubConnection;
    private bool showVipModal = false;
    private bool isTicketCopied = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (AuthProvider.CurrentUser != null)
        {
            currentUserSession = AuthProvider.CurrentUser;
            isGateOpen = true;
        }

        await LoadDashboardAsync();
        await InitializeSignalRAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && currentUserSession == null)
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            if (AuthProvider.CurrentUser != null)
            {
                currentUserSession = AuthProvider.CurrentUser;
                isGateOpen = true;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadDashboardAsync()
    {
        try
        {
            dashboard = await ApiClient.GetDashboardAsync();
            if (dashboard?.AppStats != null)
            {
                missYouCount = dashboard.AppStats.MissYouCount;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load dashboard statistics");
        }
    }

    private async Task InitializeSignalRAsync()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/bestieChat"))
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<int>("UpdateMissYouCount", (count) =>
            {
                missYouCount = count;
                InvokeAsync(StateHasChanged);
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to connect SignalR in Home dashboard");
        }
    }

    private async Task AppendPinDigit(string digit)
    {
        if (isPinLoggingIn || enteredPin.Length >= 4) return;
        enteredPin += digit;
        StateHasChanged();

        if (enteredPin.Length == 4)
        {
            await HandlePinSubmitAsync(enteredPin);
        }
    }

    private void ClearPin()
    {
        enteredPin = "";
        loginErrorMessage = null;
        StateHasChanged();
    }

    private async Task HandlePinSubmitAsync(string pinToVerify)
    {
        isPinLoggingIn = true;
        loginErrorMessage = null;
        StateHasChanged();

        try
        {
            var res = await AuthProvider.PinLoginAsync(pinToVerify);

            if (res.IsSuccess && res.User != null)
            {
                currentUserSession = res.User;
                isGateOpen = true;
                await JSRuntime.InvokeVoidAsync("bestieAnimations.playCutePopSound");
                await JSRuntime.InvokeVoidAsync("bestieAnimations.triggerConfettiBurst");
                enteredPin = "";
            }
            else
            {
                loginErrorMessage = res.Message ?? "Oopsie! Wrong strawberry PIN 🍓🥺 Try again!";
                isPinWiggling = true;
                StateHasChanged();
                await Task.Delay(600);
                isPinWiggling = false;
                enteredPin = "";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "PIN login error");
            loginErrorMessage = "Oopsie! Wrong strawberry PIN 🍓🥺 Try again!";
            isPinWiggling = true;
            StateHasChanged();
            await Task.Delay(600);
            isPinWiggling = false;
            enteredPin = "";
        }
        finally
        {
            isPinLoggingIn = false;
            StateHasChanged();
        }
    }

    private async Task HandleLoginAsync()
    {
        if (string.IsNullOrWhiteSpace(loginUsername) || string.IsNullOrWhiteSpace(loginPassword))
        {
            loginErrorMessage = "Please type your cute nickname/email and secret password! 🌸";
            TriggerWiggle();
            return;
        }

        isLoggingIn = true;
        loginErrorMessage = null;
        StateHasChanged();

        try
        {
            var res = await AuthProvider.LoginAsync(loginUsername.Trim(), loginPassword);

            if (res.IsSuccess && res.User != null)
            {
                currentUserSession = res.User;
                isGateOpen = true;
                await JSRuntime.InvokeVoidAsync("bestieAnimations.playCutePopSound");
                await JSRuntime.InvokeVoidAsync("bestieAnimations.triggerConfettiBurst");
            }
            else
            {
                loginErrorMessage = res.Message ?? "Incorrect nickname or secret password. Please try again! 🥺";
                TriggerWiggle();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Password login error");
            loginErrorMessage = "Incorrect nickname or secret password. Please try again! 🥺";
            TriggerWiggle();
        }
        finally
        {
            isLoggingIn = false;
            StateHasChanged();
        }
    }

    private async Task HandleLoginKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLoginAsync();
        }
    }

    private void ToggleHintBox()
    {
        showHintBox = !showHintBox;
    }

    private void TriggerWiggle()
    {
        isLoginWiggling = true;
        _ = Task.Run(async () =>
        {
            await Task.Delay(550);
            isLoginWiggling = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task OpenWelcomeGate()
    {
        isGateOpen = true;
        await JSRuntime.InvokeVoidAsync("bestieAnimations.triggerConfettiBurst");
    }

    private async Task HandleMissYouClick()
    {
        missYouCount++;
        try
        {
            await JSRuntime.InvokeVoidAsync("bestieAnimations.playCutePopSound");
            await JSRuntime.InvokeVoidAsync("bestieAnimations.triggerConfettiBurst");
        }
        catch { }

        try
        {
            var res = await ApiClient.IncrementMissYouAsync();
            if (res != null)
            {
                missYouCount = res.MissYouCount;
            }

            if (hubConnection != null && hubConnection.State == HubConnectionState.Connected)
            {
                await hubConnection.SendAsync("SendMissYouHug", missYouCount);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to increment miss you count via API");
        }
    }

    private async Task CopyVipTicketAsync()
    {
        try
        {
            var invite = "🍓✨ --- OFFICIAL VIP PASS: BESTIE CLUBHOUSE --- ✨🍓\n"
                       + $"🌸 Member: {currentUserSession?.DisplayName ?? "Sweet Bestie 🌸"}\n"
                       + $"🍓 Nickname: {currentUserSession?.Username ?? "strawberry_bestie"}\n"
                       + $"🎀 4-Digit Quick-PIN: {currentUserSession?.QuickPin ?? "3000"} 🍓\n"
                       + "💌 Welcome to our cozy clubhouse! 💕";
            await JSRuntime.InvokeVoidAsync("bestieTicket.copyText", invite);
            isTicketCopied = true;
            StateHasChanged();
            _ = Task.Delay(2500).ContinueWith(_ =>
            {
                isTicketCopied = false;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error copying VIP ticket");
        }
    }

    private async Task PrintVipTicketAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("bestieTicket.printTicket");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error printing VIP ticket");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            try
            {
                await hubConnection.DisposeAsync();
            }
            catch { }
        }
    }
}
