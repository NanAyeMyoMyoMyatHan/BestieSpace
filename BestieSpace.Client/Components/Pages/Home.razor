    private string GetFullMediaUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "/images/sample-memories/photobooth.svg";
        if (url.StartsWith("http://") || url.StartsWith("https://") || url.StartsWith("data:")) return url;
        return url;
    }

