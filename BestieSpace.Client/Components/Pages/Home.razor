@page "/"
@rendermode InteractiveServer
@inject IBestieApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Home> Logger
@inject BestieAuthenticationStateProvider AuthProvider
@implements IAsyncDisposable

<PageTitle>BestieSpace 🌸 | Our Secret Cozy Space</PageTitle>

<!-- =========================================================
     STEP 0: CUTE SECRET BESTIE LOGIN SCREEN (If not signed in)
     ========================================================= -->
@if (currentUserSession == null)
{
    <div class="login-gate-overlay">
        <div class="login-card @(isLoginWiggling ? "kawaii-wiggle" : "")">
            <!-- Floating Stickers -->
            <div class="floating-sticker sticker-1">🎀</div>
            <div class="floating-sticker sticker-2">✨</div>
            <div class="floating-sticker sticker-3">🧸</div>
            <div class="floating-sticker sticker-4">💖</div>

            <div class="login-header-icon">🍓✨</div>
            <h1 class="login-title" tabindex="-1">Secret Bestie Clubhouse</h1>
            <p class="login-subtitle">
                Enter your 4-digit strawberry PIN or secret password to unlock our cozy world 💕
            </p>

            <!-- Prominent Register CTA Banner -->
            <div class="login-register-banner">
                <span>🌸 New to BestieSpace?</span>
                <a href="/register" class="btn-register-link">Register Account Here ✨</a>
            </div>

            <!-- Login Tabs: PIN Pad vs Password vs Register -->
            <div class="login-tabs-nav">
                <button type="button" class="login-tab-btn @(activeLoginTab == "pin" ? "active" : "")" 
                        @onclick='() => { activeLoginTab = "pin"; loginErrorMessage = null; }'>
                    <span>🍓</span> Cute PIN Pad
                </button>
                <button type="button" class="login-tab-btn @(activeLoginTab == "password" ? "active" : "")" 
                        @onclick='() => { activeLoginTab = "password"; loginErrorMessage = null; }'>
                    <span>🔑</span> Password
                </button>
                <a href="/register" class="login-tab-btn register-tab-btn" title="Create a new account">
                    <span>✨</span> Register
                </a>
            </div>

            @if (!string.IsNullOrWhiteSpace(loginErrorMessage))
            {
                <div class="login-error-badge">
                    <span>🥺</span>
                    <span>@loginErrorMessage</span>
                </div>
            }

            @if (activeLoginTab == "pin")
            {
                <!-- Strawberry PIN Pad View -->
                <div class="strawberry-pin-container">
                    <div class="pin-slots-row @(isPinWiggling ? "kawaii-wiggle" : "")">
                        <div class="pin-slot @(enteredPin.Length >= 1 ? "filled" : "")">
                            @if (enteredPin.Length >= 1)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                        <div class="pin-slot @(enteredPin.Length >= 2 ? "filled" : "")">
                            @if (enteredPin.Length >= 2)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                        <div class="pin-slot @(enteredPin.Length >= 3 ? "filled" : "")">
                            @if (enteredPin.Length >= 3)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                        <div class="pin-slot @(enteredPin.Length >= 4 ? "filled" : "")">
                            @if (enteredPin.Length >= 4)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                    </div>

                    <div class="strawberry-keypad">
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("1")'>1</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("2")'>2</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("3")'>3</button>

                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("4")'>4</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("5")'>5</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("6")'>6</button>

                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("7")'>7</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("8")'>8</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("9")'>9</button>

                        <button type="button" class="keypad-btn keypad-btn-special" @onclick="ClearPin" title="Clear PIN">Clear 🌸</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("0")'>0</button>
                        <button type="button" class="keypad-btn keypad-btn-special" @onclick="ToggleHintBox" title="Need a hint?">Hint 💡</button>
                    </div>

                    <div class="pin-hint-tag">
                        <span>Tap your 4-digit secret PIN to unlock automatically ✨</span>
                    </div>
                </div>
            }
            else
            {
                <!-- Secret Password Form View -->
                <div class="login-input-group">
                    <div class="login-field">
                        <label class="login-label">Cute Nickname or Email</label>
                        <div class="login-input-box">
                            <span class="login-input-icon">🍓</span>
                            <input type="text" 
                                   class="login-input" 
                                   placeholder="e.g., strawberry_bestie or email" 
                                   @bind="loginUsername" 
                                   @bind:event="oninput"
                                   @onkeydown="HandleLoginKeyDown" />
                        </div>
                    </div>

                    <div class="login-field">
                        <label class="login-label">Secret Password</label>
                        <div class="login-input-box">
                            <span class="login-input-icon">🗝️</span>
                            <input type="@(showPassword ? "text" : "password")" 
                                   class="login-input" 
                                   placeholder="••••••••" 
                                   @bind="loginPassword" 
                                   @bind:event="oninput"
                                   @onkeydown="HandleLoginKeyDown" />
                            <button type="button" class="login-toggle-eye" @onclick="() => showPassword = !showPassword" title="Show/Hide Password">
                                @(showPassword ? "👀" : "🫣")
                            </button>
                        </div>
                    </div>
                </div>

                <button class="login-btn-primary" @onclick="HandleLoginAsync" disabled="@isLoggingIn">
                    @if (isLoggingIn)
                    {
                        <span>Checking secret code... 🌸</span>
                    }
                    else
                    {
                        <span>Unlock Clubhouse 💖 ✨</span>
                    }
                </button>
            }

            <!-- VIP Pass & Hint Helper Row -->
            <div class="login-hint-section">
                <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-bottom: 8px;">
                    <button type="button" class="btn-vip-ticket-shortcut" @onclick="() => showVipModal = true">
                        <span>🎟️</span>
                        <span>View VIP Pass</span>
                    </button>
                    <button type="button" class="login-hint-trigger" @onclick="ToggleHintBox">
                        <span>💡</span>
                        <span>Need Help Signing In?</span>
                    </button>
                </div>

                @if (showHintBox)
                {
                    <div class="login-hint-box">
                        <div class="login-hint-title">
                            <span>✨ Account Sign In Information:</span>
                        </div>
                        <div style="margin-top: 6px; line-height: 1.5; font-size: 0.88rem; color: #5C4A4C;">
                            You can sign in using your registered <strong>Username or Email</strong> and secret password, or enter your 4-digit PIN! 🌸<br />
                            If you don't have an account yet, <a href="/register" style="color: #FB6F92; font-weight: 700;">click here to register</a> and create your custom bestie profile! 💕
                        </div>
                    </div>
                }

                <div style="text-align: center; margin-top: 14px; padding-top: 10px; border-top: 1px dashed rgba(255, 143, 171, 0.4);">
                    <a href="/register" style="color: #FB6F92; font-weight: 700; text-decoration: none; font-size: 0.95rem; display: inline-flex; align-items: center; gap: 6px;">
                        <span>✨</span>
                        <span>Don't have an account yet? Click here to Register! 🌸</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<!-- =========================================================
     MAIN SCRAPBOOK 6-CARD DASHBOARD EXPERIENCE
     ========================================================= -->
@if (currentUserSession != null)
{
    <div class="home-scrapbook-wrapper">
        <div class="home-scrapbook-grid">
            <!-- Card 1: Polaroid Memories -->
            <div class="scrapbook-feature-card" @onclick='() => Navigation.NavigateTo("/photos")'>
                <div class="deco-checkered-tape tape-top-left" aria-hidden="true"></div>
                <div class="deco-heart-sticker sticker-bottom-left" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 100 100" fill="none">
                        <path d="M50 88C50 88 12 62 12 36C12 21 24 12 36 12C43 12 47 16 50 20C53 16 57 12 64 12C76 12 88 21 88 36C88 62 50 88 50 88Z" fill="#FFFFFF" filter="drop-shadow(0 2px 5px rgba(251,111,146,0.35))" />
                        <path d="M50 82C50 82 18 58 18 36C18 24 27 18 36 18C42 18 46 22 50 26C54 22 58 18 64 18C73 18 82 24 82 36C82 58 50 82 50 82Z" fill="#FFAFCC" stroke="#FF8FAB" stroke-width="2" />
                        <ellipse cx="35" cy="45" rx="4" ry="3" fill="#FF6584" opacity="0.6" />
                        <ellipse cx="65" cy="45" rx="4" ry="3" fill="#FF6584" opacity="0.6" />
                    </svg>
                </div>

                <div class="card-top-row">
                    <div class="card-icon-frame">
                        <span>📷</span>
                    </div>
                    <div class="card-pill-badge">
                        <span>@(dashboard?.Memories.Count ?? 6) Memories 💖</span>
                    </div>
                </div>

                <h2 class="card-title">Polaroid Memories</h2>
                <p class="card-description">
                    Browse our photo albums pinned with washi tape and cute stickers. Upload new photos and view zoomable polaroids.
                </p>

                <button type="button" class="btn-card-action" @onclick:stopPropagation="true" @onclick='() => Navigation.NavigateTo("/photos")'>
                    <span>Open Photo Album 📸</span>
                </button>
            </div>

            <!-- Card 2: Mystery Envelopes -->
            <div class="scrapbook-feature-card" @onclick='() => Navigation.NavigateTo("/notes")'>
                <div class="deco-checkered-tape tape-top-right" aria-hidden="true"></div>
                <div class="deco-sakura-sticker sticker-bottom-right" aria-hidden="true">
                    <svg width="34" height="34" viewBox="0 0 100 100" fill="none">
                        <path d="M22 65 C12 60 14 46 26 48 C32 49 32 60 22 65 Z" fill="#A8D5BA" stroke="#FFFFFF" stroke-width="2.5" />
                        <circle cx="50" cy="50" r="32" fill="#FFFFFF" filter="drop-shadow(0 3px 6px rgba(251,111,146,0.3))" />
                        <path d="M50 20 C42 8 58 8 50 20 Z M76 38 C88 32 82 48 76 38 Z M68 70 C74 82 60 84 68 70 Z M32 70 C40 84 26 82 32 70 Z M24 38 C18 48 12 32 24 38 Z" fill="#FFB7C5" stroke="#FF8FAB" stroke-width="2" />
                        <circle cx="50" cy="50" r="14" fill="#FFE5EC" stroke="#FF6584" stroke-width="2" />
                        <circle cx="50" cy="50" r="6" fill="#FF8FAB" />
                    </svg>
                </div>

                <div class="card-top-row">
                    <div class="card-icon-frame">
                        <span>✉️</span>
                    </div>
                    <div class="card-pill-badge">
                        <span>@(dashboard?.SecretNotes.Count(n => n.IsUnlocked) ?? 2) / @(dashboard?.SecretNotes.Count ?? 2) Opened 🎀</span>
                    </div>
                </div>

                <h2 class="card-title">Mystery Envelopes</h2>
                <p class="card-description">
                    Break the wax seal on surprise letters and heartfelt handwritten notes created just for your eyes.
                </p>

                <button type="button" class="btn-card-action" @onclick:stopPropagation="true" @onclick='() => Navigation.NavigateTo("/notes")'>
                    <span>Open Secret Notes ✉️</span>
                </button>
            </div>

            <!-- Card 3: Clubhouse & Circle Chat -->
            <div class="scrapbook-feature-card" @onclick='() => Navigation.NavigateTo("/chat")'>
                <div class="deco-star-sticker sticker-top-right" aria-hidden="true">
                    <svg width="32" height="32" viewBox="0 0 100 100" fill="none">
                        <path d="M50 12 L61 36 L88 39 L68 58 L73 85 L50 71 L27 85 L32 58 L12 39 L39 36 Z" fill="#FFFFFF" stroke="#FFFFFF" stroke-width="6" stroke-linejoin="round" filter="drop-shadow(0 3px 6px rgba(255,183,77,0.35))" />
                        <path d="M50 16 L59 36 L82 39 L65 56 L69 80 L50 68 L31 80 L35 56 L18 39 L41 36 Z" fill="#FFE082" stroke="#FFB74D" stroke-width="2" stroke-linejoin="round" />
                        <circle cx="50" cy="48" r="3" fill="#FFFFFF" opacity="0.8" />
                    </svg>
                </div>

                <div class="card-top-row">
                    <div class="card-icon-frame">
                        <span>💬</span>
                    </div>
                    <div class="card-pill-badge badge-signalr">
                        <span>⚡ Live SignalR</span>
                    </div>
                </div>

                <h2 class="card-title">Clubhouse & Circle Chat</h2>
                <p class="card-description">
                    Real-time private group chats with photo sharing, cute sticker trays, audio voice messages, and per-user read receipts.
                </p>

                <button type="button" class="btn-card-action" @onclick:stopPropagation="true" @onclick='() => Navigation.NavigateTo("/chat")'>
                    <span>Enter Chat Room 💬</span>
                </button>
            </div>

            <!-- Card 4: Bestie Circles -->
            <div class="scrapbook-feature-card" @onclick='() => Navigation.NavigateTo("/circles")'>
                <div class="deco-paperclip-sticker sticker-top-left" aria-hidden="true">
                    <svg width="24" height="34" viewBox="0 0 24 34" fill="none">
                        <path d="M12 16 C12 16 5 11 5 6 C5 3 7.5 1 10.5 1 C12 1 12.5 2 13 3 C13.5 2 14 1 15.5 1 C18.5 1 21 3 21 6 C21 11 12 16 12 16" fill="#FF8FAB" stroke="#FFFFFF" stroke-width="1.8" filter="drop-shadow(0 2px 4px rgba(255,143,171,0.4))" />
                        <path d="M7 12 V24 C7 27.5 9 30 12 30 C15 30 17 27.5 17 24 V8 C17 6 15.5 4 13.5 4 C11.5 4 10 6 10 8 V23 C10 24.5 11 25.5 12 25.5 C13 25.5 14 24.5 14 23 V10" stroke="#FFCCD5" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </div>

                <div class="card-top-row">
                    <div class="card-icon-frame">
                        <span>👑</span>
                    </div>
                    <div class="card-pill-badge">
                        <span>Up to 9 Besties 🎀</span>
                    </div>
                </div>

                <h2 class="card-title">Bestie Circles</h2>
                <p class="card-description">
                    Manage private friend circles. Invite close friends, view membership rosters, and customize circle icons and details.
                </p>

                <button type="button" class="btn-card-action" @onclick:stopPropagation="true" @onclick='() => Navigation.NavigateTo("/circles")'>
                    <span>Manage Circles 👑</span>
                </button>
            </div>

            <!-- Card 5: Friends & Profiles -->
            <div class="scrapbook-feature-card" @onclick='() => Navigation.NavigateTo("/friends")'>
                <div class="deco-checkered-tape tape-top-right" aria-hidden="true"></div>
                <div class="deco-heart-sticker sticker-bottom-right" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 100 100" fill="none">
                        <path d="M50 88C50 88 12 62 12 36C12 21 24 12 36 12C43 12 47 16 50 20C53 16 57 12 64 12C76 12 88 21 88 36C88 62 50 88 50 88Z" fill="#FFFFFF" filter="drop-shadow(0 2px 5px rgba(251,111,146,0.35))" />
                        <path d="M50 82C50 82 18 58 18 36C18 24 27 18 36 18C42 18 46 22 50 26C54 22 58 18 64 18C73 18 82 24 82 36C82 58 50 82 50 82Z" fill="#FFAFCC" stroke="#FF8FAB" stroke-width="2" />
                        <ellipse cx="35" cy="45" rx="4" ry="3" fill="#FF6584" opacity="0.6" />
                        <ellipse cx="65" cy="45" rx="4" ry="3" fill="#FF6584" opacity="0.6" />
                    </svg>
                </div>

                <div class="card-top-row">
                    <div class="card-icon-frame">
                        <span>👭</span>
                    </div>
                    <div class="card-pill-badge">
                        <span>Social Hub 🌸</span>
                    </div>
                </div>

                <h2 class="card-title">Friends & Profiles</h2>
                <p class="card-description">
                    Search for besties, manage incoming friend requests, update your display name, bio, and choose your favorite avatar sticker.
                </p>

                <button type="button" class="btn-card-action" @onclick:stopPropagation="true" @onclick='() => Navigation.NavigateTo("/friends")'>
                    <span>View Friends Hub 👭</span>
                </button>
            </div>

            <!-- Card 6: Official VIP Pass -->
            <div class="scrapbook-feature-card" @onclick="() => showVipModal = true">
                <div class="deco-sakura-sticker sticker-top-right" aria-hidden="true">
                    <svg width="34" height="34" viewBox="0 0 100 100" fill="none">
                        <path d="M22 65 C12 60 14 46 26 48 C32 49 32 60 22 65 Z" fill="#A8D5BA" stroke="#FFFFFF" stroke-width="2.5" />
                        <circle cx="50" cy="50" r="32" fill="#FFFFFF" filter="drop-shadow(0 3px 6px rgba(251,111,146,0.3))" />
                        <path d="M50 20 C42 8 58 8 50 20 Z M76 38 C88 32 82 48 76 38 Z M68 70 C74 82 60 84 68 70 Z M32 70 C40 84 26 82 32 70 Z M24 38 C18 48 12 32 24 38 Z" fill="#FFB7C5" stroke="#FF8FAB" stroke-width="2" />
                        <circle cx="50" cy="50" r="14" fill="#FFE5EC" stroke="#FF6584" stroke-width="2" />
                        <circle cx="50" cy="50" r="6" fill="#FF8FAB" />
                    </svg>
                </div>

                <div class="card-top-row">
                    <div class="card-icon-frame">
                        <span>🎟️</span>
                    </div>
                    <div class="card-pill-badge">
                        <span>Keepsake Pass 🎀</span>
                    </div>
                </div>

                <h2 class="card-title">Official VIP Pass</h2>
                <p class="card-description">
                    View, copy, or print your official Bestie Clubhouse VIP Pass to invite your best friends into your cozy circle!
                </p>

                <button type="button" class="btn-card-action" @onclick:stopPropagation="true" @onclick="() => showVipModal = true">
                    <span>View VIP Pass 🎟️</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- =========================================================
     MODAL: CUTE VIP INVITATION PASS
     ========================================================= -->
@if (showVipModal)
{
    <div class="kawaii-modal-backdrop" @onclick="() => showVipModal = false">
        <div class="vip-ticket-modal-card" @onclick:stopPropagation="true">
            <button class="modal-close-btn" @onclick="() => showVipModal = false">✕</button>

            <!-- Printable Keepsake Ticket -->
            <div id="vip-printable-ticket" class="vip-ticket">
                <div class="vip-ticket-header">
                    <div class="vip-ticket-brand">🍓 BestieSpace VIP Pass</div>
                    <span class="vip-ticket-badge">Official Invitation</span>
                </div>

                <div class="vip-ticket-body">
                    <div class="vip-info-cell">
                        <div class="vip-info-label">VIP Member</div>
                        <div class="vip-info-val">@(currentUserSession?.DisplayName ?? "Sweet Bestie 🌸")</div>
                    </div>
                    <div class="vip-info-cell">
                        <div class="vip-info-label">Nickname</div>
                        <div class="vip-info-val">@(currentUserSession?.Username ?? "strawberry_bestie")</div>
                    </div>
                    <div class="vip-info-cell">
                        <div class="vip-info-label">Access Level</div>
                        <div class="vip-info-val">Clubhouse VIP 💖</div>
                    </div>
                    <div class="vip-info-cell">
                        <div class="vip-info-label">Quick PIN</div>
                        <div class="vip-info-val vip-pin-highlight">@(string.Join(" ", (currentUserSession?.QuickPin ?? "3000").ToCharArray())) 🍓</div>
                    </div>
                </div>

                <div class="vip-ticket-barcode-row">
                    <div class="vip-barcode">|| | ||| || ||| | |||</div>
                    <div style="font-size: 0.72rem; color: var(--text-cocoa-light); font-weight: 700;">
                        VIP-BESTIE-CLUBHOUSE-2026
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="vip-modal-actions">
                <button type="button" class="btn-vip-action btn-vip-copy" @onclick="CopyVipTicketAsync">
                    <span>📋 Copy Invite Message</span>
                </button>
                <button type="button" class="btn-vip-action btn-vip-print" @onclick="PrintVipTicketAsync">
                    <span>🖨️ Print / Save Ticket</span>
                </button>
            </div>

            @if (isTicketCopied)
            {
                <div style="text-align: center;">
                    <div class="toast-pill-copied">
                        <span>✨ Copied to clipboard! Send it to your bestie 💕</span>
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
/* Scrapbook 6-Card Dashboard Layout */
.home-scrapbook-wrapper {
    max-width: 1220px;
    margin: 14px auto 60px auto;
    padding: 0 16px;
    font-family: 'Fredoka', 'Quicksand', sans-serif;
}

.home-scrapbook-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px 22px;
}

@@media (max-width: 1024px) {
    .home-scrapbook-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@@media (max-width: 680px) {
    .home-scrapbook-grid {
        grid-template-columns: 1fr;
    }
}

/* Individual Scrapbook Card Frame */
.scrapbook-feature-card {
    background: #FFFFFF;
    border: 2px solid #FFD1DC;
    border-radius: 26px;
    padding: 24px 22px 20px 22px;
    position: relative;
    box-shadow: 0 8px 24px rgba(255, 143, 171, 0.14), 0 2px 6px rgba(74, 59, 60, 0.04);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.25s ease, border-color 0.25s ease;
    cursor: pointer;
}

.scrapbook-feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(255, 112, 147, 0.24);
    border-color: #FF8FAB;
}

/* Card Top Row */
.card-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.card-icon-frame {
    width: 48px;
    height: 48px;
    background: #FFF5F8;
    border: 1.5px solid #FFCCD5;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    box-shadow: inset 0 1px 3px rgba(255, 255, 255, 0.9), 0 2px 6px rgba(255, 143, 171, 0.12);
}

.card-pill-badge {
    background: #FFF0F5;
    border: 1.5px solid #FFCCD5;
    color: #FF5D8F;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 4px 13px;
    border-radius: 9999px;
    letter-spacing: -0.2px;
}

.card-pill-badge.badge-signalr {
    background: #E8F8F0;
    border: 1.5px solid #A3E4D7;
    color: #2E7D32;
}

.card-title {
    font-family: 'Fredoka', cursive, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #4A3B3C;
    margin: 0 0 8px 0;
    letter-spacing: -0.3px;
}

.card-description {
    font-family: 'Quicksand', sans-serif;
    font-size: 0.92rem;
    line-height: 1.52;
