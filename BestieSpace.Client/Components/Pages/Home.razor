@page "/"
@rendermode InteractiveServer
@inject IBestieApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Home> Logger
@inject BestieAuthenticationStateProvider AuthProvider
@implements IAsyncDisposable

<PageTitle>BestieSpace 🌸 | Our Secret Cozy Space</PageTitle>

<!-- =========================================================
     STEP 0: CUTE SECRET BESTIE LOGIN SCREEN (If not signed in)
     ========================================================= -->
@if (currentUserSession == null)
{
    <div class="login-gate-overlay">
        <div class="login-card @(isLoginWiggling ? "kawaii-wiggle" : "")">
            <!-- Floating Stickers -->
            <div class="floating-sticker sticker-1">🎀</div>
            <div class="floating-sticker sticker-2">✨</div>
            <div class="floating-sticker sticker-3">🧸</div>
            <div class="floating-sticker sticker-4">💖</div>

            <div class="login-header-icon">🍓✨</div>
            <h1 class="login-title" tabindex="-1">Secret Bestie Clubhouse</h1>
            <p class="login-subtitle">
                Enter your 4-digit strawberry PIN or secret password to unlock our cozy world 💕
            </p>

            <!-- Prominent Register CTA Banner -->
            <div class="login-register-banner">
                <span>🌸 New to BestieSpace?</span>
                <a href="/register" class="btn-register-link">Register Account Here ✨</a>
            </div>

            <!-- Login Tabs: PIN Pad vs Password vs Register -->
            <div class="login-tabs-nav">
                <button type="button" class="login-tab-btn @(activeLoginTab == "pin" ? "active" : "")" 
                        @onclick='() => { activeLoginTab = "pin"; loginErrorMessage = null; }'>
                    <span>🍓</span> Cute PIN Pad
                </button>
                <button type="button" class="login-tab-btn @(activeLoginTab == "password" ? "active" : "")" 
                        @onclick='() => { activeLoginTab = "password"; loginErrorMessage = null; }'>
                    <span>🔑</span> Password
                </button>
                <a href="/register" class="login-tab-btn register-tab-btn" title="Create a new account">
                    <span>✨</span> Register
                </a>
            </div>

            @if (!string.IsNullOrWhiteSpace(loginErrorMessage))
            {
                <div class="login-error-badge">
                    <span>🥺</span>
                    <span>@loginErrorMessage</span>
                </div>
            }

            @if (activeLoginTab == "pin")
            {
                <!-- Strawberry PIN Pad View -->
                <div class="strawberry-pin-container">
                    <div class="pin-slots-row @(isPinWiggling ? "kawaii-wiggle" : "")">
                        <div class="pin-slot @(enteredPin.Length >= 1 ? "filled" : "")">
                            @if (enteredPin.Length >= 1)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                        <div class="pin-slot @(enteredPin.Length >= 2 ? "filled" : "")">
                            @if (enteredPin.Length >= 2)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                        <div class="pin-slot @(enteredPin.Length >= 3 ? "filled" : "")">
                            @if (enteredPin.Length >= 3)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                        <div class="pin-slot @(enteredPin.Length >= 4 ? "filled" : "")">
                            @if (enteredPin.Length >= 4)
                            {
                                <span class="bouncing-strawberry">🍓</span>
                            }
                        </div>
                    </div>

                    <div class="strawberry-keypad">
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("1")'>1</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("2")'>2</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("3")'>3</button>

                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("4")'>4</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("5")'>5</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("6")'>6</button>

                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("7")'>7</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("8")'>8</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("9")'>9</button>

                        <button type="button" class="keypad-btn keypad-btn-special" @onclick="ClearPin" title="Clear PIN">Clear 🌸</button>
                        <button type="button" class="keypad-btn" @onclick='() => AppendPinDigit("0")'>0</button>
                        <button type="button" class="keypad-btn keypad-btn-special" @onclick="ToggleHintBox" title="Need a hint?">Hint 💡</button>
                    </div>

                    <div class="pin-hint-tag">
                        <span>Tap your 4-digit secret PIN to unlock automatically ✨</span>
                    </div>
                </div>
            }
            else
            {
                <!-- Secret Password Form View -->
                <div class="login-input-group">
                    <div class="login-field">
                        <label class="login-label">Cute Nickname or Email</label>
                        <div class="login-input-box">
                            <span class="login-input-icon">🍓</span>
                            <input type="text" 
                                   class="login-input" 
                                   placeholder="e.g., strawberry_bestie or email" 
                                   @bind="loginUsername" 
                                   @bind:event="oninput"
                                   @onkeydown="HandleLoginKeyDown" />
                        </div>
                    </div>

                    <div class="login-field">
                        <label class="login-label">Secret Password</label>
                        <div class="login-input-box">
                            <span class="login-input-icon">🗝️</span>
                            <input type="@(showPassword ? "text" : "password")" 
                                   class="login-input" 
                                   placeholder="••••••••" 
                                   @bind="loginPassword" 
                                   @bind:event="oninput"
                                   @onkeydown="HandleLoginKeyDown" />
                            <button type="button" class="login-toggle-eye" @onclick="() => showPassword = !showPassword" title="Show/Hide Password">
                                @(showPassword ? "👀" : "🫣")
                            </button>
                        </div>
                    </div>
                </div>

                <button class="login-btn-primary" @onclick="HandleLoginAsync" disabled="@isLoggingIn">
                    @if (isLoggingIn)
                    {
                        <span>Checking secret code... 🌸</span>
                    }
                    else
                    {
                        <span>Unlock Clubhouse 💖 ✨</span>
                    }
                </button>
            }

            <!-- VIP Pass & Hint Helper Row -->
            <div class="login-hint-section">
                <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-bottom: 8px;">
                    <button type="button" class="btn-vip-ticket-shortcut" @onclick="() => showVipModal = true">
                        <span>🎟️</span>
                        <span>View VIP Pass</span>
                    </button>
                    <button type="button" class="login-hint-trigger" @onclick="ToggleHintBox">
                        <span>💡</span>
                        <span>Need Help Signing In?</span>
                    </button>
                </div>

                @if (showHintBox)
                {
                    <div class="login-hint-box">
                        <div class="login-hint-title">
                            <span>✨ Account Sign In Information:</span>
                        </div>
                        <div style="margin-top: 6px; line-height: 1.5; font-size: 0.88rem; color: #5C4A4C;">
                            You can sign in using your registered <strong>Username or Email</strong> and secret password, or enter your 4-digit PIN! 🌸<br />
                            If you don't have an account yet, <a href="/register" style="color: #FB6F92; font-weight: 700;">click here to register</a> and create your custom bestie profile! 💕
                        </div>
                    </div>
                }

                <div style="text-align: center; margin-top: 14px; padding-top: 10px; border-top: 1px dashed rgba(255, 143, 171, 0.4);">
                    <a href="/register" style="color: #FB6F92; font-weight: 700; text-decoration: none; font-size: 0.95rem; display: inline-flex; align-items: center; gap: 6px;">
                        <span>✨</span>
                        <span>Don't have an account yet? Click here to Register! 🌸</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<!-- =========================================================
     MAIN SCRAPBOOK DASHBOARD EXPERIENCE (When signed in)
     ========================================================= -->
@if (currentUserSession != null)
{
    <div class="home-main-container">
        <!-- Top Header & Floating Stickers -->
        <header class="kawaii-header">
            <!-- Left floating camera sticker -->
            <div class="header-floating-sticker header-sticker-camera" aria-hidden="true" title="Camera Sticker 📸">
                <svg width="74" height="64" viewBox="0 0 100 86" fill="none">
                    <rect x="6" y="14" width="88" height="66" rx="18" fill="#FFFFFF" filter="drop-shadow(0 4px 10px rgba(251,111,146,0.35))" />
                    <rect x="14" y="6" width="30" height="14" rx="6" fill="#FFFFFF" />
                    <rect x="10" y="18" width="80" height="58" rx="14" fill="#FFCCD5" stroke="#FF8FAB" stroke-width="2" />
                    <rect x="18" y="10" width="22" height="10" rx="4" fill="#FF8FAB" />
                    <circle cx="26" cy="30" r="5" fill="#FFE5EC" stroke="#FF8FAB" stroke-width="1.5" />
                    <rect x="70" y="24" width="12" height="8" rx="3" fill="#FFE5EC" stroke="#FF8FAB" stroke-width="1.5" />
                    <circle cx="50" cy="50" r="19" fill="#FFFFFF" stroke="#FF8FAB" stroke-width="2.5" />
                    <circle cx="50" cy="50" r="14" fill="#4A3B3C" />
                    <circle cx="50" cy="50" r="10" fill="#7E6566" />
                    <path d="M50 53 C50 53 45 49 45 46.5 C45 44.5 46.5 43.5 48 43.5 C49 43.5 49.5 44 50 44.5 C50.5 44 51 43.5 52 43.5 C53.5 43.5 55 44.5 55 46.5 C55 49 50 53 50 53 Z" fill="#FF8FAB" />
                    <ellipse cx="24" cy="62" rx="4" ry="2.5" fill="#FF6584" opacity="0.6" />
                    <ellipse cx="76" cy="62" rx="4" ry="2.5" fill="#FF6584" opacity="0.6" />
                </svg>
            </div>

            <!-- Right floating love envelope sticker -->
            <div class="header-floating-sticker header-sticker-envelope" aria-hidden="true" title="Love Letter Sticker 💌">
                <svg width="70" height="60" viewBox="0 0 100 84" fill="none">
                    <rect x="6" y="8" width="88" height="68" rx="14" fill="#FFFFFF" filter="drop-shadow(0 4px 10px rgba(251,111,146,0.35))" />
                    <rect x="10" y="12" width="80" height="60" rx="10" fill="#FFE5EC" stroke="#FF8FAB" stroke-width="2" />
                    <path d="M10 14 L50 46 L90 14" stroke="#FF8FAB" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M10 70 L38 42" stroke="#FFCCD5" stroke-width="2" stroke-linecap="round" />
                    <path d="M90 70 L62 42" stroke="#FFCCD5" stroke-width="2" stroke-linecap="round" />
                    <circle cx="50" cy="46" r="12" fill="#FFFFFF" />
                    <path d="M50 52 C50 52 43 47 43 43 C43 40 45.5 38.5 48 38.5 C49 38.5 49.7 39.2 50 40 C50.3 39.2 51 38.5 52 38.5 C54.5 38.5 57 40 57 43 C57 47 50 52 50 52 Z" fill="#FF5D8F" filter="drop-shadow(0 2px 4px rgba(255,93,143,0.4))" />
                </svg>
            </div>

            <div class="brand-badge">
                <span>🌸</span>
                <span>Est. 2026 • Forever & Always</span>
                <span>🎀</span>
            </div>
            <h1 class="brand-title">Bestie<span>Space</span> 💕</h1>
            <p class="brand-tagline">Our secret digital memory box & real-time clubhouse</p>
        </header>

        <!-- =========================================================
             BENTO GRID DASHBOARD (Soft Claymorphism + Pastel Pink Social UI)
             ========================================================= -->
        <div class="bento-grid" id="bento-dashboard">
            <!-- Bento Hero 1: Heartfelt Letter Memo Pad (Span 8) -->
            <div class="bento-card bento-hero-letter clay-surface">
                <div class="washi-tape-top" aria-hidden="true"></div>
                <div class="stationery-paperclip" aria-hidden="true" title="Paperclip 📎💖">
                    <svg width="28" height="38" viewBox="0 0 24 34" fill="none">
                        <path d="M12 16 C12 16 5 11 5 6 C5 3 7.5 1 10.5 1 C12 1 12.5 2 13 3 C13.5 2 14 1 15.5 1 C18.5 1 21 3 21 6 C21 11 12 16 12 16" fill="#FF8FAB" stroke="#FFFFFF" stroke-width="1.8" filter="drop-shadow(0 2px 4px rgba(255,143,171,0.4))" />
                        <path d="M7 12 V24 C7 27.5 9 30 12 30 C15 30 17 27.5 17 24 V8 C17 6 15.5 4 13.5 4 C11.5 4 10 6 10 8 V23 C10 24.5 11 25.5 12 25.5 C13 25.5 14 24.5 14 23 V10" stroke="#FFCCD5" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </div>
                <div class="stationery-sakura" aria-hidden="true" title="Sakura 🌸">
                    <svg width="38" height="38" viewBox="0 0 100 100" fill="none">
                        <path d="M22 65 C12 60 14 46 26 48 C32 49 32 60 22 65 Z" fill="#A8D5BA" stroke="#FFFFFF" stroke-width="2.5" />
                        <circle cx="50" cy="50" r="32" fill="#FFFFFF" filter="drop-shadow(0 3px 6px rgba(251,111,146,0.3))" />
                        <path d="M50 20 C42 8 58 8 50 20 Z M76 38 C88 32 82 48 76 38 Z M68 70 C74 82 60 84 68 70 Z M32 70 C40 84 26 82 32 70 Z M24 38 C18 48 12 32 24 38 Z" fill="#FFB7C5" stroke="#FF8FAB" stroke-width="2" />
                        <circle cx="50" cy="50" r="14" fill="#FFE5EC" stroke="#FF6584" stroke-width="2" />
                        <circle cx="50" cy="50" r="6" fill="#FF8FAB" />
                    </svg>
                </div>

                <div class="letter-header">
                    <div class="clay-pill-tag">
                        <span>💌</span>
                        <span>Cozy Love Letter</span>
                    </div>
                    <h2 class="letter-title">
                        @(string.IsNullOrWhiteSpace(dashboard?.AppStats.MainLetterTitle) ? "To My Favorite Human in the Entire World 🌸" : dashboard.AppStats.MainLetterTitle)
                    </h2>
                    <div class="letter-from-to">
                        <span>With all my love: @(string.IsNullOrWhiteSpace(dashboard?.AppStats.SenderNickname) ? "Me 🎀" : dashboard.AppStats.SenderNickname) ➜ @(string.IsNullOrWhiteSpace(dashboard?.AppStats.RecipientNickname) ? "Bestie 🌸" : dashboard.AppStats.RecipientNickname)</span>
                    </div>
                </div>

                <div class="letter-content bento-letter-body">
                    @if (!string.IsNullOrWhiteSpace(dashboard?.AppStats.MainLetterContent))
                    {
                        @dashboard.AppStats.MainLetterContent
                    }
                    else
                    {
                        <text>Dear Bestie,

I built this cozy, pastel corner of the internet just for us! No matter how many miles stand between us or how crazy life gets, you will always be my safest place, my funniest laugh, and my favorite sister at heart.

Every time you miss me, press that little pink heart button below so I can feel your virtual hug! Browse through our polaroid memories, open the mystery envelopes when you need an instant smile, and send me silly stickers, photos, and voice notes anytime in our chat.</text>
                    }
                </div>

                <div class="bento-letter-footer">
                    <span class="letter-stamp-deco">✨ Pinned with Love • Forever Besties 🌸</span>
                </div>
            </div>

            <!-- Bento Hero 2: 3D Clay Hug Orb & Live Miss-You Meter (Span 4) -->
            <div class="bento-card bento-hero-hug clay-surface">
                <div class="clay-hug-orb-wrapper">
                    <div class="clay-pulse-glow" aria-hidden="true"></div>
                    <div class="clay-3d-heart" aria-hidden="true">
                        <span class="heart-emoji">💖</span>
                    </div>

                    <div class="clay-hug-badge">
                        <span class="live-pulse-dot"></span>
                        <span>Live Hug Meter</span>
                    </div>

                    <div class="clay-hug-counter-number">@missYouCount</div>
                    <div class="clay-hug-counter-label">Hugs Sent Across The Miles 💕</div>
                    <p class="clay-hug-counter-sub">Tap whenever you're thinking of your bestie! Syncs instantly in real time.</p>

                    <button class="btn-clay-squish-hug" @onclick="HandleMissYouClick">
                        <span>I Miss You Too! 💖</span>
                        <span class="btn-hug-icon">🧸</span>
                    </button>
                </div>
            </div>

            <!-- Bento Tile 3: Polaroid Memories (Span 4) -->
            <div class="bento-card bento-tile-photos clay-surface" @onclick='() => Navigation.NavigateTo("/photos")'>
                <div class="bento-card-header">
                    <div class="clay-icon-bubble bubble-pink">
                        <span>📷</span>
                    </div>
                    <div class="clay-pill-badge">
                        <span>@(dashboard?.Memories.Count ?? 6) Photos 💖</span>
                    </div>
                </div>

                <h3 class="bento-card-title">Polaroid Memories</h3>
                <p class="bento-card-desc">
                    Browse our photo albums pinned with washi tape and cute stickers. Zoom in on cozy moments!
                </p>

                <!-- Micro Visual Polaroid Stack -->
                <div class="mini-polaroid-stack" aria-hidden="true">
                    <div class="mini-polaroid mini-p1">🌸</div>
                    <div class="mini-polaroid mini-p2">✨</div>
                    <div class="mini-polaroid mini-p3">📸</div>
                </div>

                <button type="button" class="btn-clay-card-action" @onclick:stopPropagation="true" @onclick='() => Navigation.NavigateTo("/photos")'>
                    <span>Open Photo Album 📸</span>
                </button>
            </div>

            <!-- Bento Tile 4: Clubhouse & Circle Chat (Span 5 - Social Focus) -->
            <div class="bento-card bento-tile-chat clay-surface" @onclick='() => Navigation.NavigateTo("/chat")'>
                <div class="bento-card-header">
                    <div class="clay-icon-bubble bubble-purple">
                        <span>💬</span>
                    </div>
                    <div class="clay-pill-badge badge-live-pulse">
                        <span class="live-pulse-dot"></span>
                        <span>Live SignalR Online</span>
                    </div>
                </div>

                <h3 class="bento-card-title">Clubhouse & Circle Chat</h3>
                <p class="bento-card-desc">
                    Real-time chats with photo sharing, cute sticker trays, audio voice messages, and instant read receipts.
                </p>

                <!-- Social Chat Preview Snippets -->
                <div class="social-chat-preview" aria-hidden="true">
                    <div class="chat-preview-bubble sender">
                        <span>Bestie: Can't wait to see you! 💕</span>
                    </div>
                    <div class="chat-preview-bubble receiver">
                        <span>🎙️ Voice Note (0:08) • 🌸</span>
                    </div>
                </div>

                <button type="button" class="btn-clay-card-action" @onclick:stopPropagation="true" @onclick='() => Navigation.NavigateTo("/chat")'>
                    <span>Enter Chat Room 💬</span>
                </button>
            </div>

            <!-- Bento Tile 5: Mystery Envelopes (Span 3) -->
            <div class="bento-card bento-tile-notes clay-surface" @onclick='() => Navigation.NavigateTo("/notes")'>
                <div class="bento-card-header">
                    <div class="clay-icon-bubble bubble-yellow">
                        <span>✉️</span>
                    </div>
                    <div class="clay-pill-badge">
                        <span>@(dashboard?.SecretNotes.Count(n => n.IsUnlocked) ?? 2) / @(dashboard?.SecretNotes.Count ?? 2) 🎀</span>
                    </div>
                </div>

                <h3 class="bento-card-title">Mystery Envelopes</h3>
                <p class="bento-card-desc">
                    Break wax seals on surprise handwritten notes created just for your eyes.
                </p>

                <div class="envelope-wax-deco" aria-hidden="true">
                    <span>💌</span>
                    <span class="wax-seal-badge">Locked & Sweet</span>
                </div>

                <button type="button" class="btn-clay-card-action" @onclick:stopPropagation="true" @onclick='() => Navigation.NavigateTo("/notes")'>
                    <span>Open Notes ✉️</span>
                </button>
            </div>

            <!-- Bento Tile 6: Bestie Circles (Span 4) -->
            <div class="bento-card bento-tile-circles clay-surface" @onclick='() => Navigation.NavigateTo("/circles")'>
                <div class="bento-card-header">
                    <div class="clay-icon-bubble bubble-peach">
                        <span>👑</span>
                    </div>
                    <div class="clay-pill-badge">
                        <span>Up to 9 Besties 🎀</span>
                    </div>
                </div>

                <h3 class="bento-card-title">Bestie Circles</h3>
                <p class="bento-card-desc">
                    Manage private friend circles, invite besties, customize circle icons and squad rosters.
                </p>

                <!-- Social Avatar Pile Preview -->
                <div class="social-avatar-cluster" aria-hidden="true">
                    <span class="cluster-avatar ca-1">🎀</span>
                    <span class="cluster-avatar ca-2">🌸</span>
                    <span class="cluster-avatar ca-3">🧸</span>
                    <span class="cluster-more">+Squad</span>
                </div>

                <button type="button" class="btn-clay-card-action" @onclick:stopPropagation="true" @onclick='() => Navigation.NavigateTo("/circles")'>
                    <span>Manage Circles 👑</span>
                </button>
            </div>

            <!-- Bento Tile 7: Friends & Profiles (Span 4) -->
            <div class="bento-card bento-tile-friends clay-surface" @onclick='() => Navigation.NavigateTo("/friends")'>
                <div class="bento-card-header">
                    <div class="clay-icon-bubble bubble-pink">
                        <span>👭</span>
                    </div>
                    <div class="clay-pill-badge">
                        <span>Social Hub 🌸</span>
                    </div>
                </div>

                <h3 class="bento-card-title">Friends & Profiles</h3>
                <p class="bento-card-desc">
                    Search besties, manage requests, update your display bio, and pick your favorite avatar sticker.
                </p>

                <div class="social-status-row" aria-hidden="true">
                    <div class="status-chip"><span>✨ Profile Ready</span></div>
                    <div class="status-chip"><span>🎀 Bestie Connected</span></div>
                </div>

                <button type="button" class="btn-clay-card-action" @onclick:stopPropagation="true" @onclick='() => Navigation.NavigateTo("/friends")'>
                    <span>View Friends Hub 👭</span>
                </button>
            </div>

            <!-- Bento Tile 8: Official VIP Pass (Span 4) -->
            <div class="bento-card bento-tile-vip clay-surface" @onclick="() => showVipModal = true">
                <div class="bento-card-header">
                    <div class="clay-icon-bubble bubble-gold">
                        <span>🎟️</span>
                    </div>
                    <div class="clay-pill-badge badge-gold">
                        <span>Keepsake Pass 🎀</span>
                    </div>
                </div>

                <h3 class="bento-card-title">Official VIP Pass</h3>
                <p class="bento-card-desc">
                    View, copy, or print your official Bestie Clubhouse VIP Pass to invite close besties!
                </p>

                <div class="mini-vip-ticket-preview" aria-hidden="true">
                    <div class="vip-preview-notch"></div>
                    <div class="vip-preview-content">
                        <span>🍓 VIP PASS</span>
                        <span class="vip-barcode">|||| ||| |||||</span>
                    </div>
                </div>

                <button type="button" class="btn-clay-card-action" @onclick:stopPropagation="true" @onclick="() => showVipModal = true">
                    <span>View VIP Pass 🎟️</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- =========================================================
     MODAL: CUTE VIP INVITATION PASS
     ========================================================= -->
@if (showVipModal)
{
    <div class="kawaii-modal-backdrop" @onclick="() => showVipModal = false">
        <div class="vip-ticket-modal-card" @onclick:stopPropagation="true">
            <button class="modal-close-btn" @onclick="() => showVipModal = false">✕</button>

            <!-- Printable Keepsake Ticket -->
            <div id="vip-printable-ticket" class="vip-ticket">
                <div class="vip-ticket-header">
                    <div class="vip-ticket-brand">🍓 BestieSpace VIP Pass</div>
                    <span class="vip-ticket-badge">Official Invitation</span>
                </div>

                <div class="vip-ticket-body">
                    <div class="vip-info-cell">
                        <div class="vip-info-label">VIP Member</div>
                        <div class="vip-info-val">@(currentUserSession?.DisplayName ?? "Sweet Bestie 🌸")</div>
                    </div>
                    <div class="vip-info-cell">
                        <div class="vip-info-label">Nickname</div>
                        <div class="vip-info-val">@(currentUserSession?.Username ?? "strawberry_bestie")</div>
                    </div>
                    <div class="vip-info-cell">
                        <div class="vip-info-label">Access Level</div>
                        <div class="vip-info-val">Clubhouse VIP 💖</div>
                    </div>
                    <div class="vip-info-cell">
                        <div class="vip-info-label">Quick PIN</div>
                        <div class="vip-info-val vip-pin-highlight">@(string.Join(" ", (currentUserSession?.QuickPin ?? "3000").ToCharArray())) 🍓</div>
                    </div>
                </div>

                <div class="vip-ticket-barcode-row">
                    <div class="vip-barcode">|| | ||| || ||| | |||</div>
                    <div style="font-size: 0.72rem; color: var(--text-cocoa-light); font-weight: 700;">
                        VIP-BESTIE-CLUBHOUSE-2026
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="vip-modal-actions">
                <button type="button" class="btn-vip-action btn-vip-copy" @onclick="CopyVipTicketAsync">
                    <span>📋 Copy Invite Message</span>
                </button>
                <button type="button" class="btn-vip-action btn-vip-print" @onclick="PrintVipTicketAsync">
                    <span>🖨️ Print / Save Ticket</span>
                </button>
            </div>

            @if (isTicketCopied)
            {
                <div style="text-align: center;">
                    <div class="toast-pill-copied">
                        <span>✨ Copied to clipboard! Send it to your bestie 💕</span>
                    </div>
                </div>
            }
        </div>
    </div>
}

