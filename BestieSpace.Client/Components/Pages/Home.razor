    private async Task ToggleAudioPlayback(string audioId)
    {
        if (currentlyPlayingAudioId == audioId)
        {
            await JSRuntime.InvokeVoidAsync("pastelAudioPlayer.pause", audioId);
            currentlyPlayingAudioId = null;
        }
        else
        {
            if (currentlyPlayingAudioId != null)
            {
                await JSRuntime.InvokeVoidAsync("pastelAudioPlayer.pause", currentlyPlayingAudioId);
            }
            await JSRuntime.InvokeVoidAsync("pastelAudioPlayer.play", audioId);
            currentlyPlayingAudioId = audioId;
        }
    }

