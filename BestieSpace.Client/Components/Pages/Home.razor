    private async Task HandleMemoryPhotoSelection(InputFileChangeEventArgs e)
    {
        selectedPhotoFile = e.File;
        try
        {
            var buffer = new byte[selectedPhotoFile.Size];
            await selectedPhotoFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).ReadAsync(buffer);
            var base64 = Convert.ToBase64String(buffer);
            photoPreviewDataUrl = $"data:{selectedPhotoFile.ContentType};base64,{base64}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to generate photo preview");
        }
    }

    private async Task SubmitNewMemory()
    {
        if (string.IsNullOrWhiteSpace(newPhotoCaption))
        {
            newPhotoCaption = "Our happy memory! 🌸";
        }

        isUploadingPhoto = true;

        try
        {
            using var form = new MultipartFormDataContent();
            form.Add(new StringContent(newPhotoCaption), "caption");
            form.Add(new StringContent(newPhotoSticker), "stickerType");
            form.Add(new StringContent(newPhotoDate.ToString("o")), "memoryDate");

            if (selectedPhotoFile != null)
            {
                var stream = selectedPhotoFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                var streamContent = new StreamContent(stream);
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(selectedPhotoFile.ContentType);
                form.Add(streamContent, "photo", selectedPhotoFile.Name);
            }

            var created = await ApiClient.AddMemoryAsync(form);
            if (created != null && dashboard != null)
            {
                dashboard.Memories.Insert(0, created);
            }

            showAddPhotoModal = false;
            newPhotoCaption = "";
            selectedPhotoFile = null;
            photoPreviewDataUrl = null;
            await JSRuntime.InvokeVoidAsync("bestieAnimations.triggerConfettiBurst");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading new memory");
        }
        finally
        {
            isUploadingPhoto = false;
        }
    }

