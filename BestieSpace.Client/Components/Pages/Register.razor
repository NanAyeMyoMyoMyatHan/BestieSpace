@page "/register"
@layout Layout.AuthLayout
@using BestieSpace.Client.Services
@using BestieSpace.Shared.DTOs
@inject NavigationManager Navigation
@inject BestieAuthenticationStateProvider AuthProvider
@inject IJSRuntime JSRuntime

<PageTitle>Join BestieSpace 🌸 | Register</PageTitle>

<div class="bestie-login-page">
    <div class="login-split-card @(isWiggling ? "kawaii-wiggle" : "")">
        <!-- ================= LEFT BANNER PANEL ================= -->
        <div class="login-left-panel">
            <div class="left-panel-content">
                <!-- Crown & Emblem Header -->
                <div class="panel-brand-header">
                    <span class="crown-sticker">👑</span>
                    <div class="brand-heart-emblem">
                        <svg width="56" height="56" viewBox="0 0 100 100" fill="none">
                            <rect width="100" height="100" rx="30" fill="#FFE5EC"/>
                            <path d="M50 82C50 82 18 60 18 38C18 24 29 16 41 16C47 16 50 19 50 23C50 19 53 16 59 16C71 16 82 24 82 38C82 60 50 82 50 82Z" fill="#FB6F92"/>
                            <circle cx="41" cy="36" r="6.5" fill="#FFFFFF"/>
                            <circle cx="59" cy="36" r="6.5" fill="#FFFFFF"/>
                            <path d="M33 55 C33 46 47 46 47 55" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round"/>
                            <path d="M53 55 C53 46 67 46 67 55" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <h1 class="panel-brand-title">Bestie<span>Space</span> 💕</h1>
                    <p class="panel-brand-subtitle">Connect • Share • Make Memories Together ♡</p>
                </div>

                <!-- Besties Anime Squad Illustration -->
                <div class="panel-illustration-container">
                    <div class="speech-bubble-tag">
                        <span>Better Together ♡</span>
                    </div>
                    <img src="images/besties-squad.png" alt="BestieSpace Squad" class="besties-squad-img" />
                </div>

                <!-- Bottom Pill -->
                <div class="panel-bottom-pill">
                    <span class="pill-icon-box">👥</span>
                    <span class="pill-text">Join BestieSpace and keep your friendship closer! ♡</span>
                </div>
            </div>
        </div>

        <!-- ================= RIGHT FORM PANEL ================= -->
        <div class="login-right-panel">
            <!-- Top Right Sign In Link -->
            <div class="top-register-row">
                <span>Already a bestie?</span>
                <a href="/login" class="signup-link">Sign In →</a>
            </div>

            <!-- Welcome Header Block -->
            <div class="form-header-block">
                <h2 class="form-title">Create Account! ✨</h2>
                <p class="form-subtitle">Join our cozy world to share memories & chat forever ♡</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="form-error-banner">
                    <span>🥺</span>
                    <span>@errorMessage</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="form-success-banner">
                    <span>✨</span>
                    <span>@successMessage</span>
                </div>
            }

            <!-- Register Form -->
            <EditForm Model="registerModel" OnValidSubmit="HandleRegister" class="login-form-inner">
                <!-- Row 1: Nickname & Email -->
                <div class="form-row-2col">
                    <div class="form-pill-input-group">
                        <span class="pill-icon">👤</span>
                        <input type="text" 
                               class="pill-input" 
                               placeholder="Cute Nickname *" 
                               @bind="registerModel.Username" 
                               required 
                               minlength="3" 
                               maxlength="30" />
                    </div>

                    <div class="form-pill-input-group">
                        <span class="pill-icon">✉️</span>
                        <input type="email" 
                               class="pill-input" 
                               placeholder="Email Address *" 
                               @bind="registerModel.Email" 
                               required />
                    </div>
                </div>

                <!-- Row 2: Display Name & Strawberry PIN -->
                <div class="form-row-2col">
                    <div class="form-pill-input-group">
                        <span class="pill-icon">🎀</span>
                        <input type="text" 
                               class="pill-input" 
                               placeholder="Display Name (How friends see you)" 
                               @bind="registerModel.DisplayName" 
                               maxlength="50" />
                    </div>

                    <div class="form-pill-input-group">
                        <span class="pill-icon">🍓</span>
                        <input type="@(showPin ? "text" : "password")" 
                               class="pill-input" 
                               placeholder="4-Digit PIN * (e.g. 1234)" 
                               @bind="registerModel.QuickPin" 
                               required 
                               maxlength="4" 
                               pattern="\d{4}" 
                               inputmode="numeric" />
                        <button type="button" class="btn-eye-toggle" @onclick="() => showPin = !showPin" title="Show/Hide PIN">
                            @(showPin ? "👁️" : "🙈")
                        </button>
                    </div>
                </div>

                <!-- Row 3: Secret Password & Confirm Password -->
                <div class="form-row-2col">
                    <div class="form-pill-input-group">
                        <span class="pill-icon">🔒</span>
                        <input type="@(showPassword ? "text" : "password")" 
                               class="pill-input" 
                               placeholder="Secret Password *" 
                               @bind="registerModel.Password" 
                               required 
                               minlength="6" />
                        <button type="button" class="btn-eye-toggle" @onclick="() => showPassword = !showPassword" title="Show/Hide Password">
                            @(showPassword ? "👁️" : "🙈")
                        </button>
                    </div>

                    <div class="form-pill-input-group">
                        <span class="pill-icon">🛡️</span>
                        <input type="@(showPassword ? "text" : "password")" 
                               class="pill-input" 
                               placeholder="Confirm Password *" 
                               @bind="registerModel.ConfirmPassword" 
                               required 
                               minlength="6" />
                    </div>
                </div>

                <!-- Row 4: Pick Your Bestie Avatar Sticker -->
                <div class="sticker-picker-block">
                    <label class="sticker-picker-label">Choose Your Avatar Sticker 🌸</label>
                    <div class="sticker-picker-row">
                        @foreach (var sticker in availableStickers)
                        {
                            <button type="button" 
                                    class="sticker-pill-btn @(registerModel.AvatarSticker == sticker ? "selected" : "")" 
                                    @onclick="() => registerModel.AvatarSticker = sticker">
                                @sticker
                            </button>
                        }
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-main-login" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-dot">🌸</span>
                        <span>Creating your bestie profile...</span>
                    }
                    else
                    {
                        <span class="login-icon">✨</span>
                        <span>Register Account</span>
                    }
                </button>
            </EditForm>

            <!-- Bottom Friendly Greeting Pill -->
            <div class="bottom-greeting-card">
                <span>💖 Forever Besties, Forever Together! 💕</span>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterRequestDto registerModel = new() { AvatarSticker = "🌸" };
    private string[] availableStickers = { "🌸", "🎀", "🧸", "🍓", "🧋", "✨", "🐱", "💖" };
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading = false;
    private bool isWiggling = false;
    private bool showPassword = false;
    private bool showPin = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task HandleRegister()
    {
        if (isLoading) return;
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        if (registerModel.Password != registerModel.ConfirmPassword)
        {
            errorMessage = "Passwords do not match! Please check both fields 🥺";
            TriggerWiggle();
            isLoading = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(registerModel.QuickPin) || !System.Text.RegularExpressions.Regex.IsMatch(registerModel.QuickPin.Trim(), @"^\d{4}$"))
        {
            errorMessage = "Please enter a 4-digit secret PIN (e.g. 1234) for your Strawberry PIN Pad! 🍓";
            TriggerWiggle();
            isLoading = false;
            return;
        }

        try
        {
            var res = await AuthProvider.RegisterAsync(registerModel);
            if (res.IsSuccess)
            {
                successMessage = res.Message;
                await PlaySuccessEffects();
                await Task.Delay(500);
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = res.Message ?? "Registration failed. Please check your information.";
                TriggerWiggle();
            }
        }
        catch (Exception)
        {
            errorMessage = "Could not reach the BestieSpace server. Please ensure the API is running.";
            TriggerWiggle();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void TriggerWiggle()
    {
        isWiggling = true;
        _ = Task.Run(async () =>
        {
            await Task.Delay(550);
            isWiggling = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task PlaySuccessEffects()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("bestieAnimations.playCutePopSound");
            await JSRuntime.InvokeVoidAsync("bestieAnimations.triggerConfettiBurst");
        }
        catch { }
    }
}
