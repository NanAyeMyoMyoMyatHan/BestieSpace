@using System.Security.Claims
@using BestieSpace.Shared.DTOs
@using BestieSpace.Client.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Authorization

@inject IBestieApiClient ApiClient
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject ILogger<NotificationCenter> Logger
@implements IAsyncDisposable

<div class="notification-center-container">
    <!-- Bell Button with Unread Badge -->
    <button type="button" class="btn-notification-bell @(unreadCount > 0 ? "has-unread" : "")" 
            title="Notifications (@unreadCount unread)" 
            @onclick="ToggleDropdown">
        <span class="bell-icon">🔔</span>
        @if (unreadCount > 0)
        {
            <span class="bell-badge">@(unreadCount > 99 ? "99+" : unreadCount.ToString())</span>
        }
    </button>

    <!-- Floating Dropdown / Drawer -->
    @if (isOpen)
    {
        <div class="notification-dropdown-backdrop" @onclick="CloseDropdown"></div>
        <div class="notification-dropdown">
            <div class="dropdown-header">
                <div class="header-title-row">
                    <span class="header-icon">🌸</span>
                    <h3>Bestie Alerts</h3>
                    @if (unreadCount > 0)
                    {
                        <span class="badge-unread-count">@unreadCount new</span>
                    }
                </div>
                <div class="header-actions">
                    @if (unreadCount > 0)
                    {
                        <button class="btn-mark-all" @onclick="MarkAllAsReadAsync" disabled="@isMarkingAll">
                            ✓ Mark all read
                        </button>
                    }
                    <button class="btn-close-dropdown" @onclick="CloseDropdown">✕</button>
                </div>
            </div>

            <!-- Firebase FCM Realtime Push Notification Status Bar -->
            <div class="fcm-push-bar">
                <div class="fcm-push-info">
                    <span>@(isPushActive ? "🟢" : "🔔")</span>
                    <span>@(isPushActive ? "FCM Push Active" : "Realtime Browser Push")</span>
                </div>
                <div class="fcm-push-actions">
                    @if (!isPushActive)
                    {
                        <button type="button" class="btn-fcm-action" @onclick="EnablePushNotificationsAsync" disabled="@isRequestingPush">
                            @(isRequestingPush ? "Activating..." : "Enable Push 💖")
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn-fcm-test" @onclick="SendTestPushAsync" disabled="@isSendingTestPush" title="Test realtime FCM push">
                            @(isSendingTestPush ? "Sending..." : "Test Push 🚀")
                        </button>
                    }
                </div>
            </div>

            <!-- Filter Tabs -->
            <div class="dropdown-tabs">
                <button class="tab-btn @(!unreadOnlyFilter ? "active" : "")" @onclick="@(() => SetFilter(false))">
                    All
                </button>
                <button class="tab-btn @(unreadOnlyFilter ? "active" : "")" @onclick="@(() => SetFilter(true))">
                    Unread @(unreadCount > 0 ? $"({unreadCount})" : "")
                </button>
            </div>

            <!-- Notification Items List -->
            <div class="dropdown-content">
                @if (isLoading)
                {
                    <div class="loading-state">
                        <span class="spinner">🌸</span>
                        <p>Checking bestie updates...</p>
                    </div>
                }
                else if (notifications.Count == 0)
                {
                    <div class="empty-state">
                        <span class="empty-icon">🧸</span>
                        <p>No notifications yet!</p>
                        <span class="empty-sub">When your besties send love, friend requests, or circle invites, you'll see them here! 🌸</span>
                    </div>
                }
                else
                {
                    <div class="notification-list">
                        @foreach (var n in notifications)
                        {
                            <div class="notification-card @(!n.IsRead ? "unread" : "")" @onclick="@(() => HandleNotificationClick(n))">
                                <div class="notif-icon-col">
                                    <span class="type-sticker">@GetTypeIcon(n.NotificationType)</span>
                                </div>
                                <div class="notif-body-col">
                                    <div class="notif-meta-row">
                                        <span class="notif-title">@n.Title</span>
                                        <span class="notif-time">@FormatTimeAgo(n.CreatedAt)</span>
                                    </div>
                                    <p class="notif-msg">@n.Message</p>
                                    @if (!n.IsRead)
                                    {
                                        <span class="unread-dot" title="Unread alert"></span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="dropdown-footer">
                <button class="btn-refresh-sm" @onclick="LoadNotificationsAsync">🔄 Refresh</button>
            </div>
        </div>
    }
</div>

