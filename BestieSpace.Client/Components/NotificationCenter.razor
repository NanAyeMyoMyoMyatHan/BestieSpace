@code {
    private int unreadCount = 0;
    private bool isOpen = false;
    private bool isLoading = false;
    private bool isMarkingAll = false;
    private bool unreadOnlyFilter = false;
    private List<NotificationDto> notifications = new();
    private HubConnection? hubConnection;
    private int currentUserId = 0;

    // Firebase FCM Fields
    private FcmWebConfigDto? fcmWebConfig;
    private bool isPushActive = false;
    private bool isRequestingPush = false;
    private bool isSendingTestPush = false;
    private DotNetObjectReference<NotificationCenter>? dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += HandleAuthStateChanged;
        await SyncNotificationSessionAsync();
    }

    private void HandleAuthStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            await SyncNotificationSessionAsync();
        });
    }

    private async Task SyncNotificationSessionAsync()
    {
        await LoadCurrentUserAsync();
        if (currentUserId > 0)
        {
            await RefreshUnreadCountAsync();
            await InitializeNotificationSignalRAsync();
        }
        else
        {
            unreadCount = 0;
            notifications.Clear();
            if (hubConnection != null)
            {
                try { await hubConnection.StopAsync(); } catch { }
            }
            StateHasChanged();
        }
    }

    private async Task LoadCurrentUserAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                              ?? user.FindFirst("sub")?.Value;
                int.TryParse(idClaim, out currentUserId);
            }
            else
            {
                currentUserId = 0;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not determine current user in NotificationCenter");
        }
    }

    private async Task RefreshUnreadCountAsync()
    {
        if (currentUserId <= 0) return;
        try
        {
            unreadCount = await ApiClient.GetUnreadNotificationCountAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to refresh unread notification count");
        }
    }

    private async Task InitializeNotificationSignalRAsync()
    {
        try
        {
            var bestieAuth = AuthStateProvider as BestieAuthenticationStateProvider;
            var token = bestieAuth?.AccessToken;
            if (string.IsNullOrEmpty(token)) return;

            var hubUrl = $"{ApiClient.ApiBaseUrl.TrimEnd('/')}/chathub";

            hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl, options =>
                {
                    options.AccessTokenProvider = () => Task.FromResult<string?>(token);
                })
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<NotificationDto>("ReceiveNotification", (notif) =>
            {
                unreadCount++;
                if (notifications.Any())
                {
                    notifications.Insert(0, notif);
                }
                InvokeAsync(StateHasChanged);
            });

            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "NotificationCenter SignalR optional connection: {Msg}", ex.Message);
        }
    }

    private async Task ToggleDropdown()
    {
        isOpen = !isOpen;
        if (isOpen)
        {
            await LoadNotificationsAsync();
        }
    }

    private void CloseDropdown()
    {
        isOpen = false;
    }

    private async Task SetFilter(bool unreadOnly)
    {
        unreadOnlyFilter = unreadOnly;
        await LoadNotificationsAsync();
    }

    private async Task LoadNotificationsAsync()
    {
        isLoading = true;
        try
        {
            var res = await ApiClient.GetNotificationsAsync(pageNumber: 1, pageSize: 30, unreadOnly: unreadOnlyFilter ? true : null);
            if (res != null)
            {
                notifications = res.Notifications;
                unreadCount = res.UnreadCount;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load notifications");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleNotificationClick(NotificationDto notif)
    {
        if (!notif.IsRead)
        {
            notif.IsRead = true;
            if (unreadCount > 0) unreadCount--;
            await ApiClient.MarkNotificationAsReadAsync(notif.NotificationId);
        }

        isOpen = false;

        // Smart routing based on notification type and related entity
        if (notif.NotificationType.StartsWith("FriendRequest"))
        {
            Nav.NavigateTo("/friends");
        }
        else if (notif.NotificationType.StartsWith("CircleInvitation"))
        {
            Nav.NavigateTo("/circles");
        }
        else if (notif.NotificationType == "CircleMemberJoined" || notif.NotificationType == "CircleMemberLeft" || notif.NotificationType == "CircleOwnershipTransferred")
        {
            if (notif.RelatedEntityId.HasValue && notif.RelatedEntityType == "BestieCircle")
            {
                Nav.NavigateTo($"/circles/{notif.RelatedEntityId.Value}");
            }
            else
            {
                Nav.NavigateTo("/circles");
            }
        }
        else if (notif.NotificationType == "NewChatMessage")
        {
            if (notif.RelatedEntityId.HasValue)
            {
                Nav.NavigateTo($"/circles/{notif.RelatedEntityId.Value}/chat");
            }
            else
            {
                Nav.NavigateTo("/circles");
            }
        }
    }

    private async Task MarkAllAsReadAsync()
    {
        isMarkingAll = true;
        try
        {
            await ApiClient.MarkAllNotificationsAsReadAsync();
            unreadCount = 0;
            foreach (var n in notifications)
            {
                n.IsRead = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to mark all notifications as read");
        }
        finally
        {
            isMarkingAll = false;
        }
    }

    private static string GetTypeIcon(string type) => type switch
    {
        "FriendRequestReceived" => "💌",
        "FriendRequestAccepted" => "💖",
        "CircleInvitationReceived" => "🌸",
        "CircleMemberJoined" => "🎉",
        "CircleMemberRemoved" => "⚠️",
        "CircleMemberLeft" => "🚪",
        "CircleOwnershipTransferred" => "👑",
        "NewChatMessage" => "💬",
        _ => "🌸"
    };

    private static string FormatTimeAgo(DateTime dt)
    {
        var span = DateTime.UtcNow - dt;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return dt.ToLocalTime().ToString("MMM d");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeFcmAsync();
        }
    }

    private async Task InitializeFcmAsync()
    {
        try
        {
            fcmWebConfig = await ApiClient.GetFcmWebConfigAsync();
            dotNetRef = DotNetObjectReference.Create(this);

            var isSupported = await JSRuntime.InvokeAsync<bool>("bestieFcm.isSupported");
            if (!isSupported) return;

            await JSRuntime.InvokeAsync<bool>("bestieFcm.init", fcmWebConfig, dotNetRef);

            var perm = await JSRuntime.InvokeAsync<string>("bestieFcm.getPermissionState");
            if (perm == "granted")
            {
                isPushActive = true;
                await RegisterCurrentDeviceTokenSilently();
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Optional FCM init in browser: {Msg}", ex.Message);
        }
    }

    private async Task RegisterCurrentDeviceTokenSilently()
    {
        try
        {
            var vapidKey = fcmWebConfig?.VapidKey;
            var result = await JSRuntime.InvokeAsync<System.Text.Json.JsonElement>("bestieFcm.requestToken", vapidKey);
            if (result.TryGetProperty("success", out var s) && s.GetBoolean())
            {
                if (result.TryGetProperty("token", out var t))
                {
                    var token = t.GetString();
                    if (!string.IsNullOrEmpty(token) && currentUserId > 0)
                    {
                        await ApiClient.RegisterFcmTokenAsync(token, "Web", "Browser");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Silent FCM token registration: {Msg}", ex.Message);
        }
    }

    private async Task EnablePushNotificationsAsync()
    {
        if (isRequestingPush) return;
        isRequestingPush = true;
        try
        {
            var vapidKey = fcmWebConfig?.VapidKey;
            var result = await JSRuntime.InvokeAsync<System.Text.Json.JsonElement>("bestieFcm.requestToken", vapidKey);

            bool success = result.TryGetProperty("success", out var s) && s.GetBoolean();
            if (success && result.TryGetProperty("token", out var t))
            {
                var token = t.GetString();
                if (!string.IsNullOrEmpty(token))
                {
                    await ApiClient.RegisterFcmTokenAsync(token, "Web", "Browser");
                    isPushActive = true;
                    await JSRuntime.InvokeVoidAsync("bestieFcm.showKawaiiToast", "FCM Push Enabled! 🌸", "Realtime push notifications are now active on this browser! 💕", "/");
                }
            }
            else
            {
                var errMsg = result.TryGetProperty("error", out var e) ? e.GetString() : "Permission not granted.";
                await JSRuntime.InvokeVoidAsync("bestieFcm.showKawaiiToast", "Push Permission 🥺", errMsg ?? "Notification permission was not enabled.", "/");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to request FCM push permission");
        }
        finally
        {
            isRequestingPush = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendTestPushAsync()
    {
        if (isSendingTestPush) return;
        isSendingTestPush = true;
        try
        {
            var res = await ApiClient.SendTestPushNotificationAsync("BestieSpace Realtime Alert 🌸", "FCM push notification is active and delivered in realtime! 💕✨");
            if (res != null)
            {
                await JSRuntime.InvokeVoidAsync("bestieFcm.showKawaiiToast", "FCM Push Dispatched! 🚀", res.Message, "/");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sending test push");
        }
        finally
        {
            isSendingTestPush = false;
        }
    }

    [JSInvokable]
    public async Task OnFcmForegroundMessage(string title, string body, string clickUrl)
    {
        unreadCount++;
        await LoadNotificationsAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthStateChanged;
        dotNetRef?.Dispose();
        if (hubConnection != null)
        {
            try
            {
                await hubConnection.DisposeAsync();
            }
            catch { }
        }
    }
}
