@inherits LayoutComponentBase
@using BestieSpace.Client.Services
@using BestieSpace.Shared.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@inject BestieAuthenticationStateProvider BestieAuth
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@implements IDisposable

@if (isAuthLayout)
{
    <div class="bestiespace-auth-layout-root">
        @Body
    </div>
}
else
{
    <div class="bestiespace-layout">
        <!-- 1. Left Sidebar Navigation -->
        <NavMenu />

        <!-- 2. Main Stage (Top Bar + Dynamic Page Content) -->
        <div class="bestiespace-stage">
            <!-- Top App Bar (Matching the Reference Screenshot) -->
            <header class="bestiespace-topbar">
                <!-- Search Pill -->
                <div class="topbar-search-card">
                    <span class="search-icon">🔍</span>
                    <input type="text" class="topbar-search-input" placeholder="Search BestieSpace..." />
                </div>

                <!-- Quick Action Buttons -->
                <div class="topbar-actions">
                    <a href="circles" class="btn-topbar-pill btn-premium-pill" title="Bestie Clubhouse VIP">
                        <span class="crown-icon">👑</span>
                        <span>Go Premium</span>
                    </a>

                    <button type="button" class="btn-topbar-icon" title="Theme">
                        <span>☀️</span>
                    </button>

                    <NavLink href="chat" class="btn-topbar-icon" title="Messages">
                        <span>💬</span>
                    </NavLink>

                    <div class="topbar-notification-wrapper">
                        <NotificationCenter />
                    </div>

                    <a href="friends" class="topbar-avatar-pill" title="My Profile">
                        <span class="avatar-sticker">@(BestieAuth.CurrentUser?.AvatarSticker ?? "🎀")</span>
                    </a>
                </div>
            </header>

            <!-- Dynamic Body Content -->
            <main class="bestiespace-main">
                @Body
            </main>
        </div>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unexpected hiccup happened!
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool isAuthLayout = false;
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += HandleAuthStateChanged;
        Navigation.LocationChanged += HandleLocationChanged;
        await UpdateStateAsync();
    }

    private void HandleAuthStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            await UpdateStateAsync();
            StateHasChanged();
        });
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await UpdateStateAsync();
            StateHasChanged();
        });
    }

    private async Task UpdateStateAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            isAuthenticated = authState.User.Identity?.IsAuthenticated == true;

            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('?').ToLowerInvariant();
            var isAuthRoute = path.StartsWith("login") || path.StartsWith("register");

            // Don't show sidebar on login/register routes or when unauthenticated
            isAuthLayout = isAuthRoute || !isAuthenticated;
        }
        catch
        {
            isAuthLayout = false;
        }
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthStateChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
