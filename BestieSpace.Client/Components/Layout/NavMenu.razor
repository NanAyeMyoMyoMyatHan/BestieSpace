@using BestieSpace.Client.Services
@using BestieSpace.Shared.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@inject IBestieApiClient ApiClient
@inject AuthenticationStateProvider AuthStateProvider
@inject BestieAuthenticationStateProvider BestieAuth
@inject NavigationManager Navigation
@implements IDisposable

<!-- =========================================================
     MOBILE TOP BAR (Visible only on screens < 992px)
     ========================================================= -->
<div class="sidebar-mobile-bar">
    <NavLink href="" class="mobile-brand-link" Match="NavLinkMatch.All">
        <span class="mobile-brand-icon">🍓</span>
        <span class="mobile-brand-text">Bestie<span>Space</span> 💕</span>
    </NavLink>

    <div class="mobile-actions">
        <AuthorizeView>
            <Authorized>
                <NotificationCenter />
            </Authorized>
        </AuthorizeView>

        <button type="button" class="btn-hamburger" @onclick="ToggleMobileMenu" aria-label="Toggle navigation">
            <span>@(isMobileMenuOpen ? "✕" : "☰")</span>
        </button>
    </div>
</div>

<!-- =========================================================
     MOBILE DRAWER BACKDROP OVERLAY
     ========================================================= -->
@if (isMobileMenuOpen)
{
    <div class="sidebar-drawer-backdrop" @onclick="CloseMobileMenu"></div>
}

<!-- =========================================================
     LEFT SIDEBAR NAVIGATION CARD (Matching Reference Image)
     ========================================================= -->
<aside class="bestie-sidebar @(isMobileMenuOpen ? "drawer-open" : "")">
    <div class="sidebar-card">
        <!-- 1. Brand Logo Header -->
        <NavLink href="" class="sidebar-brand-header" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">
            <div class="brand-heart-emblem">
                <svg width="46" height="46" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="100" height="100" rx="30" fill="#FFE5EC"/>
                    <!-- Two besties silhouettes hugging inside sweet heart -->
                    <path d="M50 82C50 82 18 60 18 38C18 24 29 16 41 16C47 16 50 19 50 23C50 19 53 16 59 16C71 16 82 24 82 38C82 60 50 82 50 82Z" fill="#FB6F92"/>
                    <!-- Cute bestie head silhouettes -->
                    <circle cx="41" cy="36" r="6.5" fill="#FFFFFF"/>
                    <circle cx="59" cy="36" r="6.5" fill="#FFFFFF"/>
                    <path d="M33 55 C33 46 47 46 47 55" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round"/>
                    <path d="M53 55 C53 46 67 46 67 55" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round"/>
                </svg>
            </div>
            <div class="brand-text-block">
                <div class="brand-main-title">Bestie<span>Space</span></div>
                <div class="brand-sub-tagline">Better Together ♡</div>
            </div>
        </NavLink>

        <!-- 2. Navigation Menu Links (Vertical List Matching Reference Image) -->
        <nav class="sidebar-nav-items">
            <!-- 🏠 Home -->
            <NavLink class="sidebar-nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">
                <span class="nav-item-icon">🏠</span>
                <span class="nav-item-text">Home</span>
            </NavLink>

            <!-- 👥 Friends -->
            <NavLink class="sidebar-nav-link" href="friends" @onclick="CloseMobileMenu">
                <span class="nav-item-icon">👥</span>
                <span class="nav-item-text">Friends</span>
            </NavLink>

            <!-- 💬 Messages -->
            <NavLink class="sidebar-nav-link" href="chat" @onclick="CloseMobileMenu">
                <span class="nav-item-icon">💬</span>
                <span class="nav-item-text">Messages</span>
                @if (unreadChatCount > 0)
                {
                    <span class="nav-counter-pill">@unreadChatCount</span>
                }
            </NavLink>

            <!-- 🕒 Memories / Photos -->
            <NavLink class="sidebar-nav-link" href="photos" @onclick="CloseMobileMenu">
                <span class="nav-item-icon">🕒</span>
                <span class="nav-item-text">Memories</span>
            </NavLink>

            <!-- ✉️ Notes -->
            <NavLink class="sidebar-nav-link" href="notes" @onclick="CloseMobileMenu">
                <span class="nav-item-icon">✉️</span>
                <span class="nav-item-text">Notes</span>
            </NavLink>

            <!-- 🧭 Explore / Circles -->
            <NavLink class="sidebar-nav-link" href="circles" @onclick="CloseMobileMenu">
                <span class="nav-item-icon">🧭</span>
                <span class="nav-item-text">Explore</span>
            </NavLink>

            <!-- 🔔 Notifications -->
            <NavLink class="sidebar-nav-link" href="friends" @onclick="CloseMobileMenu">
                <span class="nav-item-icon">🔔</span>
                <span class="nav-item-text">Notifications</span>
                @if (unreadNotificationCount > 0)
                {
                    <span class="nav-counter-pill">@unreadNotificationCount</span>
                }
            </NavLink>

            <!-- ⚙️ Settings / Admin -->
            @if (isAdmin)
            {
                <NavLink class="sidebar-nav-link admin-nav-link" href="admin/rbac" @onclick="CloseMobileMenu">
                    <span class="nav-item-icon">⚙️</span>
                    <span class="nav-item-text">Admin Settings</span>
                </NavLink>
            }
            else
            {
                <NavLink class="sidebar-nav-link" href="friends" @onclick="CloseMobileMenu">
                    <span class="nav-item-icon">⚙️</span>
                    <span class="nav-item-text">Settings</span>
                </NavLink>
            }
        </nav>

        <!-- 3. Decorative Good Friends Good Vibes Sticker (Matching Reference Image) -->
        <div class="sidebar-sticker-card">
            <div class="sticker-vibe-quote">Good Friends<br/>Good Vibes ♡</div>
            <div class="bestie-group-art">
                <svg width="190" height="96" viewBox="0 0 200 105" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Little floating hearts & sparkles -->
                    <path d="M22 22 C22 17 15 13 10 17 C5 13 0 17 0 22 C0 29 10 36 10 36 C10 36 22 29 22 22 Z" fill="#FFAFCC" opacity="0.8"/>
                    <path d="M198 18 C198 13 191 10 187 13 C183 10 177 13 177 18 C177 25 187 31 187 31 C187 31 198 25 198 18 Z" fill="#FFAFCC" opacity="0.8"/>
                    <circle cx="100" cy="10" r="3" fill="#FFC2D1"/>
                    <circle cx="65" cy="16" r="2.5" fill="#FB6F92"/>
                    <circle cx="135" cy="16" r="2.5" fill="#FB6F92"/>

                    <!-- 4 Besties Hugging from Behind (Artwork matching user photo) -->
                    <!-- Bestie 1 (Leftmost, pink hoodie) -->
                    <path d="M42 42 C42 30 54 30 54 42 C54 45 53 48 52 53 L43 53 C42 48 42 45 42 42 Z" fill="#5C3828"/>
                    <rect x="38" y="52" width="22" height="46" rx="8" fill="#F8B4C8"/>
                    <!-- Bestie 2 (Brown hair, white sweater) -->
                    <path d="M64 36 C62 26 78 24 79 36 C79 41 77 46 77 52 L65 52 C65 46 64 41 64 36 Z" fill="#3D261C"/>
                    <rect x="61" y="52" width="24" height="48" rx="8" fill="#FFFFFF" stroke="#FFCCD5" stroke-width="1.5"/>
                    <!-- Bestie 3 (Warm brown hair, blush sweater) -->
                    <path d="M89 38 C87 28 103 26 104 38 C104 43 102 48 102 53 L90 53 C90 48 89 43 89 38 Z" fill="#7A4B3A"/>
                    <rect x="86" y="53" width="24" height="47" rx="8" fill="#FFCCD9"/>
                    <!-- Bestie 4 (Rightmost, lavender sweater) -->
                    <path d="M113 40 C111 30 125 28 126 40 C126 44 124 49 124 54 L114 54 C114 49 113 44 113 40 Z" fill="#2E1C14"/>
                    <rect x="111" y="53" width="22" height="46" rx="8" fill="#D6C7FF"/>

                    <!-- Linked arms/hugs -->
                    <path d="M42 63 C51 71 64 69 68 61" stroke="#FB6F92" stroke-width="2.5" stroke-linecap="round"/>
                    <path d="M66 63 C76 71 90 69 94 61" stroke="#FB6F92" stroke-width="2.5" stroke-linecap="round"/>
                    <path d="M92 63 C102 71 114 69 118 61" stroke="#9D74FF" stroke-width="2.5" stroke-linecap="round"/>

                    <!-- Denim jeans / skirts -->
                    <rect x="39" y="85" width="10" height="18" rx="4" fill="#6A85B6"/>
                    <rect x="49" y="85" width="10" height="18" rx="4" fill="#6A85B6"/>
                    <rect x="63" y="85" width="10" height="18" rx="4" fill="#4B6584"/>
                    <rect x="73" y="85" width="10" height="18" rx="4" fill="#4B6584"/>
                    <rect x="88" y="85" width="10" height="18" rx="4" fill="#474787"/>
                    <rect x="98" y="85" width="10" height="18" rx="4" fill="#474787"/>
                    <rect x="112" y="85" width="10" height="18" rx="4" fill="#57606F"/>
                    <rect x="122" y="85" width="10" height="18" rx="4" fill="#57606F"/>
                </svg>
            </div>
        </div>

        <!-- 4. User Profile Card at Bottom of Sidebar (Matching Reference Image) -->
        <div class="sidebar-user-footer">
            <AuthorizeView>
                <Authorized>
                    <a href="friends" class="sidebar-user-pill" title="View Profile">
                        <div class="user-avatar-circle">
                            <span>@(userSession?.AvatarSticker ?? "🎀")</span>
                        </div>
                        <div class="user-meta-text">
                            <span class="user-name">@(userSession?.DisplayName ?? context.User.Identity?.Name ?? "Han Han ♡")</span>
                            <span class="user-handle">@@@(userSession?.Username ?? "hannah_dev")</span>
                        </div>
                    </a>
                    <button type="button" class="btn-sidebar-logout" @onclick="HandleLogoutAsync" title="Sign Out">
                        <span>🔒</span>
                    </button>
                </Authorized>
                <NotAuthorized>
                    <div class="sidebar-guest-actions">
                        <a href="/login" class="btn-sidebar-auth btn-auth-signin" @onclick="CloseMobileMenu">
                            <span>🔑</span> Sign In
                        </a>
                        <a href="/register" class="btn-sidebar-auth btn-auth-signup" @onclick="CloseMobileMenu">
                            <span>✨</span> Register
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</aside>

@code {
    private bool isMobileMenuOpen = false;
    private bool isAdmin = false;
    private int unreadChatCount = 0;
    private int unreadNotificationCount = 0;
    private UserSessionDto? userSession;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += HandleAuthStateChanged;
        await LoadUserAndCountsAsync();
    }

    private void HandleAuthStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadUserAndCountsAsync();
            StateHasChanged();
        });
    }

    private async Task LoadUserAndCountsAsync()
    {
        userSession = BestieAuth.CurrentUser;
        isAdmin = BestieAuth.HasRole("Admin") || BestieAuth.HasRole("Administrator") || BestieAuth.HasPermission("USER_MANAGE");

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                var summary = await ApiClient.GetUnreadSummaryAsync();
                if (summary != null)
                {
                    unreadChatCount = summary.TotalUnreadCount;
                }

                unreadNotificationCount = await ApiClient.GetUnreadNotificationCountAsync();
            }
            else
            {
                unreadChatCount = 0;
                unreadNotificationCount = 0;
            }
        }
        catch { }
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }

    private async Task HandleLogoutAsync()
    {
        CloseMobileMenu();
        await BestieAuth.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= HandleAuthStateChanged;
    }
}
