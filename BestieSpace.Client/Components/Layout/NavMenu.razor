@using BestieSpace.Client.Services
@using BestieSpace.Shared.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@inject IBestieApiClient ApiClient
@inject AuthenticationStateProvider AuthStateProvider

<div class="top-row ps-3 pe-3 navbar navbar-dark d-flex justify-content-between align-items-center">
    <a class="navbar-brand" href="">BestieSpace 🌸</a>
    <AuthorizeView>
        <Authorized>
            <NotificationCenter />
        </Authorized>
    </AuthorizeView>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> 🏠 Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="friends">
                <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> 👭 Friends & Profile
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link d-flex justify-content-between align-items-center" href="circles">
                <span><span class="bi bi-chat-heart-fill-nav-menu" aria-hidden="true"></span> 👑 Bestie Circles</span>
                @if (unreadCirclesCount > 0)
                {
                    <span class="badge bg-danger rounded-pill" style="font-size: 0.72rem; padding: 2px 7px;">@unreadCirclesCount</span>
                }
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin/rbac">
                <span class="bi bi-shield-lock-fill-nav-menu" aria-hidden="true"></span> 🛡️ Admin RBAC
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private int unreadCirclesCount = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                var summary = await ApiClient.GetUnreadSummaryAsync();
                if (summary != null)
                {
                    unreadCirclesCount = summary.TotalUnreadCount;
                }
            }
        }
        catch { }
    }
}
