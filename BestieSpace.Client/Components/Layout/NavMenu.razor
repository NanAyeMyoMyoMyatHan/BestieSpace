@code {
    private bool isMobileMenuOpen = false;
    private bool isAdmin = false;
    private int unreadChatCount = 0;
    private UserSessionDto? userSession;

    protected override async Task OnInitializedAsync()
    {
        userSession = BestieAuth.CurrentUser;
        isAdmin = BestieAuth.HasRole("Admin") || BestieAuth.HasRole("Administrator") || BestieAuth.HasPermission("USER_MANAGE");

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                var summary = await ApiClient.GetUnreadSummaryAsync();
                if (summary != null)
                {
                    unreadChatCount = summary.TotalUnreadCount;
                }
            }
        }
        catch { }
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }

    private async Task HandleLogoutAsync()
    {
        CloseMobileMenu();
        await BestieAuth.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }
}
